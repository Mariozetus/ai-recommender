---
import type { AIModel } from '../lib/types';

interface Props {
  model: AIModel;
}

const { model } = Astro.props;
---

<article class="p-5 hover:bg-[var(--color-paper-2)] transition-colors focus-within:bg-[var(--color-paper-2)] h-full">
  <div class="flex items-baseline gap-1.5 mb-1.5 text-[11px] uppercase tracking-wider text-[var(--color-ink-3)]">
    <span>{model.category}</span>
    <span class="text-[var(--color-ink-4)]">·</span>
    <span class="truncate">{model.provider}</span>
  </div>

  <h3 class="text-[15px] font-semibold text-[var(--color-ink)] mb-1.5 line-clamp-2">
    <a href={`/models/${model.provider}/${model.id.split('/')[1] || ''}`} class="hover:text-[var(--color-accent)] focus-ring">
      {model.name}
    </a>
  </h3>

  <p class="text-[12px] text-[var(--color-ink-2)] line-clamp-3 text-pretty leading-relaxed">
    {model.description}
  </p>
</article>
