---
interface Props {
  modelId: string;
  modelName: string;
  inputPrice: number;
  outputPrice: number;
}

const { modelId, modelName, inputPrice, outputPrice } = Astro.props;
---

<div class="bg-[var(--color-paper-2)] p-6">
  <p class="text-[13px] text-[var(--color-ink-3)] mb-4">
    Estima el costo para un caso típico. Los precios son por millón de tokens.
  </p>

  <div class="grid sm:grid-cols-2 gap-4 mb-4">
    <div>
      <label for={`calc-input-${modelId}`} class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">
        Tokens de entrada
      </label>
      <input
        type="number"
        id={`calc-input-${modelId}`}
        name="input-tokens"
        min="0"
        step="100"
        value="1000"
        inputmode="numeric"
        autocomplete="off"
        data-calc-input
        data-price={inputPrice}
        class="w-full bg-[var(--color-paper)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[15px] tnum focus-ring"
      />
    </div>
    <div>
      <label for={`calc-output-${modelId}`} class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">
        Tokens de salida
      </label>
      <input
        type="number"
        id={`calc-output-${modelId}`}
        name="output-tokens"
        min="0"
        step="100"
        value="500"
        inputmode="numeric"
        autocomplete="off"
        data-calc-output
        data-price={outputPrice}
        class="w-full bg-[var(--color-paper)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[15px] tnum focus-ring"
      />
    </div>
  </div>

  <dl class="border-t rule pt-4 grid grid-cols-3 gap-2 text-center">
    <div>
      <dt class="text-[11px] text-[var(--color-ink-3)] uppercase tracking-wider mb-1">Input</dt>
      <dd class="text-[14px] tnum text-[var(--color-ink-2)]" data-calc-input-cost>$0.00</dd>
    </div>
    <div>
      <dt class="text-[11px] text-[var(--color-ink-3)] uppercase tracking-wider mb-1">Output</dt>
      <dd class="text-[14px] tnum text-[var(--color-ink-2)]" data-calc-output-cost>$0.00</dd>
    </div>
    <div>
      <dt class="text-[11px] text-[var(--color-ink-3)] uppercase tracking-wider mb-1">Total</dt>
      <dd class="text-[15px] tnum font-semibold text-[var(--color-ink)]" data-calc-total>$0.00</dd>
    </div>
  </dl>
</div>

<script>
  const fmt = new Intl.NumberFormat(document.documentElement.lang, {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: 4,
  });

  function setup(root: HTMLElement) {
    const input = root.querySelector('[data-calc-input]') as HTMLInputElement | null;
    const output = root.querySelector('[data-calc-output]') as HTMLInputElement | null;
    const inputCost = root.querySelector('[data-calc-input-cost]');
    const outputCost = root.querySelector('[data-calc-output-cost]');
    const total = root.querySelector('[data-calc-total]');
    if (!input || !output || !inputCost || !outputCost || !total) return;

    const inputPrice = parseFloat(input.dataset.price || '0');
    const outputPrice = parseFloat(output.dataset.price || '0');

    const update = () => {
      const inTok = Math.max(0, parseFloat(input.value) || 0);
      const outTok = Math.max(0, parseFloat(output.value) || 0);
      const inCost = (inTok / 1_000_000) * inputPrice;
      const outCost = (outTok / 1_000_000) * outputPrice;
      inputCost.textContent = fmt.format(inCost);
      outputCost.textContent = fmt.format(outCost);
      total.textContent = fmt.format(inCost + outCost);
    };

    input.addEventListener('input', update);
    output.addEventListener('input', update);
    update();
  }

  document.querySelectorAll('[data-calc-input]').forEach(el => {
    setup(el.closest('div')?.parentElement?.parentElement || el.parentElement!);
  });
</script>
