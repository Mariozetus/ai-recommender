---
import type { AIModel, ScoreBreakdown } from '../lib/types';
import AICard from './AICard.astro';

interface ScoreInfo {
  id: string;
  score: number;
  breakdown: ScoreBreakdown;
}

interface Props {
  models: AIModel[];
  scores?: ScoreInfo[];
  title?: string;
  strategy?: string;
}

const { models, scores = [], title = 'Results', strategy = 'balanced' } = Astro.props;

const scoreMap = new Map(scores.map(s => [s.id, s]));

const strategyLabels: Record<string, string> = {
  balanced: 'Equilibrado',
  quality: 'Máxima Calidad',
  budget: 'Mejor Precio',
};

const dimensionLabels: Record<keyof ScoreBreakdown, string> = {
  category_match: 'Categoría',
  context: 'Contexto',
  cost: 'Costo',
  quality: 'Calidad',
  features: 'Características',
};
---

<section>
  <div class="flex items-baseline justify-between mb-6 flex-wrap gap-2">
    <h2 class="text-[20px] font-semibold text-[var(--color-ink)] text-balance">{title}</h2>
    <span class="text-[11px] uppercase tracking-wider text-[var(--color-ink-3)]">
      Estrategia: {strategyLabels[strategy] || strategy}
    </span>
  </div>

  {models.length === 0 ? (
    <p class="text-[var(--color-ink-3)] text-[14px] py-8">No hay modelos que coincidan.</p>
  ) : (
    <div class="grid gap-px bg-[var(--color-rule)] md:grid-cols-2 lg:grid-cols-3">
      {models.map(model => {
        const scoreInfo = scoreMap.get(model.id);
        return (
          <div class="relative bg-[var(--color-paper)]">
            {scoreInfo && (
              <div
                class="absolute top-2 right-2 z-10 bg-[var(--color-paper-2)] border rule px-2 py-0.5 text-[11px] tnum text-[var(--color-ink-2)]"
                title={Object.entries(scoreInfo.breakdown).map(([k, v]) => `${dimensionLabels[k as keyof ScoreBreakdown]}: ${Math.round(v)}/100`).join('\n')}
              >
                {Math.round(scoreInfo.score)}/100
              </div>
            )}
            <AICard model={model} />
            {scoreInfo && (
              <details class="bg-[var(--color-paper-2)] border-t rule px-4 py-2 text-[12px]">
                <summary class="cursor-pointer text-[var(--color-ink-3)] hover:text-[var(--color-ink-2)] select-none">
                  Ver desglose
                </summary>
                <ul class="mt-2 space-y-1">
                  {Object.entries(scoreInfo.breakdown).map(([key, value]) => (
                    <li class="flex justify-between items-center">
                      <span class="text-[var(--color-ink-3)]">{dimensionLabels[key as keyof ScoreBreakdown]}</span>
                      <span class="tnum text-[var(--color-ink-2)]">{Math.round(value)}</span>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </div>
        );
      })}
    </div>
  )}
</section>
