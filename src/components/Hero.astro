---
import { t } from '../i18n/index';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const numberFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US');

const stats = [
  { value: 430, suffix: ' modelos' },
  { value: 23, suffix: ' proveedores' },
  { value: 6, suffix: ' categorías' },
];
---

<section class="border-b rule">
  <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
    <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
      Catálogo de IA · OpenRouter
    </p>

    <h1 class="text-5xl md:text-6xl lg:text-7xl font-semibold text-[var(--color-ink)] mb-8 leading-[1.05] tracking-[-0.03em] text-balance max-w-4xl">
      Encuentra el modelo
      <span class="text-[var(--color-accent)]">adecuado</span>
      <br />para tu caso de uso.
    </h1>

    <p class="text-lg md:text-xl text-[var(--color-ink-2)] max-w-2xl leading-relaxed text-pretty mb-10">
      Compara {numberFmt.format(430)} modelos con precios reales, contexto, benchmarks y capacidades técnicas. Filtros, rankings curados y recomendaciones personalizadas.
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href="/catalog"
        class="inline-flex items-center gap-2 bg-[var(--color-ink)] text-[var(--color-paper)] hover:bg-[var(--color-ink-2)] px-5 py-2.5 rounded-sm text-[15px] font-medium transition-colors focus-ring"
      >
        Explorar catálogo
      </a>
      <a
        href="/recommend"
        class="inline-flex items-center gap-2 border rule text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] px-5 py-2.5 rounded-sm text-[15px] font-medium transition-colors focus-ring"
      >
        Recomendación personalizada
      </a>
    </div>

    <dl class="mt-16 flex flex-wrap gap-x-12 gap-y-6 pt-8 border-t rule text-[14px]">
      {stats.map(s => (
        <div>
          <dt class="text-[var(--color-ink-3)] mb-1">{s.suffix.trim()}</dt>
          <dd class="text-2xl font-semibold text-[var(--color-ink)] tnum">{numberFmt.format(s.value)}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
