---
import { t } from '../i18n/index';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const stats = [
  { count: 430, key: 'home.stats.models', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { count: 23, key: 'home.stats.providers', icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9' },
  { count: 6, key: 'home.stats.categories', icon: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z' },
];

const numberFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US');
---

<section class="relative overflow-hidden bg-gradient-to-b from-gray-900 via-gray-900 to-gray-800 py-20 px-4">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-4xl mx-auto text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight text-balance">
      {t('home.hero.title')}
    </h1>
    <p class="text-lg md:text-xl text-gray-400 mb-10 max-w-2xl mx-auto text-pretty">
      {t('home.hero.subtitle')}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
<a
      href="/catalog"
      class="inline-flex items-center justify-center bg-teal-600 hover:bg-teal-500 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors transition-transform hover:scale-[1.02] focus-ring"
    >
      {t('home.hero.cta_catalog')}
    </a>
    <a
      href="/recommend"
      class="inline-flex items-center justify-center bg-gray-800 hover:bg-gray-700 text-white px-8 py-4 rounded-lg font-semibold text-lg border border-gray-700 transition-colors transition-transform hover:scale-[1.02] focus-ring"
    >
        {t('home.hero.cta_recommend')}
      </a>
    </div>

    <div class="mt-12 flex justify-center gap-8 text-sm text-gray-500 flex-wrap">
      {stats.map(s => (
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s.icon} />
          </svg>
          <span><span class="tnum font-semibold text-white">{numberFmt.format(s.count)}</span> {t(s.key)}</span>
        </div>
      ))}
    </div>
  </div>
</section>
