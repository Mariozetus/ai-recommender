---
interface Props {
  categories: string[];
  providers: string[];
  selectedCategory?: string;
  selectedProvider?: string;
}

const { categories, providers, selectedCategory, selectedProvider } = Astro.props;
---

<aside class="space-y-8" aria-label="Filtros del catálogo">
  <div>
    <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] font-medium mb-3">
      Filtros
    </p>
  </div>

  <div>
    <label for="category-filter" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">
      Categoría
    </label>
    <select
      id="category-filter"
      name="category"
      autocomplete="off"
      class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[14px] focus-ring focus:border-[var(--color-ink-3)]"
    >
      <option value="">Todas</option>
      {categories.map(cat => (
        <option value={cat} selected={selectedCategory === cat}>
          {cat.charAt(0).toUpperCase() + cat.slice(1)}
        </option>
      ))}
    </select>
  </div>

  <div>
    <label for="provider-filter" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">
      Proveedor
    </label>
    <select
      id="provider-filter"
      name="provider"
      autocomplete="off"
      class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[14px] focus-ring focus:border-[var(--color-ink-3)]"
    >
      <option value="">Todos</option>
      {providers.map(prov => (
        <option value={prov} selected={selectedProvider === prov}>
          {prov}
        </option>
      ))}
    </select>
  </div>

  <div>
    <label for="context-filter" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">
      Contexto máx.
    </label>
    <select
      id="context-filter"
      name="context"
      autocomplete="off"
      class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[14px] focus-ring focus:border-[var(--color-ink-3)]"
    >
      <option value="0">Cualquiera</option>
      <option value="32768">≤ 32K</option>
      <option value="65536">≤ 64K</option>
      <option value="131072">≤ 128K</option>
      <option value="200000">≤ 200K</option>
    </select>
  </div>

  <div>
    <label for="price-filter" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">
      Precio máx. / 1M
    </label>
    <select
      id="price-filter"
      name="price"
      autocomplete="off"
      class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[14px] focus-ring focus:border-[var(--color-ink-3)]"
    >
      <option value="0">Cualquiera</option>
      <option value="1">≤ $1</option>
      <option value="5">≤ $5</option>
      <option value="10">≤ $10</option>
      <option value="50">≤ $50</option>
    </select>
  </div>

  <label for="free-filter" class="flex items-center gap-2 cursor-pointer text-[13px] text-[var(--color-ink-2)]">
    <input
      type="checkbox"
      id="free-filter"
      name="free"
      class="w-4 h-4 bg-[var(--color-paper-2)] border rule rounded-sm text-[var(--color-accent)] focus-ring"
    />
    <span>Solo modelos gratuitos</span>
  </label>

  <button
    type="button"
    id="clear-all-filters"
    class="w-full text-[13px] text-[var(--color-ink-3)] hover:text-[var(--color-ink)] py-2 border-t rule transition-colors focus-ring"
  >
    Limpiar filtros
  </button>
</aside>

<div id="filter-drawer" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="Filtros">
  <div id="filter-drawer-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div id="filter-drawer-content" class="absolute right-0 top-0 bottom-0 w-full max-w-sm bg-[var(--color-paper)] border-l rule overflow-y-auto overscroll-contain transform translate-x-full transition-transform duration-300">
    <div class="p-6 space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-[15px] font-semibold text-[var(--color-ink)]">Filtros</h2>
        <button
          id="close-drawer"
          type="button"
          aria-label="Cerrar filtros"
          class="p-2 -mr-2 text-[var(--color-ink-3)] hover:text-[var(--color-ink)] focus-ring"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 6l12 12M6 18L18 6" />
          </svg>
        </button>
      </div>

      <div>
        <label for="category-filter-mobile" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">Categoría</label>
        <select
          id="category-filter-mobile"
          autocomplete="off"
          class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[14px] focus-ring"
        >
          <option value="">Todas</option>
          {categories.map(cat => (
            <option value={cat} selected={selectedCategory === cat}>
              {cat.charAt(0).toUpperCase() + cat.slice(1)}
            </option>
          ))}
        </select>
      </div>

      <div>
        <label for="provider-filter-mobile" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">Proveedor</label>
        <select
          id="provider-filter-mobile"
          autocomplete="off"
          class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[14px] focus-ring"
        >
          <option value="">Todos</option>
          {providers.map(prov => (
            <option value={prov} selected={selectedProvider === prov}>
              {prov}
            </option>
          ))}
        </select>
      </div>

      <div>
        <label for="context-filter-mobile" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">Contexto máx.</label>
        <select
          id="context-filter-mobile"
          autocomplete="off"
          class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[14px] focus-ring"
        >
          <option value="0">Cualquiera</option>
          <option value="32768">≤ 32K</option>
          <option value="65536">≤ 64K</option>
          <option value="131072">≤ 128K</option>
          <option value="200000">≤ 200K</option>
        </select>
      </div>

      <div>
        <label for="price-filter-mobile" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">Precio máx. / 1M</label>
        <select
          id="price-filter-mobile"
          autocomplete="off"
          class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[14px] focus-ring"
        >
          <option value="0">Cualquiera</option>
          <option value="1">≤ $1</option>
          <option value="5">≤ $5</option>
          <option value="10">≤ $10</option>
          <option value="50">≤ $50</option>
        </select>
      </div>

      <label for="free-filter-mobile" class="flex items-center gap-2 cursor-pointer text-[13px] text-[var(--color-ink-2)]">
        <input
          type="checkbox"
          id="free-filter-mobile"
          class="w-4 h-4 bg-[var(--color-paper-2)] border rule rounded-sm text-[var(--color-accent)] focus-ring"
        />
        <span>Solo modelos gratuitos</span>
      </label>

      <div class="flex gap-2 pt-4 border-t rule">
        <button
          id="apply-filters"
          type="button"
          class="flex-1 bg-[var(--color-ink)] text-[var(--color-paper)] hover:bg-[var(--color-ink-2)] py-2.5 rounded-sm text-[14px] font-medium transition-colors focus-ring"
        >
          Aplicar
        </button>
        <button
          id="clear-filters"
          type="button"
          class="px-4 py-2.5 border rule text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] rounded-sm text-[14px] font-medium transition-colors focus-ring"
        >
          Limpiar
        </button>
      </div>
    </div>
  </div>
</div>

<button
  id="open-filter-drawer"
  type="button"
  aria-label="Abrir filtros"
  class="md:hidden fixed bottom-6 right-6 z-40 bg-[var(--color-ink)] text-[var(--color-paper)] p-3.5 rounded-full shadow-lg transition-colors focus-ring touch-manipulation"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
  </svg>
</button>

<script>
  const drawer = document.getElementById('filter-drawer');
  const overlay = document.getElementById('filter-drawer-overlay');
  const content = document.getElementById('filter-drawer-content');
  const openBtn = document.getElementById('open-filter-drawer');
  const closeBtn = document.getElementById('close-drawer');
  const applyBtn = document.getElementById('apply-filters');
  const clearBtn = document.getElementById('clear-filters');

  function syncFiltersToMobile() {
    const category = (document.getElementById('category-filter') as HTMLSelectElement)?.value || '';
    const provider = (document.getElementById('provider-filter') as HTMLSelectElement)?.value || '';
    const context = (document.getElementById('context-filter') as HTMLSelectElement)?.value || '0';
    const price = (document.getElementById('price-filter') as HTMLSelectElement)?.value || '0';
    const free = (document.getElementById('free-filter') as HTMLInputElement)?.checked || false;

    const mobileCategory = document.getElementById('category-filter-mobile') as HTMLSelectElement;
    const mobileProvider = document.getElementById('provider-filter-mobile') as HTMLSelectElement;
    const mobileContext = document.getElementById('context-filter-mobile') as HTMLSelectElement;
    const mobilePrice = document.getElementById('price-filter-mobile') as HTMLSelectElement;
    const mobileFree = document.getElementById('free-filter-mobile') as HTMLInputElement;

    if (mobileCategory) mobileCategory.value = category;
    if (mobileProvider) mobileProvider.value = provider;
    if (mobileContext) mobileContext.value = context;
    if (mobilePrice) mobilePrice.value = price;
    if (mobileFree) mobileFree.checked = free;
  }

  function openDrawer() {
    syncFiltersToMobile();
    drawer?.classList.remove('hidden');
    requestAnimationFrame(() => {
      content?.classList.remove('translate-x-full');
    });
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    content?.classList.add('translate-x-full');
    setTimeout(() => {
      drawer?.classList.add('hidden');
    }, 300);
    document.body.style.overflow = '';
  }

  function applyFilters() {
    const category = (document.getElementById('category-filter-mobile') as HTMLSelectElement)?.value || '';
    const provider = (document.getElementById('provider-filter-mobile') as HTMLSelectElement)?.value || '';
    const context = (document.getElementById('context-filter-mobile') as HTMLSelectElement)?.value || '0';
    const price = (document.getElementById('price-filter-mobile') as HTMLSelectElement)?.value || '0';
    const free = (document.getElementById('free-filter-mobile') as HTMLInputElement)?.checked || false;

    const desktopCategory = document.getElementById('category-filter') as HTMLSelectElement;
    const desktopProvider = document.getElementById('provider-filter') as HTMLSelectElement;
    const desktopContext = document.getElementById('context-filter') as HTMLSelectElement;
    const desktopPrice = document.getElementById('price-filter') as HTMLSelectElement;
    const desktopFree = document.getElementById('free-filter') as HTMLInputElement;

    if (desktopCategory) desktopCategory.value = category;
    if (desktopProvider) desktopProvider.value = provider;
    if (desktopContext) desktopContext.value = context;
    if (desktopPrice) desktopPrice.value = price;
    if (desktopFree) desktopFree.checked = free;

    closeDrawer();
    updateFilters();
  }

  function updateFilters() {
    const category = (document.getElementById('category-filter') as HTMLSelectElement)?.value;
    const provider = (document.getElementById('provider-filter') as HTMLSelectElement)?.value;
    const context = (document.getElementById('context-filter') as HTMLSelectElement)?.value;
    const price = (document.getElementById('price-filter') as HTMLSelectElement)?.value;
    const free = (document.getElementById('free-filter') as HTMLInputElement)?.checked;

    const params = new URLSearchParams(window.location.search);
    if (category) params.set('category', category); else params.delete('category');
    if (provider) params.set('provider', provider); else params.delete('provider');
    if (context && context !== '0') params.set('context', context); else params.delete('context');
    if (price && price !== '0') params.set('price', price); else params.delete('price');
    if (free) params.set('free', '1'); else params.delete('free');
    params.delete('page');

    const newUrl = params.toString() ? `/catalog?${params.toString()}` : '/catalog';
    window.location.href = newUrl;
  }

  document.getElementById('clear-all-filters')?.addEventListener('click', () => {
    window.location.href = '/catalog';
  });

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
  applyBtn?.addEventListener('click', applyFilters);
  clearBtn?.addEventListener('click', () => {
    window.location.href = '/catalog';
  });
</script>
