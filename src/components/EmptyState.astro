---
interface Props {
  title?: string;
  message: string;
  action?: { label: string; href: string };
}

const { title = 'Sin resultados', message, action } = Astro.props;
---

<div class="py-16 text-center">
  <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-3">
    {title}
  </p>
  <p class="text-[15px] text-[var(--color-ink-2)] max-w-md mx-auto text-pretty">
    {message}
  </p>
  {action && (
    <a
      href={action.href}
      class="inline-block mt-6 text-[14px] text-[var(--color-ink-2)] underline underline-offset-4 hover:text-[var(--color-ink)] focus-ring"
    >
      {action.label}
    </a>
  )}
</div>
