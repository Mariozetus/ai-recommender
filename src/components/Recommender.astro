---
interface Props {
  categories: string[];
}

const { categories } = Astro.props;

const strategies = [
  { value: 'balanced', label: 'Equilibrado', desc: 'Balance entre costo y calidad' },
  { value: 'quality', label: 'Máxima Calidad', desc: 'Prioriza rendimiento' },
  { value: 'budget', label: 'Mejor Precio', desc: 'Prioriza bajo costo' },
];
---

<form id="recommender-form" class="space-y-6">
  <div>
    <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] font-medium mb-3">
      Caso de uso
    </p>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-[var(--color-rule)]">
      {categories.map(cat => (
        <label class="cursor-pointer bg-[var(--color-paper)] has-[:checked]:bg-[var(--color-paper-2)] has-[:checked]:border-l-[var(--color-accent)] transition-colors focus-within:bg-[var(--color-paper-2)]">
          <input type="radio" name="use_case" value={cat} class="sr-only peer" required />
          <div class="px-4 py-3 text-center text-[13px] text-[var(--color-ink-2)] peer-checked:text-[var(--color-ink)]">
            {cat.charAt(0).toUpperCase() + cat.slice(1)}
          </div>
        </label>
      ))}
    </div>
  </div>

  <div>
    <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] font-medium mb-3">
      Estrategia
    </p>
    <div class="space-y-px bg-[var(--color-rule)]">
      {strategies.map(s => (
        <label class="cursor-pointer bg-[var(--color-paper)] block has-[:checked]:bg-[var(--color-paper-2)] transition-colors focus-within:bg-[var(--color-paper-2)]">
          <input type="radio" name="strategy" value={s.value} class="sr-only peer" checked={s.value === 'balanced'} />
          <div class="px-4 py-3">
            <div class="text-[13px] text-[var(--color-ink-2)] peer-checked:text-[var(--color-ink)]">{s.label}</div>
            <div class="text-[12px] text-[var(--color-ink-3)] mt-0.5">{s.desc}</div>
          </div>
        </label>
      ))}
    </div>
  </div>

  <div>
    <label for="max_context" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">
      Contexto máximo
    </label>
    <select
      id="max_context"
      name="max_context"
      autocomplete="off"
      class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[14px] focus-ring focus:border-[var(--color-ink-3)]"
    >
      <option value="32768">≤ 32K tokens</option>
      <option value="65536">≤ 64K tokens</option>
      <option value="131072" selected>≤ 128K tokens</option>
      <option value="200000">≤ 200K tokens</option>
    </select>
  </div>

  <div>
    <label for="max_budget" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">
      Presupuesto mensual ($)
    </label>
    <input
      type="number"
      id="max_budget"
      name="max_budget"
      min="0"
      step="1"
      value="50"
      inputmode="numeric"
      autocomplete="off"
      class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] rounded-sm px-3 py-2 text-[14px] tnum focus-ring focus:border-[var(--color-ink-3)]"
    />
  </div>

  <div>
    <label for="preferred_features" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">
      Características preferidas
    </label>
    <input
      type="text"
      id="preferred_features"
      name="preferred_features"
      placeholder="vision, function calling, json mode"
      autocomplete="off"
      class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] placeholder-[var(--color-ink-4)] rounded-sm px-3 py-2 text-[14px] focus-ring focus:border-[var(--color-ink-3)]"
    />
  </div>

  <button
    type="submit"
    class="w-full bg-[var(--color-ink)] text-[var(--color-paper)] hover:bg-[var(--color-ink-2)] py-3 rounded-sm text-[14px] font-medium transition-colors focus-ring"
  >
    Obtener recomendaciones
  </button>
</form>

<script>
  const form = document.getElementById('recommender-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const params = new URLSearchParams();
    params.set('use_case', formData.get('use_case') as string);
    params.set('max_context', formData.get('max_context') as string);
    params.set('max_budget', formData.get('max_budget') as string);
    const strategy = formData.get('strategy') as string;
    if (strategy) params.set('strategy', strategy);
    const features = formData.get('preferred_features') as string;
    if (features) params.set('features', features);
    window.location.href = `/recommend?${params.toString()}`;
  });
</script>
