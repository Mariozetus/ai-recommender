---
interface Props {
  variant?: 'card' | 'text' | 'avatar' | 'button';
  class?: string;
}

const { variant = 'card', class: className = '' } = Astro.props;
---

{variant === 'card' && (
  <div class={`bg-gray-800 rounded-lg border border-gray-700 p-6 ${className}`}>
    <div class="flex justify-between items-start mb-4">
      <div class="bg-gray-700 rounded h-6 w-32 animate-pulse"></div>
      <div class="bg-gray-700 rounded h-5 w-16 animate-pulse"></div>
    </div>
    <div class="space-y-2 mb-4">
      <div class="bg-gray-700 rounded h-4 w-full animate-pulse"></div>
      <div class="bg-gray-700 rounded h-4 w-3/4 animate-pulse"></div>
    </div>
    <div class="grid grid-cols-2 gap-4 mb-4">
      <div class="space-y-2">
        <div class="bg-gray-700 rounded h-3 w-12 animate-pulse"></div>
        <div class="bg-gray-700 rounded h-4 w-20 animate-pulse"></div>
      </div>
      <div class="space-y-2">
        <div class="bg-gray-700 rounded h-3 w-12 animate-pulse"></div>
        <div class="bg-gray-700 rounded h-4 w-20 animate-pulse"></div>
      </div>
    </div>
    <div class="flex gap-2">
      <div class="bg-gray-700 rounded h-8 w-20 animate-pulse"></div>
      <div class="bg-gray-700 rounded h-8 w-20 animate-pulse"></div>
    </div>
  </div>
)}

{variant === 'text' && (
  <div class={`space-y-2 ${className}`}>
    <div class="bg-gray-700 rounded h-4 w-full animate-pulse"></div>
    <div class="bg-gray-700 rounded h-4 w-5/6 animate-pulse"></div>
    <div class="bg-gray-700 rounded h-4 w-4/6 animate-pulse"></div>
  </div>
)}

{variant === 'avatar' && (
  <div class={`rounded-full bg-gray-700 animate-pulse ${className}`}></div>
)}

{variant === 'button' && (
  <div class={`bg-gray-700 rounded h-10 w-24 animate-pulse ${className}`}></div>
)}
