---
interface Props {
  message?: string;
  retryHref?: string;
}

const { message = 'Algo salió mal.', retryHref } = Astro.props;
---

<div class="py-16 text-center">
  <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-3">
    Error
  </p>
  <p class="text-[15px] text-[var(--color-ink-2)] max-w-md mx-auto text-pretty">
    {message}
  </p>
  {retryHref && (
    <a
      href={retryHref}
      class="inline-block mt-6 border rule text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] px-4 py-2 rounded-sm text-[14px] font-medium transition-colors focus-ring"
    >
      Reintentar
    </a>
  )}
</div>
