---
interface Props {
  category: string;
  name: string;
  description: string;
  count: number;
  locale: 'en' | 'es';
}

const { category, name, description, count, locale } = Astro.props;

const numberFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US');
---

<a
  href={`/catalog?category=${category}`}
  class="group block bg-[var(--color-paper)] p-6 hover:bg-[var(--color-paper-2)] transition-colors focus-ring"
>
  <div class="flex items-baseline justify-between gap-4 mb-3">
    <h3 class="font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">{name}</h3>
    <span class="text-[13px] tnum text-[var(--color-ink-3)]">{numberFmt.format(count)}</span>
  </div>
  <p class="text-sm text-[var(--color-ink-2)] text-pretty leading-relaxed">{description}</p>
</a>
