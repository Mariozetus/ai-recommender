---
interface Props {
  category: string;
  name: string;
  description: string;
  count: number;
  locale: 'en' | 'es';
}

const { category, name, description, count, locale } = Astro.props;

const icons: Record<string, string> = {
  chat: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />`,
  coding: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />`,
  reasoning: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />`,
  image: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
  embedding: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />`,
  multimodal: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />`
};

const colors: Record<string, string> = {
  chat: 'from-blue-600/20 to-blue-600/5 border-blue-800/50 hover:border-blue-600',
  coding: 'from-green-600/20 to-green-600/5 border-green-800/50 hover:border-green-600',
  reasoning: 'from-purple-600/20 to-purple-600/5 border-purple-800/50 hover:border-purple-600',
  image: 'from-pink-600/20 to-pink-600/5 border-pink-800/50 hover:border-pink-600',
  embedding: 'from-orange-600/20 to-orange-600/5 border-orange-800/50 hover:border-orange-600',
  multimodal: 'from-cyan-600/20 to-cyan-600/5 border-cyan-800/50 hover:border-cyan-600'
};

const iconColors: Record<string, string> = {
  chat: 'text-blue-400',
  coding: 'text-green-400',
  reasoning: 'text-purple-400',
  image: 'text-pink-400',
  embedding: 'text-orange-400',
  multimodal: 'text-cyan-400'
};
---

<a
  href={`/catalog?category=${category}`}
  class:list={[
    'group block p-6 rounded-xl border bg-gradient-to-br transition-colors transition-transform hover:scale-105 hover:shadow-lg focus-ring',
    colors[category] || 'from-gray-600/20 to-gray-600/5 border-gray-800/50 hover:border-gray-600'
  ]}
>
  <div class="flex items-start gap-4">
    <div class:list={['p-3 rounded-lg bg-gray-800/50', iconColors[category]]}>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[category] || icons.chat} />
    </div>
    <div class="flex-1">
      <div class="flex items-center justify-between mb-1 gap-2">
        <h3 class="font-semibold text-white group-hover:text-teal-400 transition-colors text-balance">{name}</h3>
        <span class="text-xs text-gray-500 tnum">{count}</span>
      </div>
      <p class="text-sm text-gray-400 text-pretty">{description}</p>
    </div>
  </div>
</a>
