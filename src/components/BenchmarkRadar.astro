---
interface Benchmark {
  mmlu?: number;
  mmlu_pro?: number;
  humaneval?: number;
  math?: number;
  gpqa?: number;
  livecodebench?: number;
  arena_elo?: number;
}

interface Props {
  benchmarks: Benchmark;
  size?: number;
}

const { benchmarks, size = 300 } = Astro.props;

const metrics = [
  { key: 'mmlu', label: 'MMLU', max: 100 },
  { key: 'mmlu_pro', label: 'MMLU Pro', max: 100 },
  { key: 'humaneval', label: 'HumanEval', max: 100 },
  { key: 'math', label: 'MATH', max: 100 },
  { key: 'arena_elo', label: 'Arena ELO', max: 1400 },
] as const;

const activeMetrics = metrics.filter(m => benchmarks[m.key] !== undefined && benchmarks[m.key] !== null);

const center = size / 2;
const radius = size / 2 - 40;
const angleStep = (2 * Math.PI) / activeMetrics.length;

const points = activeMetrics.map((m, i) => {
  const value = benchmarks[m.key as keyof Benchmark] || 0;
  const normalized = Math.min(value / m.max, 1);
  const angle = i * angleStep - Math.PI / 2;
  const x = center + radius * normalized * Math.cos(angle);
  const y = center + radius * normalized * Math.sin(angle);
  return { x, y, value, label: m.label };
});

const polygonPoints = points.map(p => `${p.x},${p.y}`).join(' ');
const labelPoints = activeMetrics.map((m, i) => {
  const angle = i * angleStep - Math.PI / 2;
  const labelRadius = radius + 25;
  const x = center + labelRadius * Math.cos(angle);
  const y = center + labelRadius * Math.sin(angle);
  return { x, y, label: m.label };
});

const gridLevels = [0.25, 0.5, 0.75, 1];
---

<div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
  <h3 class="text-lg font-semibold text-white mb-4">Benchmark Performance</h3>

  <div class="flex justify-center">
    <svg width={size} height={size} class="overflow-visible">
      {gridLevels.map(level => {
        const r = radius * level;
        const levelPoints = activeMetrics.map((_, i) => {
          const angle = i * angleStep - Math.PI / 2;
          return `${center + r * Math.cos(angle)},${center + r * Math.sin(angle)}`;
        }).join(' ');
        return `<polygon points="${levelPoints}" fill="none" stroke="rgb(75,85,99)" stroke-width="1" opacity="0.5" />`;
      })}

      {activeMetrics.map((_, i) => {
        const angle = i * angleStep - Math.PI / 2;
        const x2 = center + radius * Math.cos(angle);
        const y2 = center + radius * Math.sin(angle);
        return `<line x1="${center}" y1="${center}" x2="${x2}" y2="${y2}" stroke="rgb(75,85,99)" stroke-width="1" opacity="0.5" />`;
      })}

      <polygon
        points={polygonPoints}
        fill="rgba(20,184,166,0.2)"
        stroke="rgb(20,184,166)"
        stroke-width="2"
      />

      {points.map((p, i) => (
        <circle cx={p.x} cy={p.y} r="4" fill="rgb(20,184,166)" />
      ))}

      {labelPoints.map((lp, i) => (
        <text
          x={lp.x}
          y={lp.y}
          text-anchor="middle"
          dominant-baseline="middle"
          fill="rgb(156,163,175)"
          font-size="12"
        >
          {lp.label}
        </text>
      ))}
    </svg>
  </div>

  <div class="grid grid-cols-2 gap-2 mt-4">
    {points.map(p => (
      <div class="flex justify-between text-sm">
        <span class="text-gray-400">{p.label}</span>
        <span class="text-white font-mono">{typeof p.value === 'number' ? p.value.toFixed(1) : p.value}</span>
      </div>
    ))}
  </div>
</div>
