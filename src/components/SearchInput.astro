---
import type { AIModel } from '../lib/types';

interface Props {
  models: Pick<AIModel, 'id' | 'name' | 'provider' | 'category'>[];
  initialQuery?: string;
}

const { models, initialQuery = '' } = Astro.props;

const searchable = models.slice(0, 200).map(m => ({
  id: m.id,
  name: m.name,
  provider: m.provider,
  category: m.category,
}));
---

<div class="relative" data-search-root>
  <div class="relative">
    <input
      type="search"
      name="q"
      value={initialQuery}
      placeholder="Buscar modelos… (ej: gpt, claude, vision)"
      autocomplete="off"
      aria-label="Buscar modelos"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="search-suggestions"
      aria-activedescendant=""
      data-search-input
      class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] placeholder-[var(--color-ink-4)] rounded-sm pl-10 pr-4 py-2.5 text-[14px] focus-ring focus:border-[var(--color-ink-3)]"
    />
    <svg
      class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-ink-3)] pointer-events-none"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </div>

  <div
    id="search-suggestions"
    role="listbox"
    aria-label="Sugerencias de búsqueda"
    data-search-suggestions
    class="hidden absolute z-30 mt-1 w-full bg-[var(--color-paper-2)] border rule rounded-sm shadow-xl max-h-80 overflow-y-auto overscroll-contain"
  >
  </div>
</div>

<script define:vars={{ models: searchable }}>
  const root = document.querySelector('[data-search-root]');
  const input = document.querySelector('[data-search-input]');
  const suggestions = document.querySelector('[data-search-suggestions]');

  if (root && input && suggestions) {
    let activeIndex = -1;

    function score(query, target) {
      const q = query.toLowerCase();
      const t = target.toLowerCase();
      if (t === q) return 1000;
      if (t.startsWith(q)) return 500;
      if (t.includes(q)) return 100;
      return -1;
    }

    function bestMatch(query) {
      if (!query || query.length < 2) return [];
      const results = [];
      for (const m of models) {
        const s = Math.max(
          score(query, m.name),
          score(query, m.id),
          score(query, m.provider) * 0.5
        );
        if (s > 0) results.push({ ...m, _score: s });
      }
      results.sort((a, b) => b._score - a._score);
      return results.slice(0, 8);
    }

    function render(matches) {
      if (matches.length === 0) {
        suggestions.innerHTML = '<div class="px-4 py-3 text-[var(--color-ink-3)] text-[13px]">Sin resultados</div>';
        return;
      }

      const escape = (s) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      suggestions.innerHTML = matches.map((m, i) => `
        <a
          href="/models/${m.provider}/${m.id.split("/")[1] || ""}"
          role="option"
          id="search-opt-${i}"
          data-index="${i}"
          aria-selected="${i === activeIndex}"
          class="flex items-center justify-between px-4 py-2.5 hover:bg-[var(--color-paper)] border-b rule last:border-0 transition-colors cursor-pointer ${i === activeIndex ? 'bg-[var(--color-paper)]' : ''}"
        >
          <div class="flex-1 min-w-0">
            <div class="text-[14px] text-[var(--color-ink)] truncate">${escape(m.name)}</div>
            <div class="text-[12px] text-[var(--color-ink-3)] truncate">${escape(m.id)}</div>
          </div>
          <span class="ml-3 text-[11px] uppercase tracking-wider text-[var(--color-ink-3)]">${escape(m.category)}</span>
        </a>
      `).join('');
    }

    function updateActive() {
      const links = suggestions.querySelectorAll('[data-index]');
      input.setAttribute('aria-activedescendant', activeIndex >= 0 ? `search-opt-${activeIndex}` : '');
      links.forEach((link, i) => {
        if (i === activeIndex) {
          link.classList.add('bg-[var(--color-paper)]');
          link.setAttribute('aria-selected', 'true');
          link.scrollIntoView({ block: 'nearest' });
        } else {
          link.classList.remove('bg-[var(--color-paper)]');
          link.setAttribute('aria-selected', 'false');
        }
      });
    }

    input.addEventListener('input', (e) => {
      const q = e.target.value.trim();
      activeIndex = -1;

      if (q.length < 2) {
        suggestions.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        input.setAttribute('aria-activedescendant', '');
        return;
      }

      const matches = bestMatch(q);
      render(matches);
      suggestions.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    });

    input.addEventListener('keydown', (e) => {
      const links = suggestions.querySelectorAll('[data-index]');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(links.length - 1, activeIndex + 1);
        updateActive();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(0, activeIndex - 1);
        updateActive();
      } else if (e.key === 'Enter' && activeIndex >= 0 && links[activeIndex]) {
        e.preventDefault();
        window.location.href = links[activeIndex].href;
      } else if (e.key === 'Escape') {
        suggestions.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });

    input.addEventListener('blur', () => {
      setTimeout(() => {
        suggestions.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }, 200);
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) {
        suggestions.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
