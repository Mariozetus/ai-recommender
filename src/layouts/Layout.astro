---
import '../styles/global.css';
import Toast from '../components/Toast.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Catálogo de modelos de IA con precios, contexto y benchmarks reales. Compara y encuentra el modelo para tu caso de uso.' } = Astro.props;

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
};

const navLinks = [
  { href: '/catalog', label: 'Catálogo' },
  { href: '/use-cases', label: 'Casos de uso' },
  { href: '/best', label: 'Rankings' },
  { href: '/providers', label: 'Proveedores' },
  { href: '/insights', label: 'Insights' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="preconnect" href="https://rsms.me" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-[var(--color-accent)] focus:text-[var(--color-paper)] focus:px-3 focus:py-2 focus:rounded-sm focus:font-medium"
    >
      Saltar al contenido
    </a>

    <header class="border-b rule">
      <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
        <a href="/" class="font-semibold text-[15px] tracking-tight focus-ring">
          <span class="text-[var(--color-ink)]">AI</span><span class="text-[var(--color-accent)]">/</span><span class="text-[var(--color-ink-2)]">Recommender</span>
        </a>

        <nav class="hidden md:flex items-center gap-1 text-[14px]" aria-label="Principal">
          {navLinks.map(link => (
            <a
              href={link.href}
              class="px-3 py-1.5 rounded-sm text-[var(--color-ink-2)] hover:text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] transition-colors focus-ring"
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
          <a
            href="/recommend"
            class="ml-2 px-3 py-1.5 rounded-sm text-[var(--color-paper)] bg-[var(--color-accent)] hover:bg-[var(--color-accent-2)] transition-colors font-medium focus-ring"
            aria-current={isActive('/recommend') ? 'page' : undefined}
          >
            Quiz
          </a>
        </nav>

        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden p-2 -mr-2 text-[var(--color-ink-2)] hover:text-[var(--color-ink)] focus-ring"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <div id="mobile-menu" class="hidden md:hidden border-t rule">
        <nav class="px-6 py-3 space-y-1 text-[14px]" aria-label="Móvil">
          {[...navLinks, { href: '/recommend', label: 'Quiz' }].map(link => (
            <a
              href={link.href}
              class="block py-2 px-2 -mx-2 rounded-sm text-[var(--color-ink-2)] hover:text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] transition-colors focus-ring"
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1 focus:outline-none" tabindex="-1">
      <slot />
    </main>

    <footer class="border-t rule mt-24">
      <div class="max-w-6xl mx-auto px-6 py-8 flex flex-wrap items-center justify-between gap-4 text-[13px] text-[var(--color-ink-3)]">
        <p>Datos de OpenRouter. Actualizado periódicamente.</p>
        <div class="flex gap-6">
          <a href="/insights" class="hover:text-[var(--color-ink)] transition-colors focus-ring">Insights</a>
          <a href="/catalog" class="hover:text-[var(--color-ink)] transition-colors focus-ring">Catálogo</a>
        </div>
      </div>
    </footer>
    <Toast />
  </body>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      const isOpen = menu?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  </script>
</html>
