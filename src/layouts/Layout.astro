---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-gray-900 text-gray-100 min-h-screen">
    <header class="border-b border-gray-800">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-teal-400">AI Recommender</a>
        <div class="flex gap-6">
          <a href="/" class="hover:text-teal-400 transition">Catalog</a>
          <a href="/recommend" class="hover:text-teal-400 transition">Get Recommendations</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-gray-800 mt-16 py-8 text-center text-gray-500 text-sm">
      <p>AI Recommender - Data updated weekly from OpenRouter, LMSYS Arena & Artificial Analysis</p>
    </footer>
  </body>
</html>
