---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import BenchmarkBar from '../components/BenchmarkBar.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { detectLocale, setLocale, t } from '../i18n/index';

const url = new URL(Astro.request.url);
const idsParam = url.searchParams.get('ids') || '';
let compareIds = idsParam.split(',').filter(Boolean);

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = detectLocale(acceptLanguage || undefined);
setLocale(locale);

const numberFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US');
const currencyFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US', { style: 'currency', currency: 'USD' });

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const compareModels = compareIds
  .map(id => models.find((m: any) => m.id === decodeURIComponent(id)))
  .filter(Boolean);

if (compareModels.length === 0) {
  return Astro.redirect('/');
}

const lowestPrice = Math.min(...compareModels.map((m: any) => m.input_price + m.output_price));
const highestMMLU = Math.max(...compareModels.filter((m: any) => m.benchmark?.mmlu).map((m: any) => m.benchmark.mmlu));
const highestContext = Math.max(...compareModels.map((m: any) => m.context_window));
const highestArenaElo = Math.max(...compareModels.filter((m: any) => m.benchmark?.arena_elo).map((m: any) => m.benchmark.arena_elo));
---

<Layout title={t('compare.title')}>
  <div class="border-b rule">
    <div class="max-w-7xl mx-auto px-6 py-12">
      <div class="flex flex-col lg:flex-row lg:justify-between lg:items-end gap-6">
        <div class="min-w-0">
          <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-3">
            Comparación
          </p>
          <h1 class="text-3xl md:text-4xl font-semibold tracking-[-0.02em] text-[var(--color-ink)] mb-3 text-balance">
            {t('compare.comparing', { count: numberFmt.format(compareModels.length) })}
          </h1>
          <p class="text-[var(--color-ink-2)] max-w-2xl text-pretty">
            Análisis lado a lado de precio, contexto y benchmarks.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 lg:flex-shrink-0">
          <a
            href="/"
            class="border rule text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] px-4 py-2 rounded-sm text-[13px] font-medium transition-colors focus-ring"
          >
            {t('compare.back').replace('← ', '')}
          </a>
          <button
            type="button"
            id="save-comparison"
            class="border rule text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] px-4 py-2 rounded-sm text-[13px] font-medium transition-colors focus-ring"
          >
            Guardar
          </button>
          <button
            type="button"
            id="clear-all"
            class="border rule text-[var(--color-accent)] hover:bg-[var(--color-paper-2)] px-4 py-2 rounded-sm text-[13px] font-medium transition-colors focus-ring"
          >
            {t('compare.clear_all')}
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="border-b rule">
    <nav class="max-w-7xl mx-auto px-6 flex gap-6 overflow-x-auto" id="tab-nav" aria-label="Secciones">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="tab-overview"
        class="tab-btn py-3 text-[14px] font-medium border-b-2 border-[var(--color-ink)] text-[var(--color-ink)] focus-ring"
        data-tab="overview"
      >Overview</button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="tab-benchmarks"
        class="tab-btn py-3 text-[14px] font-medium border-b-2 border-transparent text-[var(--color-ink-3)] hover:text-[var(--color-ink-2)] focus-ring"
        data-tab="benchmarks"
      >Benchmarks</button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="tab-pricing"
        class="tab-btn py-3 text-[14px] font-medium border-b-2 border-transparent text-[var(--color-ink-3)] hover:text-[var(--color-ink-2)] focus-ring"
        data-tab="pricing"
      >Pricing</button>
    </nav>
  </div>

  <div class="max-w-7xl mx-auto px-6 py-10">
    <div id="tab-overview" class="tab-content" role="tabpanel">
      <div class="overflow-x-auto border rule">
        <table class="w-full text-[14px]">
          <thead>
            <tr class="border-b rule">
              <th class="text-left p-4 text-[var(--color-ink-3)] font-medium bg-[var(--color-paper-2)] min-w-[160px]">{t('compare.feature')}</th>
              {compareModels.map((model: any) => (
                <th class="text-left p-4 min-w-[200px] align-top">
                  <div class="flex justify-between items-start gap-3">
                    <div class="min-w-0 flex-1">
                      <p class="text-[11px] uppercase tracking-wider text-[var(--color-ink-3)] mb-1">{model.provider}</p>
                      <a
                        href={`/models/${model.provider}/${model.id.split("/")[1] || ""}`}
                        class="text-[15px] font-semibold text-[var(--color-ink)] hover:text-[var(--color-accent)] transition-colors focus-ring"
                      >
                        {model.name}
                      </a>
                    </div>
                    <button
                      type="button"
                      class="remove-btn text-[var(--color-ink-3)] hover:text-[var(--color-accent)] p-1 -m-1 focus-ring"
                      data-model-id={model.id}
                      aria-label={`Quitar ${model.name} de la comparación`}
                      title="Remove"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                    </button>
                  </div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-rule)]">
            <tr>
              <td class="p-4 bg-[var(--color-paper-2)] align-top">
                <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">Proveedor</p>
              </td>
              {compareModels.map((model: any) => (
                <td class="p-4 text-[var(--color-ink-2)] tnum">{model.provider}</td>
              ))}
            </tr>
            <tr>
              <td class="p-4 bg-[var(--color-paper-2)] align-top">
                <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">{t('compare.context')}</p>
              </td>
              {compareModels.map((model: any) => (
                <td class="p-4 tnum">
                  {model.context_window === highestContext ? (
                    <span class="text-[var(--color-accent)] font-medium">{numberFmt.format(model.context_window)}</span>
                  ) : (
                    <span class="text-[var(--color-ink)]">{numberFmt.format(model.context_window)}</span>
                  )}
                </td>
              ))}
            </tr>
            <tr>
              <td class="p-4 bg-[var(--color-paper-2)] align-top">
                <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">{t('compare.input_price')}</p>
              </td>
              {compareModels.map((model: any) => {
                const minInput = Math.min(...compareModels.filter((m: any) => m.input_price > 0).map((m: any) => m.input_price));
                const isBest = model.input_price > 0 && model.input_price === minInput;
                return (
                  <td class="p-4 tnum">
                    {isBest ? (
                      <span class="text-[var(--color-accent)] font-medium">{currencyFmt.format(model.input_price)}</span>
                    ) : (
                      <span class="text-[var(--color-ink)]">{currencyFmt.format(model.input_price)}</span>
                    )}
                  </td>
                );
              })}
            </tr>
            <tr>
              <td class="p-4 bg-[var(--color-paper-2)] align-top">
                <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">{t('compare.output_price')}</p>
              </td>
              {compareModels.map((model: any) => {
                const minOutput = Math.min(...compareModels.filter((m: any) => m.output_price > 0).map((m: any) => m.output_price));
                const isBest = model.output_price > 0 && model.output_price === minOutput;
                return (
                  <td class="p-4 tnum">
                    {isBest ? (
                      <span class="text-[var(--color-accent)] font-medium">{currencyFmt.format(model.output_price)}</span>
                    ) : (
                      <span class="text-[var(--color-ink)]">{currencyFmt.format(model.output_price)}</span>
                    )}
                  </td>
                );
              })}
            </tr>
            <tr>
              <td class="p-4 bg-[var(--color-paper-2)] align-top">
                <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">{t('compare.combined_price')}</p>
              </td>
              {compareModels.map((model: any) => {
                const total = model.input_price + model.output_price;
                const isBest = total > 0 && total === lowestPrice;
                return (
                  <td class="p-4 tnum">
                    {isBest ? (
                      <span class="text-[var(--color-accent)] font-medium">{currencyFmt.format(total)}</span>
                    ) : (
                      <span class="text-[var(--color-ink)]">{currencyFmt.format(total)}</span>
                    )}
                  </td>
                );
              })}
            </tr>
            <tr>
              <td class="p-4 bg-[var(--color-paper-2)] align-top">
                <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">{t('compare.free_tier')}</p>
              </td>
              {compareModels.map((model: any) => (
                <td class="p-4">
                  {model.pricing?.free ? (
                    <span class="text-[var(--color-accent)] font-medium">{t('compare.yes')}</span>
                  ) : (
                    <span class="text-[var(--color-ink-3)]">—</span>
                  )}
                </td>
              ))}
            </tr>
            <tr>
              <td class="p-4 bg-[var(--color-paper-2)] align-top">
                <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">Batch API</p>
              </td>
              {compareModels.map((model: any) => (
                <td class="p-4">
                  {model.pricing?.batch ? (
                    <span class="text-[var(--color-accent)] font-medium">{t('compare.yes')}</span>
                  ) : (
                    <span class="text-[var(--color-ink-3)]">—</span>
                  )}
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div id="tab-benchmarks" class="tab-content hidden" role="tabpanel">
      <div class="grid gap-6" style={`grid-template-columns: repeat(${Math.min(compareModels.length, 4)}, minmax(0, 1fr))`}>
        {compareModels.map((model: any) => (
          <section class="border rule p-5">
            <p class="text-[11px] uppercase tracking-wider text-[var(--color-ink-3)] mb-1">{model.provider}</p>
            <h3 class="text-[15px] font-semibold text-[var(--color-ink)] mb-4">{model.name}</h3>
            {model.benchmark ? (
              <BenchmarkBar benchmarks={model.benchmark} />
            ) : (
              <p class="text-[13px] text-[var(--color-ink-3)]">Sin datos</p>
            )}
          </section>
        ))}
      </div>
    </div>

    <div id="tab-pricing" class="tab-content hidden" role="tabpanel">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-4">
        Costos
      </p>
      <div class="overflow-x-auto border rule">
        <table class="w-full text-[14px]">
          <thead>
            <tr class="border-b rule">
              <th class="text-left p-4 text-[var(--color-ink-3)] font-medium bg-[var(--color-paper-2)] min-w-[180px]">Escenario</th>
              {compareModels.map((model: any) => (
                <th class="text-left p-4 min-w-[160px]">
                  <p class="text-[11px] uppercase tracking-wider text-[var(--color-ink-3)] mb-1">{model.provider}</p>
                  <span class="text-[14px] font-semibold text-[var(--color-ink)]">{model.name}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-rule)]">
            {[
              { label: 'Input / 1M tokens', key: 'input' },
              { label: 'Output / 1M tokens', key: 'output' },
              { label: '1K input + 500 output', key: '1k500' },
              { label: '10K input + 2K output', key: '10k2k' },
              { label: '100K input + 20K output', key: '100k20k' },
            ].map((scenario) => {
              const totals = compareModels.map((m: any) => {
                if (scenario.key === 'input') return m.input_price;
                if (scenario.key === 'output') return m.output_price;
                if (scenario.key === '1k500') return (1000 / 1_000_000) * m.input_price + (500 / 1_000_000) * m.output_price;
                if (scenario.key === '10k2k') return (10_000 / 1_000_000) * m.input_price + (2_000 / 1_000_000) * m.output_price;
                return (100_000 / 1_000_000) * m.input_price + (20_000 / 1_000_000) * m.output_price;
              });
              const minTotal = Math.min(...totals.filter(v => v > 0));
              return (
                <tr>
                  <td class="p-4 bg-[var(--color-paper-2)] align-top">
                    <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">{scenario.label}</p>
                  </td>
                  {compareModels.map((model: any, i: number) => {
                    const v = totals[i];
                    const isBest = v > 0 && v === minTotal;
                    return (
                      <td class="p-4 tnum">
                        {v === 0 ? (
                          <span class="text-[var(--color-ink-3)]">Gratis</span>
                        ) : isBest ? (
                          <span class="text-[var(--color-accent)] font-medium">{currencyFmt.format(v)}</span>
                        ) : (
                          <span class="text-[var(--color-ink)]">{currencyFmt.format(v)}</span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="save-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/60" id="save-modal-overlay"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-[var(--color-paper)] border rule p-6">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-[15px] font-semibold text-[var(--color-ink)] text-balance">Save Comparison</h3>
        <button id="close-save-modal" type="button" aria-label="Cerrar" class="text-[var(--color-ink-3)] hover:text-[var(--color-ink)] p-1 -m-1 focus-ring">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="mb-4">
        <label for="comparison-name" class="block text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-2">Name your comparison</label>
        <input
          type="text"
          id="comparison-name"
          name="comparison-name"
          placeholder="My best models"
          autocomplete="off"
          class="w-full bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] placeholder-[var(--color-ink-3)] rounded-sm px-3 py-2 text-[14px] focus-ring focus:border-[var(--color-ink-3)]"
        />
      </div>
      <div class="flex gap-2">
        <button id="confirm-save" type="button" class="flex-1 bg-[var(--color-ink)] text-[var(--color-paper)] hover:bg-[var(--color-ink-2)] py-2 rounded-sm text-[13px] font-medium transition-colors focus-ring">Save</button>
        <button id="cancel-save" type="button" class="flex-1 border rule text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] py-2 rounded-sm text-[13px] font-medium transition-colors focus-ring">Cancel</button>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 pb-12">
    <h2 class="text-[15px] font-semibold text-[var(--color-ink)] mb-4 text-balance">Comparaciones guardadas</h2>
    <div id="saved-list" class="grid md:grid-cols-3 gap-3">
    </div>
  </div>
</Layout>

<script>
  const currentIds = new URLSearchParams(window.location.search).get('ids')?.split(',').map(decodeURIComponent) || [];

  function renderSavedList() {
    const saved = JSON.parse(localStorage.getItem('savedComparisons') || '[]');
    const container = document.getElementById('saved-list');
    if (!container) return;

    if (saved.length === 0) {
      container.innerHTML = '<p class="text-[var(--color-ink-3)] text-[13px] col-span-3">No hay comparaciones guardadas.</p>';
      return;
    }

    container.innerHTML = saved.map((s: any, i: number) => `
      <div class="border rule p-4 bg-[var(--color-paper)]">
        <div class="flex justify-between items-start mb-3 gap-2">
          <h3 class="font-semibold text-[var(--color-ink)] min-w-0">${s.name}</h3>
          <button type="button" aria-label="Eliminar" class="delete-saved text-[var(--color-ink-3)] hover:text-[var(--color-accent)] focus-ring" data-index="${i}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </div>
        <p class="text-[var(--color-ink-3)] text-[12px] tnum mb-3">${s.ids.length} modelos</p>
        <a href="/compare?ids=${s.ids.map(encodeURIComponent).join(',')}" class="border rule text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] px-3 py-1.5 rounded-sm text-[13px] font-medium transition-colors inline-block focus-ring">Cargar</a>
      </div>
    `).join('');

    container.querySelectorAll('.delete-saved').forEach(btn => {
      btn.addEventListener('click', () => {
        const index = parseInt((btn as HTMLElement).dataset.index || '0');
        saved.splice(index, 1);
        localStorage.setItem('savedComparisons', JSON.stringify(saved));
        renderSavedList();
      });
    });
  }

  const saveModal = document.getElementById('save-modal');
  const comparisonName = document.getElementById('comparison-name') as HTMLInputElement;
  const saveBtn = document.getElementById('save-comparison');
  const closeSaveBtn = document.getElementById('close-save-modal');
  const confirmSaveBtn = document.getElementById('confirm-save');
  const cancelSaveBtn = document.getElementById('cancel-save');
  const saveModalOverlay = document.getElementById('save-modal-overlay');

  saveBtn?.addEventListener('click', () => {
    saveModal?.classList.remove('hidden');
    comparisonName?.focus();
  });

  closeSaveBtn?.addEventListener('click', () => saveModal?.classList.add('hidden'));
  cancelSaveBtn?.addEventListener('click', () => saveModal?.classList.add('hidden'));
  saveModalOverlay?.addEventListener('click', () => saveModal?.classList.add('hidden'));

  confirmSaveBtn?.addEventListener('click', () => {
    const name = comparisonName?.value.trim();
    if (!name) return;

    const saved = JSON.parse(localStorage.getItem('savedComparisons') || '[]');
    saved.push({ name, ids: currentIds });
    localStorage.setItem('savedComparisons', JSON.stringify(saved));
    saveModal?.classList.add('hidden');
    comparisonName.value = '';
    renderSavedList();
  });

  renderSavedList();

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tabId = (btn as HTMLElement).dataset.tab;

      document.querySelectorAll('.tab-btn').forEach(b => {
        b.setAttribute('aria-selected', 'false');
        b.classList.remove('border-[var(--color-ink)]', 'text-[var(--color-ink)]');
        b.classList.add('border-transparent', 'text-[var(--color-ink-3)]');
      });
      btn.setAttribute('aria-selected', 'true');
      btn.classList.add('border-[var(--color-ink)]', 'text-[var(--color-ink)]');
      btn.classList.remove('border-transparent', 'text-[var(--color-ink-3)]');

      document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.add('hidden');
      });
      document.getElementById(`tab-${tabId}`)?.classList.remove('hidden');
    });
  });

  document.getElementById('clear-all')?.addEventListener('click', () => {
    localStorage.removeItem('compareIds');
    window.location.href = '/';
  });

  document.querySelectorAll('.remove-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const modelId = (btn as HTMLElement).dataset.modelId;
      const ids = JSON.parse(localStorage.getItem('compareIds') || '[]');
      const newIds = ids.filter((id: string) => id !== modelId);
      localStorage.setItem('compareIds', JSON.stringify(newIds));

      const params = new URLSearchParams(window.location.search);
      const currentIds = params.get('ids')?.split(',').map(decodeURIComponent) || [];
      const updatedIds = currentIds.filter((id: string) => id !== modelId);

      if (updatedIds.length === 0) {
        window.location.href = '/';
      } else {
        window.location.href = `/compare?ids=${updatedIds.map(encodeURIComponent).join(',')}`;
      }
    });
  });
</script>

