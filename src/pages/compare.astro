---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import BenchmarkRadar from '../components/BenchmarkRadar.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { detectLocale, setLocale, t } from '../i18n/index';

const url = new URL(Astro.request.url);
const idsParam = url.searchParams.get('ids') || '';
let compareIds = idsParam.split(',').filter(Boolean);

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = detectLocale(acceptLanguage || undefined);
setLocale(locale);

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const compareModels = compareIds
  .map(id => models.find((m: any) => m.id === decodeURIComponent(id)))
  .filter(Boolean);

if (compareModels.length === 0) {
  return Astro.redirect('/');
}

const categoryColors: Record<string, string> = {
  chat: '#1e3a5f',
  coding: '#1a3d1a',
  reasoning: '#3d1a5c',
  image: '#3d1a3d',
  embedding: '#5c3d1a',
  multimodal: '#1a3d3d',
};

const lowestPrice = Math.min(...compareModels.map((m: any) => m.input_price + m.output_price));
const highestMMLU = Math.max(...compareModels.filter((m: any) => m.benchmark?.mmlu).map((m: any) => m.benchmark.mmlu));
const highestContext = Math.max(...compareModels.map((m: any) => m.context_window));
const highestArenaElo = Math.max(...compareModels.filter((m: any) => m.benchmark?.arena_elo).map((m: any) => m.benchmark.arena_elo));
---

<Layout title={t('compare.title')}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-bold mb-2">{t('compare.title')}</h1>
        <p class="text-gray-400">{t('compare.comparing', { count: compareModels.length.toString() })}</p>
      </div>
      <div class="flex gap-3">
        <a
          href="/"
          class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded font-medium transition"
        >
          {t('compare.back').replace('← ', '')}
        </a>
        <button
          id="save-comparison"
          class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded font-medium transition"
        >
          Save
        </button>
        <button
          id="clear-all"
          class="bg-red-900/50 hover:bg-red-800/50 text-red-300 px-4 py-2 rounded font-medium transition border border-red-800"
        >
          {t('compare.clear_all')}
        </button>
      </div>
    </div>

    <div class="mb-6 border-b border-gray-700">
      <nav class="flex gap-4" id="tab-nav">
        <button class="tab-btn active px-4 py-2 text-teal-400 border-b-2 border-teal-400 font-medium" data-tab="overview">Overview</button>
        <button class="tab-btn px-4 py-2 text-gray-400 hover:text-white border-b-2 border-transparent" data-tab="benchmarks">Benchmarks</button>
        <button class="tab-btn px-4 py-2 text-gray-400 hover:text-white border-b-2 border-transparent" data-tab="pricing">Pricing</button>
      </nav>
    </div>

    <div id="tab-overview" class="tab-content">
      <div class="overflow-x-auto">
        <table class="w-full bg-gray-800 rounded-lg border border-gray-700">
          <thead>
            <tr class="border-b border-gray-700">
              <th class="text-left p-4 text-gray-400 font-medium sticky left-0 bg-gray-800 min-w-[140px]">{t('compare.feature')}</th>
              {compareModels.map((model: any) => (
                <th class="text-left p-4 min-w-[200px]">
                  <div class="flex justify-between items-start">
                    <div class="flex-1">
                      <a href={`/models/${model.provider}/${model.id.split("/")[1] || ""}`} class="text-lg font-semibold text-white hover:text-teal-400">
                        {model.name}
                      </a>
                      <p class="text-gray-500 text-sm">{model.provider}</p>
                    </div>
                    <button
                      class="remove-btn text-gray-500 hover:text-red-400 ml-2 p-1"
                      data-model-id={model.id}
                      title="Remove"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                    </button>
                  </div>
                  <span
                    class="inline-block mt-2 px-2 py-1 rounded text-xs font-medium text-white"
                    style={`background-color: ${categoryColors[model.category] || '#374151'}`}
                  >
                    {model.category}
                  </span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-700">
              <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">{t('compare.context')}</td>
              {compareModels.map((model: any) => (
                <td class="p-4">
                  <span class={`font-mono ${model.context_window === highestContext ? 'text-green-400' : 'text-white'}`}>
                    {model.context_window.toLocaleString()}
                  </span>
                  {model.context_window === highestContext && (
                    <span class="ml-2 text-xs text-green-400">★ {t('compare.best')}</span>
                  )}
                </td>
              ))}
            </tr>
            <tr class="border-b border-gray-700">
              <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">{t('compare.description')}</td>
              {compareModels.map((model: any) => (
                <td class="p-4 text-gray-300 text-sm max-w-xs">{model.description}</td>
              ))}
            </tr>
            <tr class="border-b border-gray-700">
              <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">{t('compare.tags')}</td>
              {compareModels.map((model: any) => (
                <td class="p-4">
                  <div class="flex flex-wrap gap-1">
                    {model.tags && model.tags.length > 0 ? (
                      model.tags.slice(0, 4).map((tag: string) => (
                        <span class="bg-gray-700 text-gray-400 px-2 py-1 rounded text-xs">{tag}</span>
                      ))
                    ) : (
                      <span class="text-gray-500">—</span>
                    )}
                  </div>
                </td>
              ))}
            </tr>
            <tr>
              <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">{t('compare.action')}</td>
              {compareModels.map((model: any) => (
                <td class="p-4">
                  <a
                    href={model.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-teal-400 hover:text-teal-300 text-sm"
                  >
                    {t('model.view_on', { provider: model.provider })} →
                  </a>
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div id="tab-benchmarks" class="tab-content hidden">
      {compareModels.length <= 4 && (
        <div class="grid gap-6" style={`grid-template-columns: repeat(${compareModels.length}, minmax(250px, 1fr))`}>
          {compareModels.map((model: any) => (
            <div>
              <h3 class="text-lg font-semibold text-white mb-4">{model.name}</h3>
              {model.benchmark ? (
                <BenchmarkRadar benchmarks={model.benchmark} size={220} />
              ) : (
                <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 text-center text-gray-400">
                  No benchmark data available
                </div>
              )}
            </div>
          ))}
        </div>
      )}
      <div class="overflow-x-auto mt-6">
        <table class="w-full bg-gray-800 rounded-lg border border-gray-700">
          <thead>
            <tr class="border-b border-gray-700">
              <th class="text-left p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">{t('compare.feature')}</th>
              {compareModels.map((model: any) => (
                <th class="text-left p-4 min-w-[160px]">
                  <span class="text-white font-semibold">{model.name}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {compareModels.some((m: any) => m.benchmark?.mmlu) && (
              <tr class="border-b border-gray-700">
                <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">MMLU</td>
                {compareModels.map((model: any) => (
                  <td class="p-4">
                    {model.benchmark?.mmlu ? (
                      <span class={`font-mono ${model.benchmark.mmlu === highestMMLU ? 'text-green-400' : 'text-white'}`}>
                        {model.benchmark.mmlu}%
                      </span>
                    ) : <span class="text-gray-500">—</span>}
                  </td>
                ))}
              </tr>
            )}
            {compareModels.some((m: any) => m.benchmark?.humaneval) && (
              <tr class="border-b border-gray-700">
                <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">HumanEval</td>
                {compareModels.map((model: any) => (
                  <td class="p-4">
                    {model.benchmark?.humaneval ? (
                      <span class="font-mono text-white">{model.benchmark.humaneval}%</span>
                    ) : <span class="text-gray-500">—</span>}
                  </td>
                ))}
              </tr>
            )}
            {compareModels.some((m: any) => m.benchmark?.math) && (
              <tr class="border-b border-gray-700">
                <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">MATH</td>
                {compareModels.map((model: any) => (
                  <td class="p-4">
                    {model.benchmark?.math ? (
                      <span class="font-mono text-white">{model.benchmark.math}%</span>
                    ) : <span class="text-gray-500">—</span>}
                  </td>
                ))}
              </tr>
            )}
            {compareModels.some((m: any) => m.benchmark?.arena_elo) && (
              <tr class="border-b border-gray-700">
                <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">Arena ELO</td>
                {compareModels.map((model: any) => (
                  <td class="p-4">
                    {model.benchmark?.arena_elo ? (
                      <span class={`font-mono ${model.benchmark.arena_elo === highestArenaElo ? 'text-green-400' : 'text-white'}`}>
                        {model.benchmark.arena_elo}
                      </span>
                    ) : <span class="text-gray-500">—</span>}
                  </td>
                ))}
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <div id="tab-pricing" class="tab-content hidden">
      <div class="overflow-x-auto">
        <table class="w-full bg-gray-800 rounded-lg border border-gray-700">
          <thead>
            <tr class="border-b border-gray-700">
              <th class="text-left p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">{t('compare.feature')}</th>
              {compareModels.map((model: any) => (
                <th class="text-left p-4 min-w-[160px]">
                  <span class="text-white font-semibold">{model.name}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-700">
              <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">{t('compare.context')}</td>
              {compareModels.map((model: any) => (
                <td class="p-4">
                  <span class={`font-mono ${model.context_window === highestContext ? 'text-green-400' : 'text-white'}`}>
                    {model.context_window.toLocaleString()} {t('common.tokens')}
                  </span>
                </td>
              ))}
            </tr>
            <tr class="border-b border-gray-700">
              <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">{t('compare.input_price')}</td>
              {compareModels.map((model: any) => (
                <td class="p-4">
                  <span class={`font-mono ${model.input_price === lowestPrice && model.input_price > 0 ? 'text-green-400' : 'text-white'}`}>
                    ${model.input_price}{t('common.per_1m')}
                  </span>
                </td>
              ))}
            </tr>
            <tr class="border-b border-gray-700">
              <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">{t('compare.output_price')}</td>
              {compareModels.map((model: any) => (
                <td class="p-4">
                  <span class={`font-mono ${model.output_price === lowestPrice && model.output_price > 0 ? 'text-green-400' : 'text-white'}`}>
                    ${model.output_price}{t('common.per_1m')}
                  </span>
                </td>
              ))}
            </tr>
            <tr class="border-b border-gray-700">
              <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">{t('compare.combined_price')}</td>
              {compareModels.map((model: any) => {
                const total = model.input_price + model.output_price;
                return (
                  <td class="p-4">
                    <span class={`font-mono ${total === lowestPrice && total > 0 ? 'text-green-400' : 'text-white'}`}>
                      ${total.toFixed(2)}{t('common.per_1m')}
                    </span>
                  </td>
                );
              })}
            </tr>
            {compareModels.some((m: any) => m.pricing?.free) && (
              <tr>
                <td class="p-4 text-gray-400 font-medium sticky left-0 bg-gray-800">{t('compare.free_tier')}</td>
                {compareModels.map((model: any) => (
                  <td class="p-4">
                    {model.pricing?.free ? (
                      <span class="text-green-400">✓ {t('compare.yes')}</span>
                    ) : (
                      <span class="text-gray-500">—</span>
                    )}
                  </td>
                ))}
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="save-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="save-modal-overlay"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-gray-800 rounded-lg border border-gray-700 p-6">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold text-white">Save Comparison</h3>
        <button id="close-save-modal" class="text-gray-400 hover:text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="mb-4">
        <label class="block text-sm text-gray-400 mb-2">Name your comparison</label>
        <input
          type="text"
          id="comparison-name"
          placeholder="My best models"
          class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:border-teal-500"
        />
      </div>
      <div class="flex gap-3">
        <button id="confirm-save" class="flex-1 bg-teal-600 hover:bg-teal-500 text-white py-2 rounded font-medium transition">Save</button>
        <button id="cancel-save" class="flex-1 bg-gray-700 hover:bg-gray-600 text-white py-2 rounded font-medium transition">Cancel</button>
      </div>
    </div>
  </div>

  <div id="saved-section" class="max-w-6xl mx-auto px-4 pb-8">
    <h2 class="text-xl font-bold text-white mb-4">Saved Comparisons</h2>
    <div id="saved-list" class="grid md:grid-cols-3 gap-4">
    </div>
  </div>
</Layout>

<script>
  const currentIds = new URLSearchParams(window.location.search).get('ids')?.split(',').map(decodeURIComponent) || [];

  function renderSavedList() {
    const saved = JSON.parse(localStorage.getItem('savedComparisons') || '[]');
    const container = document.getElementById('saved-list');
    if (!container) return;

    if (saved.length === 0) {
      container.innerHTML = '<p class="text-gray-400 col-span-3">No saved comparisons yet.</p>';
      return;
    }

    container.innerHTML = saved.map((s: any, i: number) => `
      <div class="bg-gray-800 rounded-lg border border-gray-700 p-4">
        <div class="flex justify-between items-start mb-3">
          <h3 class="font-semibold text-white">${s.name}</h3>
          <button class="delete-saved text-gray-500 hover:text-red-400" data-index="${i}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </div>
        <p class="text-gray-400 text-sm mb-3">${s.ids.length} models</p>
        <a href="/compare?ids=${s.ids.map(encodeURIComponent).join(',')}" class="bg-teal-600 hover:bg-teal-500 text-white px-4 py-2 rounded text-sm font-medium transition inline-block">Load</a>
      </div>
    `).join('');

    container.querySelectorAll('.delete-saved').forEach(btn => {
      btn.addEventListener('click', () => {
        const index = parseInt((btn as HTMLElement).dataset.index || '0');
        saved.splice(index, 1);
        localStorage.setItem('savedComparisons', JSON.stringify(saved));
        renderSavedList();
      });
    });
  }

  const saveModal = document.getElementById('save-modal');
  const comparisonName = document.getElementById('comparison-name') as HTMLInputElement;
  const saveBtn = document.getElementById('save-comparison');
  const closeSaveBtn = document.getElementById('close-save-modal');
  const confirmSaveBtn = document.getElementById('confirm-save');
  const cancelSaveBtn = document.getElementById('cancel-save');
  const saveModalOverlay = document.getElementById('save-modal-overlay');

  saveBtn?.addEventListener('click', () => {
    saveModal?.classList.remove('hidden');
    comparisonName?.focus();
  });

  closeSaveBtn?.addEventListener('click', () => saveModal?.classList.add('hidden'));
  cancelSaveBtn?.addEventListener('click', () => saveModal?.classList.add('hidden'));
  saveModalOverlay?.addEventListener('click', () => saveModal?.classList.add('hidden'));

  confirmSaveBtn?.addEventListener('click', () => {
    const name = comparisonName?.value.trim();
    if (!name) return;

    const saved = JSON.parse(localStorage.getItem('savedComparisons') || '[]');
    saved.push({ name, ids: currentIds });
    localStorage.setItem('savedComparisons', JSON.stringify(saved));
    saveModal?.classList.add('hidden');
    comparisonName.value = '';
    renderSavedList();
  });

  renderSavedList();

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tabId = (btn as HTMLElement).dataset.tab;

      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active', 'text-teal-400', 'border-teal-400');
        b.classList.add('text-gray-400', 'border-transparent');
      });
      btn.classList.add('active', 'text-teal-400', 'border-teal-400');
      btn.classList.remove('text-gray-400', 'border-transparent');

      document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.add('hidden');
      });
      document.getElementById(`tab-${tabId}`)?.classList.remove('hidden');
    });
  });

  document.getElementById('clear-all')?.addEventListener('click', () => {
    localStorage.removeItem('compareIds');
    window.location.href = '/';
  });

  document.querySelectorAll('.remove-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const modelId = (btn as HTMLElement).dataset.modelId;
      const ids = JSON.parse(localStorage.getItem('compareIds') || '[]');
      const newIds = ids.filter((id: string) => id !== modelId);
      localStorage.setItem('compareIds', JSON.stringify(newIds));

      const params = new URLSearchParams(window.location.search);
      const currentIds = params.get('ids')?.split(',').map(decodeURIComponent) || [];
      const updatedIds = currentIds.filter((id: string) => id !== modelId);

      if (updatedIds.length === 0) {
        window.location.href = '/';
      } else {
        window.location.href = `/compare?ids=${updatedIds.map(encodeURIComponent).join(',')}`;
      }
    });
  });
</script>

