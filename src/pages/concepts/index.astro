---
import Layout from '../../layouts/Layout.astro';
import { t, pickLocale, type Locale } from '../../lib/i18n';
import conceptsData from '../../../public/data/concepts.json';

const locale: Locale = pickLocale(Astro.currentLocale as string | undefined);
const dict = (key: string) => t(locale, key);

const concepts = (conceptsData as Array<{ slug: string; locale: string; title: string }>)
  .filter((c) => c.locale === locale)
  .sort((a, b) => a.title.localeCompare(b.title));
---
<Layout title={dict('concepts.title')}>
  <section class="max-w-3xl mx-auto px-6 py-10">
    <h1 class="text-3xl font-bold">{dict('concepts.title')}</h1>
    <p class="mt-2 text-sm text-[color:var(--color-muted)]">{dict('concepts.lede')}</p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {concepts.map((c) => (
        <li>
          <a
            href={`/${locale}/concepts/${c.slug}`}
            class="block p-4 rounded-lg border border-[color:var(--color-border)] hover:border-[color:var(--color-accent)] transition-colors"
          >
            <div class="font-medium">{c.title}</div>
            <div class="text-xs text-[color:var(--color-muted)] font-mono mt-1">/concepts/{c.slug}</div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
