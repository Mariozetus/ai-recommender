---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { detectLocale, setLocale, t } from '../../i18n/index';

const { category } = Astro.params;

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = detectLocale(acceptLanguage || undefined);
setLocale(locale);

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const categoryModels = models.filter((m: any) => m.category === category);

if (categoryModels.length === 0) {
  return Astro.redirect('/');
}

const categoryNames: Record<string, string> = {
  chat: t('home.categories.chat'),
  coding: t('home.categories.coding'),
  reasoning: t('home.categories.reasoning'),
  image: t('home.categories.image'),
  embedding: t('home.categories.embedding'),
  multimodal: t('home.categories.multimodal'),
};

const categoryDescs: Record<string, string> = {
  chat: t('home.categories.chat_desc'),
  coding: t('home.categories.coding_desc'),
  reasoning: t('home.categories.reasoning_desc'),
  image: t('home.categories.image_desc'),
  embedding: t('home.categories.embedding_desc'),
  multimodal: t('home.categories.multimodal_desc'),
};

const categoryColors: Record<string, string> = {
  chat: '#1e3a5f',
  coding: '#1a3d1a',
  reasoning: '#3d1a5c',
  image: '#3d1a3d',
  embedding: '#5c3d1a',
  multimodal: '#1a3d3d',
};

const categoryName = categoryNames[category as string] || category;
const categoryDesc = categoryDescs[category as string] || '';

const providers = [...new Set(categoryModels.map((m: any) => m.provider))];
const avgPrice = (categoryModels.reduce((s: number, m: any) => s + m.input_price + m.output_price, 0) / categoryModels.length).toFixed(2);
const bestContext = Math.max(...categoryModels.map((m: any) => m.context_window));
---

<Layout title={`${categoryName} - AI Models`}>
  <div class="bg-gray-900 py-12">
    <div class="max-w-6xl mx-auto px-4">
      <a href="/" class="text-teal-400 hover:text-teal-300 mb-4 inline-block">← {t('catalog.filters.all')} {t('home.categories.title').toLowerCase()}</a>

      <div class="flex items-start gap-6">
        <div
          class="hidden md:block w-20 h-20 rounded-xl flex items-center justify-center text-3xl"
          style={`background-color: ${categoryColors[category as string] || '#374151'}`}
        >
          {category === 'chat' && '💬'}
          {category === 'coding' && '💻'}
          {category === 'reasoning' && '🧠'}
          {category === 'image' && '🎨'}
          {category === 'embedding' && '📊'}
          {category === 'multimodal' && '🔮'}
        </div>
        <div>
          <h1 class="text-4xl font-bold text-white mb-2">{categoryName}</h1>
          <p class="text-gray-400 mb-4">{categoryDesc}</p>
          <div class="flex gap-6 text-sm text-gray-500">
            <span>{categoryModels.length} {t('home.stats.models')}</span>
            <span>{providers.length} {t('home.stats.providers')}</span>
            <span>Avg: ${avgPrice}/1M</span>
            <span>Max: {bestContext.toLocaleString()} tokens</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid md:grid-cols-4 gap-8">
      <aside class="md:col-span-1">
        <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 sticky top-24">
          <h3 class="font-semibold text-white mb-4">{t('catalog.filters.provider')}</h3>
          <div class="space-y-2">
            {providers.slice(0, 10).map(prov => (
              <a
                href={`/provider/${prov}?category=${category}`}
                class="block text-gray-400 hover:text-teal-400 text-sm py-1"
              >
                {prov}
              </a>
            ))}
          </div>
        </div>
      </aside>

      <div class="md:col-span-3">
        <div class="grid gap-4 md:grid-cols-2">
          {categoryModels.slice(0, 24).map((model: any) => (
            <article class="bg-gray-800 rounded-lg p-6 border border-gray-700 transition hover:border-gray-600">
              <div class="flex justify-between items-start mb-3">
                <a href={`/models/${model.provider}/${model.id.split("/")[1] || ""}`} class="hover:text-teal-400">
                  <h3 class="text-lg font-semibold text-white">{model.name}</h3>
                  <p class="text-gray-500 text-sm">{model.provider}</p>
                </a>
              </div>
              <p class="text-gray-400 text-sm mb-4 line-clamp-2">{model.description}</p>
              <div class="grid grid-cols-2 gap-4 text-sm">
                <div>
                  <span class="text-gray-500">{t('catalog.filters.context')}</span>
                  <p class="text-gray-300">{model.context_window.toLocaleString()}</p>
                </div>
                <div>
                  <span class="text-gray-500">{t('catalog.sort.price_low').replace('Price: ', '')}</span>
                  <p class="text-gray-300">${model.input_price + model.output_price}/1M</p>
                </div>
              </div>
              <div class="flex gap-2 mt-4">
                <a
                  href={`/models/${model.provider}/${model.id.split("/")[1] || ""}`}
                  class="bg-teal-600 hover:bg-teal-500 text-white px-4 py-2 rounded text-sm font-medium transition"
                >
                  {t('model.back').replace('← ', '')}
                </a>
                <button
                  class="compare-btn bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded text-sm font-medium transition"
                  data-model-id={model.id}
                >
                  {t('catalog.compare.compare').replace('Compare', 'Add')}
                </button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  let compareIds: string[] = JSON.parse(localStorage.getItem('compareIds') || '[]');

  document.querySelectorAll('.compare-btn').forEach(btn => {
    const id = (btn as HTMLButtonElement).dataset.modelId;
    if (compareIds.includes(id || '')) {
      btn.textContent = 'Added';
      (btn as HTMLButtonElement).disabled = true;
    }
  });

  document.querySelectorAll('.compare-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const modelId = (btn as HTMLButtonElement).dataset.modelId;
      if (!modelId || compareIds.includes(modelId)) return;

      compareIds.push(modelId);
      localStorage.setItem('compareIds', JSON.stringify(compareIds));
      btn.textContent = 'Added';
      (btn as HTMLButtonElement).disabled = true;
    });
  });
</script>
