---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';

const { category } = Astro.params;

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = acceptLanguage?.includes('es') ? 'es' : 'en';
const numberFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US');
const currencyFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US', { style: 'currency', currency: 'USD' });

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const categoryModels = models.filter((m: any) => m.category === category);

if (categoryModels.length === 0) {
  return Astro.redirect('/');
}

const categoryLabels: Record<string, string> = {
  chat: 'Chat',
  coding: 'Código',
  reasoning: 'Razonamiento',
  image: 'Imagen',
  embedding: 'Embedding',
  multimodal: 'Multimodal',
};

const categoryDescriptions: Record<string, string> = {
  chat: 'Modelos para conversación general, preguntas y respuestas.',
  coding: 'Generación y completado de código, debugging.',
  reasoning: 'Modelos optimizados para lógica, matemáticas y problemas complejos.',
  image: 'Generación de imágenes desde texto.',
  embedding: 'Vectores para búsqueda semántica y RAG.',
  multimodal: 'Modelos que aceptan múltiples modalidades de entrada y salida.',
};

const categoryName = categoryLabels[category as string] || category;
const categoryDesc = categoryDescriptions[category as string] || '';

const providers = [...new Set(categoryModels.map((m: any) => m.provider))];
const avgPrice = categoryModels.reduce((s: number, m: any) => s + m.input_price + m.output_price, 0) / categoryModels.length;
const bestContext = Math.max(...categoryModels.map((m: any) => m.context_window));
---

<Layout title={`${categoryName} · Modelos de IA`}>
  <article class="max-w-6xl mx-auto px-6 py-12 md:py-16">
    <nav class="text-[13px] text-[var(--color-ink-3)] mb-10 flex flex-wrap items-center gap-x-2" aria-label="Ruta">
      <a href="/catalog" class="hover:text-[var(--color-ink)] focus-ring">Catálogo</a>
      <span aria-hidden="true">/</span>
      <span class="text-[var(--color-ink-2)]" aria-current="page">{categoryName}</span>
    </nav>

    <header class="mb-12 pb-12 border-b rule">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-3">
        Categoría
      </p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-[-0.02em] text-[var(--color-ink)] mb-4 text-balance">
        {categoryName}
      </h1>
      <p class="text-xl text-[var(--color-ink-2)] mb-6 text-pretty">{categoryDesc}</p>

      <dl class="grid grid-cols-2 md:grid-cols-4 gap-px bg-[var(--color-rule)] mt-8">
        <div class="bg-[var(--color-paper)] p-4">
          <dt class="text-[11px] uppercase tracking-wider text-[var(--color-ink-3)] mb-1">Modelos</dt>
          <dd class="text-xl font-semibold text-[var(--color-ink)] tnum">{numberFmt.format(categoryModels.length)}</dd>
        </div>
        <div class="bg-[var(--color-paper)] p-4">
          <dt class="text-[11px] uppercase tracking-wider text-[var(--color-ink-3)] mb-1">Proveedores</dt>
          <dd class="text-xl font-semibold text-[var(--color-ink)] tnum">{providers.length}</dd>
        </div>
        <div class="bg-[var(--color-paper)] p-4">
          <dt class="text-[11px] uppercase tracking-wider text-[var(--color-ink-3)] mb-1">Precio medio</dt>
          <dd class="text-xl font-semibold text-[var(--color-ink)] tnum">{currencyFmt.format(avgPrice)} / 1M</dd>
        </div>
        <div class="bg-[var(--color-paper)] p-4">
          <dt class="text-[11px] uppercase tracking-wider text-[var(--color-ink-3)] mb-1">Contexto máx.</dt>
          <dd class="text-xl font-semibold text-[var(--color-ink)] tnum">
            {bestContext >= 1_000_000 ? `${(bestContext / 1_000_000).toFixed(1)}M` : `${Math.round(bestContext / 1000)}K`}
          </dd>
        </div>
      </dl>
    </header>

    <section>
      <ul class="divide-y divide-[var(--color-rule)]">
        {categoryModels.slice(0, 50).map((model: any) => (
          <li>
            <article class="grid md:grid-cols-[1fr_180px] gap-4 py-5 hover:bg-[var(--color-paper-2)] transition-colors -mx-3 px-3 rounded-sm">
              <div class="min-w-0">
                <div class="flex items-baseline gap-2 mb-1.5 text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">
                  <span>{model.provider}</span>
                  {model.pricing?.free && (
                    <>
                      <span class="text-[var(--color-ink-4)]">·</span>
                      <span class="text-[var(--color-accent)]">Free</span>
                    </>
                  )}
                </div>
                <h2 class="text-[16px] font-semibold text-[var(--color-ink)] mb-1">
                  <a href={`/models/${model.provider}/${model.id.split("/")[1] || ""}`} class="hover:text-[var(--color-accent)] focus-ring">{model.name}</a>
                </h2>
                <p class="text-[13px] text-[var(--color-ink-2)] line-clamp-2 text-pretty leading-relaxed">{model.description}</p>
              </div>
              <div class="md:text-right md:border-l md:border-[var(--color-rule)] md:pl-4 grid grid-cols-2 md:grid-cols-1 gap-2 text-[12px]">
                <div>
                  <div class="text-[10px] text-[var(--color-ink-3)] uppercase tracking-wider">Contexto</div>
                  <div class="text-[var(--color-ink)] tnum">
                    {model.context_window >= 1_000_000 ? `${(model.context_window / 1_000_000).toFixed(1)}M` : `${Math.round(model.context_window / 1000)}K`}
                  </div>
                </div>
                <div>
                  <div class="text-[10px] text-[var(--color-ink-3)] uppercase tracking-wider">In + Out</div>
                  <div class="text-[var(--color-ink)] tnum">{currencyFmt.format(model.input_price + model.output_price)} / 1M</div>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>

    {providers.length > 0 && (
      <section class="mt-16 pt-10 border-t rule">
        <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-4">
          Proveedores con modelos de {categoryName}
        </p>
        <ul class="flex flex-wrap gap-2">
          {providers.map((prov: string) => (
            <li>
              <a
                href={`/provider/${prov}?category=${category}`}
                class="block border rule text-[var(--color-ink-2)] hover:text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] px-3 py-1.5 rounded-sm text-[13px] transition-colors focus-ring"
              >
                {prov}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Layout>
