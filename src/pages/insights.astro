---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = acceptLanguage?.includes('es') ? 'es' : 'en';
const numberFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US');
const currencyFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US', { style: 'currency', currency: 'USD' });

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const totalModels = models.length;
const providers = [...new Set(models.map((m: any) => m.provider))];
const categories = [...new Set(models.map((m: any) => m.category))];

const priceRanges = {
  free: models.filter((m: any) => m.pricing?.free).length,
  cheap: models.filter((m: any) => m.input_price + m.output_price > 0 && m.input_price + m.output_price < 1).length,
  mid: models.filter((m: any) => m.input_price + m.output_price >= 1 && m.input_price + m.output_price < 10).length,
  expensive: models.filter((m: any) => m.input_price + m.output_price >= 10).length,
};

const contextRanges = {
  below32k: models.filter((m: any) => m.context_window < 32768).length,
  from32k: models.filter((m: any) => m.context_window >= 32768 && m.context_window < 65536).length,
  from64k: models.filter((m: any) => m.context_window >= 65536 && m.context_window < 131072).length,
  from128k: models.filter((m: any) => m.context_window >= 131072 && m.context_window < 200000).length,
  above200k: models.filter((m: any) => m.context_window >= 200000).length,
};

const categoryCounts = categories.map((cat: string) => ({
  name: cat,
  count: models.filter((m: any) => m.category === cat).length,
})).sort((a, b) => b.count - a.count);

const providerCounts = providers.map((prov: string) => ({
  name: prov,
  count: models.filter((m: any) => m.provider === prov).length,
})).sort((a, b) => b.count - a.count).slice(0, 10);

const avgPrice = models.reduce((s: number, m: any) => s + m.input_price + m.output_price, 0) / models.length;
const avgContext = Math.round(models.reduce((s: number, m: any) => s + m.context_window, 0) / models.length);
const maxContext = Math.max(...models.map((m: any) => m.context_window));

const modelsWithBench = models.filter((m: any) => m.benchmark !== null && m.benchmark !== undefined);
const modelsWithHf = models.filter((m: any) => m.hf_likes !== undefined);

const topMmlu = modelsWithBench
  .filter((m: any) => typeof m.benchmark.mmlu === 'number')
  .sort((a: any, b: any) => b.benchmark.mmlu - a.benchmark.mmlu)
  .slice(0, 10);

const topHumaneval = modelsWithBench
  .filter((m: any) => typeof m.benchmark.humaneval === 'number')
  .sort((a: any, b: any) => b.benchmark.humaneval - a.benchmark.humaneval)
  .slice(0, 10);

const topArena = modelsWithBench
  .filter((m: any) => typeof m.benchmark.chatbot_arena_elo === 'number')
  .sort((a: any, b: any) => b.benchmark.chatbot_arena_elo - a.benchmark.chatbot_arena_elo)
  .slice(0, 10);

const topHfLikes = modelsWithHf
  .sort((a: any, b: any) => (b.hf_likes || 0) - (a.hf_likes || 0))
  .slice(0, 10);

const benchmarkStats: Record<string, number> = {};
modelsWithBench.forEach((m: any) => {
  Object.keys(m.benchmark).forEach((k: string) => {
    if (typeof m.benchmark[k] === 'number') {
      benchmarkStats[k] = (benchmarkStats[k] || 0) + 1;
    }
  });
});

const maxCategoryCount = categoryCounts[0]?.count || 1;
const maxProviderCount = providerCounts[0]?.count || 1;
const maxBenchCount = Math.max(...Object.values(benchmarkStats), 1);
---

<Layout title="Insights">
  <div class="border-b rule">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-3">
        Insights
      </p>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-[-0.02em] text-[var(--color-ink)] mb-3 text-balance">
        Mercado de modelos de IA
      </h1>
      <p class="text-[var(--color-ink-2)] max-w-2xl text-pretty">
        Distribución de precios, contexto, benchmarks y popularidad.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-12">

    <section class="mb-16">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
        Resumen
      </p>
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-px bg-[var(--color-rule)]">
        <div class="bg-[var(--color-paper)] p-5">
          <dt class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-1">Modelos</dt>
          <dd class="text-2xl font-semibold tnum text-[var(--color-ink)]">{numberFmt.format(totalModels)}</dd>
        </div>
        <div class="bg-[var(--color-paper)] p-5">
          <dt class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-1">Proveedores</dt>
          <dd class="text-2xl font-semibold tnum text-[var(--color-ink)]">{providers.length}</dd>
        </div>
        <div class="bg-[var(--color-paper)] p-5">
          <dt class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-1">Precio medio</dt>
          <dd class="text-2xl font-semibold tnum text-[var(--color-ink)]">{currencyFmt.format(avgPrice)} <span class="text-[14px] text-[var(--color-ink-3)] font-normal">/ 1M</span></dd>
        </div>
        <div class="bg-[var(--color-paper)] p-5">
          <dt class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] mb-1">Contexto medio</dt>
          <dd class="text-2xl font-semibold tnum text-[var(--color-ink)]">{Math.round(avgContext / 1000)}K</dd>
        </div>
      </dl>
    </section>

    <section class="mb-16">
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
            Por categoría
          </p>
          <ul class="space-y-3">
            {categoryCounts.map(c => (
              <li>
                <div class="flex justify-between text-[13px] mb-1">
                  <span class="text-[var(--color-ink-2)] capitalize">{c.name}</span>
                  <span class="text-[var(--color-ink-3)] tnum">{numberFmt.format(c.count)}</span>
                </div>
                <div class="h-px bg-[var(--color-rule)]">
                  <div class="h-px bg-[var(--color-ink)]" style={`width: ${(c.count / maxCategoryCount) * 100}%`}></div>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
            Top 10 proveedores
          </p>
          <ul class="space-y-3">
            {providerCounts.map(p => (
              <li>
                <div class="flex justify-between text-[13px] mb-1">
                  <span class="text-[var(--color-ink-2)]">{p.name}</span>
                  <span class="text-[var(--color-ink-3)] tnum">{numberFmt.format(p.count)}</span>
                </div>
                <div class="h-px bg-[var(--color-rule)]">
                  <div class="h-px bg-[var(--color-ink)]" style={`width: ${(p.count / maxProviderCount) * 100}%`}></div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="mb-16">
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
            Distribución de precio
          </p>
          <dl class="space-y-3">
            {[
              { label: 'Gratis', value: priceRanges.free, key: 'free' },
              { label: '< $1 / 1M', value: priceRanges.cheap, key: 'cheap' },
              { label: '$1 – $10 / 1M', value: priceRanges.mid, key: 'mid' },
              { label: '> $10 / 1M', value: priceRanges.expensive, key: 'expensive' },
            ].map(r => {
              const pct = (r.value / totalModels) * 100;
              return (
                <div>
                  <div class="flex justify-between text-[13px] mb-1">
                    <dt class="text-[var(--color-ink-2)]">{r.label}</dt>
                    <dd class="text-[var(--color-ink-3)] tnum">{numberFmt.format(r.value)}</dd>
                  </div>
                  <div class="h-px bg-[var(--color-rule)]">
                    <div class="h-px bg-[var(--color-ink)]" style={`width: ${pct}%`}></div>
                  </div>
                </div>
              );
            })}
          </dl>
        </div>

        <div>
          <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
            Ventana de contexto
          </p>
          <dl class="space-y-3">
            {[
              { label: '≤ 32K', value: contextRanges.below32k },
              { label: '32K – 64K', value: contextRanges.from32k },
              { label: '64K – 128K', value: contextRanges.from64k },
              { label: '128K – 200K', value: contextRanges.from128k },
              { label: '≥ 200K', value: contextRanges.above200k },
            ].map(r => {
              const pct = (r.value / totalModels) * 100;
              return (
                <div>
                  <div class="flex justify-between text-[13px] mb-1">
                    <dt class="text-[var(--color-ink-2)]">{r.label}</dt>
                    <dd class="text-[var(--color-ink-3)] tnum">{numberFmt.format(r.value)}</dd>
                  </div>
                  <div class="h-px bg-[var(--color-rule)]">
                    <div class="h-px bg-[var(--color-ink)]" style={`width: ${pct}%`}></div>
                  </div>
                </div>
              );
            })}
          </dl>
          <p class="text-[12px] text-[var(--color-ink-3)] mt-3 tnum">
            Contexto máximo: {maxContext >= 1_000_000 ? `${(maxContext / 1_000_000).toFixed(1)}M` : `${Math.round(maxContext / 1000)}K`}
          </p>
        </div>
      </div>
    </section>

    <section class="mb-16">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
        Rankings
      </p>
      <div class="grid md:grid-cols-3 gap-12">
        {[
          { title: 'MMLU', list: topMmlu, valueKey: 'mmlu', suffix: '%' },
          { title: 'HumanEval', list: topHumaneval, valueKey: 'humaneval', suffix: '%' },
          { title: 'Arena ELO', list: topArena, valueKey: 'chatbot_arena_elo', suffix: '' },
        ].map(section => (
          <div>
            <h3 class="text-[14px] font-medium text-[var(--color-ink)] mb-4">{section.title}</h3>
            <ol class="space-y-2 text-[13px]">
              {section.list.slice(0, 5).map((m: any, i: number) => (
                <li class="flex justify-between items-center gap-2">
                  <a
                    href={`/models/${m.provider}/${m.id.split('/')[1] || ''}`}
                    class="text-[var(--color-ink-2)] hover:text-[var(--color-ink)] focus-ring flex-1 min-w-0 truncate"
                  >
                    {m.name}
                  </a>
                  <span class="text-[var(--color-ink)] tnum whitespace-nowrap">
                    {section.valueKey === 'chatbot_arena_elo'
                      ? numberFmt.format(Math.round(m.benchmark[section.valueKey]))
                      : `${m.benchmark[section.valueKey].toFixed(1)}${section.suffix}`}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>

    <section class="grid md:grid-cols-2 gap-12">
      <div>
        <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
          Cobertura de benchmarks
        </p>
        <ul class="space-y-2 text-[12px]">
          {Object.entries(benchmarkStats).sort((a, b) => b[1] - a[1]).slice(0, 12).map(([key, count]) => {
            const labels: Record<string, string> = {
              mmlu: 'MMLU', mmlu_pro: 'MMLU Pro', humaneval: 'HumanEval',
              math: 'MATH', gpqa: 'GPQA', livecodebench: 'LiveCodeBench',
              chatbot_arena_elo: 'Arena ELO', intelligence_index: 'AA Intelligence',
              coding_index: 'AA Coding', agentic_index: 'AA Agentic',
              mbpp: 'MBPP', hellaswag: 'HellaSwag', truthfulqa: 'TruthfulQA',
            };
            return (
              <li>
                <div class="flex justify-between mb-1">
                  <span class="text-[var(--color-ink-2)]">{labels[key] || key}</span>
                  <span class="text-[var(--color-ink-3)] tnum">{count}</span>
                </div>
                <div class="h-px bg-[var(--color-rule)]">
                  <div class="h-px bg-[var(--color-ink)]" style={`width: ${(count / maxBenchCount) * 100}%`}></div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>

      <div>
        <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
          Top 10 HuggingFace
        </p>
        <ol class="space-y-2 text-[13px]">
          {topHfLikes.slice(0, 10).map((m: any, i: number) => (
            <li class="flex justify-between items-center gap-2">
              <a
                href={`/models/${m.provider}/${m.id.split('/')[1] || ''}`}
                class="text-[var(--color-ink-2)] hover:text-[var(--color-ink)] focus-ring flex-1 min-w-0 truncate"
              >
                {m.name}
              </a>
              <span class="text-[var(--color-ink-3)] tnum whitespace-nowrap">{numberFmt.format(m.hf_likes || 0)}</span>
            </li>
          ))}
        </ol>
        <p class="text-[12px] text-[var(--color-ink-3)] mt-4 tnum">
          {modelsWithHf.length} modelos con datos de HuggingFace · {modelsWithBench.length} con benchmarks
        </p>
      </div>
    </section>

  </div>
</Layout>
