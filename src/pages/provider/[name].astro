---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { detectLocale, setLocale, t } from '../../i18n/index';

const { provider } = Astro.params;

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = detectLocale(acceptLanguage || undefined);
setLocale(locale);

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const providerModels = models.filter((m: any) => m.provider === provider);

if (providerModels.length === 0) {
  return Astro.redirect('/');
}

const categories = [...new Set(providerModels.map((m: any) => m.category))];
const avgPrice = (providerModels.reduce((s: number, m: any) => s + m.input_price + m.output_price, 0) / providerModels.length).toFixed(2);
const bestContext = Math.max(...providerModels.map((m: any) => m.context_window));
const hasFree = providerModels.some((m: any) => m.pricing?.free);

const providerColors: Record<string, string> = {
  openai: '#10a37f',
  anthropic: '#d2bd5e',
  google: '#4285f4',
  meta: '#0668bd',
  'meta-llama': '#0668bd',
  mistralai: '#2d68e1',
  deepseek: '#3b82f6',
  qwen: '#fb6f00',
};

const brandColor = providerColors[provider as string] || '#6b7280';
---

<Layout title={`${provider} - AI Models`}>
  <div class="bg-gray-900 py-12">
    <div class="max-w-6xl mx-auto px-4">
      <a href="/" class="text-teal-400 hover:text-teal-300 mb-4 inline-block">← {t('home.stats.providers')}</a>

      <div class="flex items-center gap-6">
        <div
          class="hidden md:flex w-20 h-20 rounded-xl items-center justify-center text-2xl font-bold text-white"
          style={`background-color: ${brandColor}`}
        >
          {provider?.charAt(0).toUpperCase()}
        </div>
        <div>
          <h1 class="text-4xl font-bold text-white mb-2 capitalize">{provider}</h1>
          <div class="flex gap-6 text-sm text-gray-500">
            <span>{providerModels.length} {t('home.stats.models')}</span>
            <span>{categories.length} {t('home.stats.categories')}</span>
            <span>Avg: ${avgPrice}/1M</span>
            <span>Max: {bestContext.toLocaleString()} tokens</span>
            {hasFree && <span class="text-green-400">Has free tier</span>}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid md:grid-cols-4 gap-8">
      <aside class="md:col-span-1">
        <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 sticky top-24">
          <h3 class="font-semibold text-white mb-4">{t('catalog.filters.category')}</h3>
          <div class="space-y-2">
            {categories.map(cat => (
              <a
                href={`/category/${cat}?provider=${provider}`}
                class="block text-gray-400 hover:text-teal-400 text-sm py-1 capitalize"
              >
                {cat}
              </a>
            ))}
          </div>
        </div>
      </aside>

      <div class="md:col-span-3">
        <div class="grid gap-4 md:grid-cols-2">
          {providerModels.slice(0, 24).map((model: any) => (
            <article class="bg-gray-800 rounded-lg p-6 border border-gray-700 transition hover:border-gray-600">
              <div class="flex justify-between items-start mb-3">
                <a href={`/models/${encodeURIComponent(model.id)}`} class="hover:text-teal-400">
                  <h3 class="text-lg font-semibold text-white">{model.name}</h3>
                  <p class="text-gray-500 text-sm capitalize">{model.category}</p>
                </a>
                {model.pricing?.free && (
                  <span class="px-2 py-1 bg-green-900 text-green-300 text-xs rounded">Free</span>
                )}
              </div>
              <p class="text-gray-400 text-sm mb-4 line-clamp-2">{model.description}</p>
              <div class="grid grid-cols-2 gap-4 text-sm">
                <div>
                  <span class="text-gray-500">{t('catalog.filters.context')}</span>
                  <p class="text-gray-300">{model.context_window.toLocaleString()}</p>
                </div>
                <div>
                  <span class="text-gray-500">{t('catalog.sort.price_low').replace('Price: ', '')}</span>
                  <p class="text-gray-300">${model.input_price + model.output_price}/1M</p>
                </div>
              </div>
              <div class="flex gap-2 mt-4">
                <a
                  href={`/models/${encodeURIComponent(model.id)}`}
                  class="bg-teal-600 hover:bg-teal-500 text-white px-4 py-2 rounded text-sm font-medium transition"
                >
                  {t('model.back').replace('← ', '')}
                </a>
                <button
                  class="compare-btn bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded text-sm font-medium transition"
                  data-model-id={model.id}
                >
                  Add
                </button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  let compareIds: string[] = JSON.parse(localStorage.getItem('compareIds') || '[]');

  document.querySelectorAll('.compare-btn').forEach(btn => {
    const id = (btn as HTMLButtonElement).dataset.modelId;
    if (compareIds.includes(id || '')) {
      btn.textContent = 'Added';
      (btn as HTMLButtonElement).disabled = true;
    }
  });

  document.querySelectorAll('.compare-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const modelId = (btn as HTMLButtonElement).dataset.modelId;
      if (!modelId || compareIds.includes(modelId)) return;

      compareIds.push(modelId);
      localStorage.setItem('compareIds', JSON.stringify(compareIds));
      btn.textContent = 'Added';
      (btn as HTMLButtonElement).disabled = true;
    });
  });
</script>
