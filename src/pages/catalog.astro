---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import FilterBar from '../components/FilterBar.astro';
import SearchInput from '../components/SearchInput.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { detectLocale, setLocale, t } from '../i18n/index';

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = detectLocale(acceptLanguage || undefined);
setLocale(locale);

const numberFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US');
const currencyFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US', { style: 'currency', currency: 'USD' });

const ITEMS_PER_PAGE = 30;

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const url = new URL(Astro.request.url);
const selectedCategory = url.searchParams.get('category') || '';
const selectedProvider = url.searchParams.get('provider') || '';
const maxContext = parseInt(url.searchParams.get('context') || '0');
const maxPrice = parseFloat(url.searchParams.get('price') || '0');
const searchQuery = url.searchParams.get('q') || '';
const sortBy = url.searchParams.get('sort') || 'name';
const freeOnly = url.searchParams.get('free') === '1';
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1'));

let filtered = [...models];

if (selectedCategory) {
  filtered = filtered.filter((m: any) => m.category === selectedCategory);
}
if (selectedProvider) {
  filtered = filtered.filter((m: any) => m.provider === selectedProvider);
}
if (maxContext > 0) {
  filtered = filtered.filter((m: any) => m.context_window <= maxContext);
}
if (maxPrice > 0) {
  filtered = filtered.filter((m: any) => m.input_price <= maxPrice && m.output_price <= maxPrice);
}
if (freeOnly) {
  filtered = filtered.filter((m: any) => m.pricing?.free === true);
}
if (searchQuery) {
  const q = searchQuery.toLowerCase();
  filtered = filtered.filter((m: any) =>
    m.name.toLowerCase().includes(q) ||
    m.provider.toLowerCase().includes(q) ||
    m.description.toLowerCase().includes(q) ||
    m.tags?.some((t: string) => t.toLowerCase().includes(q))
  );
}

switch (sortBy) {
  case 'price-low':
    filtered.sort((a, b) => (a.input_price + a.output_price) - (b.input_price + b.output_price));
    break;
  case 'price-high':
    filtered.sort((a, b) => (b.input_price + b.output_price) - (a.input_price + a.output_price));
    break;
  case 'context':
    filtered.sort((a, b) => b.context_window - a.context_window);
    break;
  case 'name':
  default:
    filtered.sort((a, b) => a.name.localeCompare(b.name));
    break;
}

const totalPages = Math.ceil(filtered.length / ITEMS_PER_PAGE);
const startIndex = (page - 1) * ITEMS_PER_PAGE;
const paginatedModels = filtered.slice(startIndex, startIndex + ITEMS_PER_PAGE);

const categories = [...new Set(models.map((m: any) => m.category))];
const providers = [...new Set(models.map((m: any) => m.provider))];

function buildPageUrl(p: number) {
  const params = new URLSearchParams();
  if (selectedCategory) params.set('category', selectedCategory);
  if (selectedProvider) params.set('provider', selectedProvider);
  if (maxContext > 0) params.set('context', maxContext.toString());
  if (maxPrice > 0) params.set('price', maxPrice.toString());
  if (searchQuery) params.set('q', searchQuery);
  if (sortBy !== 'name') params.set('sort', sortBy);
  if (freeOnly) params.set('free', '1');
  if (p > 1) params.set('page', p.toString());
  return params.toString() ? `/catalog?${params.toString()}` : '/catalog';
}
---

<Layout title="Catálogo">
  <div class="border-b rule">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-3">
        Catálogo
      </p>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-[-0.02em] text-[var(--color-ink)] mb-3 text-balance">
        {numberFmt.format(models.length)} modelos
      </h1>
      <p class="text-[var(--color-ink-2)] max-w-2xl text-pretty">
        Datos de OpenRouter. Filtra por categoría, proveedor, contexto o precio.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-10">

    <div class="mb-8 pb-8 border-b rule">
      <form method="get" action="/catalog">
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="flex-1">
            <SearchInput models={models} initialQuery={searchQuery} />
          </div>
          {searchQuery && (
            <a
              href="/catalog"
              class="border rule text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] px-4 py-2 rounded-sm text-[14px] font-medium transition-colors focus-ring text-center"
            >
              Limpiar búsqueda
            </a>
          )}
        </div>
      </form>
    </div>

    <div class="grid md:grid-cols-[200px_1fr] gap-10">

      <div class="hidden md:block">
        <FilterBar
          categories={categories}
          providers={providers}
          selectedCategory={selectedCategory}
          selectedProvider={selectedProvider}
        />
      </div>

      <div>
        <div id="compare-bar" class="hidden mb-6 border rule bg-[var(--color-paper-2)] p-4 flex items-center justify-between">
          <span id="compare-count" class="text-[14px] text-[var(--color-ink-2)] tnum">0 modelos</span>
          <div class="flex gap-2">
            <a
              id="compare-link"
              href="/compare"
              class="bg-[var(--color-ink)] text-[var(--color-paper)] hover:bg-[var(--color-ink-2)] px-4 py-1.5 rounded-sm text-[13px] font-medium transition-colors focus-ring"
            >
              Comparar
            </a>
            <button
              id="clear-compare"
              type="button"
              class="border rule text-[var(--color-ink)] hover:bg-[var(--color-paper)] px-4 py-1.5 rounded-sm text-[13px] font-medium transition-colors focus-ring"
            >
              Limpiar
            </button>
          </div>
        </div>

        <div class="flex flex-wrap justify-between items-baseline gap-3 mb-6 pb-4 border-b rule">
          <p class="text-[13px] text-[var(--color-ink-3)] tnum">
            {filtered.length === 0 ? 'Sin resultados' : `${startIndex + 1}–${Math.min(startIndex + ITEMS_PER_PAGE, filtered.length)} de ${numberFmt.format(filtered.length)}`}
          </p>
          <form method="get" action="/catalog" class="flex gap-2 items-center">
            <label for="sort-select" class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">Orden</label>
            <select
              id="sort-select"
              name="sort"
              autocomplete="off"
              class="bg-[var(--color-paper-2)] border rule text-[var(--color-ink)] rounded-sm px-2.5 py-1.5 text-[13px] focus-ring focus:border-[var(--color-ink-3)]"
              onchange="this.form.submit()"
            >
              <option value="name" selected={sortBy === 'name'}>Nombre</option>
              <option value="price-low" selected={sortBy === 'price-low'}>Precio: menor</option>
              <option value="price-high" selected={sortBy === 'price-high'}>Precio: mayor</option>
              <option value="context" selected={sortBy === 'context'}>Contexto</option>
            </select>
            {selectedCategory && <input type="hidden" name="category" value={selectedCategory} />}
            {selectedProvider && <input type="hidden" name="provider" value={selectedProvider} />}
            {maxContext > 0 && <input type="hidden" name="context" value={maxContext} />}
            {maxPrice > 0 && <input type="hidden" name="price" value={maxPrice} />}
            {searchQuery && <input type="hidden" name="q" value={searchQuery} />}
            {freeOnly && <input type="hidden" name="free" value="1" />}
            {page > 1 && <input type="hidden" name="page" value={page} />}
          </form>
        </div>

        <div id="results-list">
          {paginatedModels.length === 0 ? (
            <div class="py-16 text-center">
              <p class="text-[var(--color-ink-3)] text-[14px]">
                Ningún modelo coincide con los filtros actuales.
              </p>
              <a
                href="/catalog"
                class="inline-block mt-4 text-[13px] text-[var(--color-ink-2)] underline underline-offset-4 hover:text-[var(--color-ink)] focus-ring"
              >
                Limpiar filtros
              </a>
            </div>
          ) : (
            <ul class="divide-y divide-[var(--color-rule)]">
              {paginatedModels.map((model: any) => {
                const slug = model.id.split('/')[1] || '';
                const detailUrl = `/models/${model.provider}/${slug}`;
                const totalPrice = model.input_price + model.output_price;
                return (
                  <li>
                    <article class="grid md:grid-cols-[1fr_180px] gap-4 py-5 hover:bg-[var(--color-paper-2)] transition-colors -mx-3 px-3 rounded-sm group">
                      <div class="min-w-0">
                        <div class="flex items-baseline gap-2 mb-1.5 text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">
                          <span>{model.category}</span>
                          {model.pricing?.free && (
                            <>
                              <span class="text-[var(--color-ink-4)]">·</span>
                              <span class="text-[var(--color-accent)]">Free</span>
                            </>
                          )}
                          <span class="text-[var(--color-ink-4)]">·</span>
                          <span>{model.provider}</span>
                        </div>
                        <h3 class="text-[16px] font-semibold text-[var(--color-ink)] mb-1.5">
                          <a href={detailUrl} class="hover:text-[var(--color-accent)] focus-ring">{model.name}</a>
                        </h3>
                        <p class="text-[13px] text-[var(--color-ink-2)] line-clamp-2 text-pretty leading-relaxed">{model.description}</p>
                      </div>

                      <div class="md:text-right md:border-l md:border-[var(--color-rule)] md:pl-4 flex md:flex-col gap-4 md:gap-1.5">
                        <div>
                          <div class="text-[11px] uppercase tracking-wider text-[var(--color-ink-3)]">Contexto</div>
                          <div class="text-[14px] text-[var(--color-ink)] tnum">
                            {model.context_window >= 1_000_000
                              ? `${(model.context_window / 1_000_000).toFixed(1)}M`
                              : `${Math.round(model.context_window / 1000)}K`}
                          </div>
                        </div>
                        <div>
                          <div class="text-[11px] uppercase tracking-wider text-[var(--color-ink-3)]">In + Out</div>
                          <div class="text-[14px] text-[var(--color-ink)] tnum">
                            {totalPrice === 0 ? 'Gratis' : `${currencyFmt.format(totalPrice)} / 1M`}
                          </div>
                        </div>
                        <div class="flex md:justify-end gap-2 mt-2">
                          <button
                            type="button"
                            class="compare-btn border rule text-[var(--color-ink)] hover:bg-[var(--color-paper)] px-2.5 py-1 rounded-sm text-[12px] font-medium transition-colors focus-ring"
                            data-model-id={model.id}
                            aria-label={`Añadir ${model.name} a comparación`}
                          >
                            Comparar
                          </button>
                        </div>
                      </div>
                    </article>
                  </li>
                );
              })}
            </ul>
          )}
        </div>

        {totalPages > 1 && (
          <nav class="flex justify-between items-center gap-2 mt-10 pt-6 border-t rule" aria-label="Paginación">
            {page > 1 ? (
              <a
                href={buildPageUrl(page - 1)}
                rel="prev"
                class="text-[13px] text-[var(--color-ink-2)] hover:text-[var(--color-ink)] focus-ring"
              >
                ← Anterior
              </a>
            ) : <span class="text-[13px] text-[var(--color-ink-4)]">← Anterior</span>}

            <p class="text-[12px] tnum text-[var(--color-ink-3)]">
              Página {page} de {totalPages}
            </p>

            {page < totalPages ? (
              <a
                href={buildPageUrl(page + 1)}
                rel="next"
                class="text-[13px] text-[var(--color-ink-2)] hover:text-[var(--color-ink)] focus-ring"
              >
                Siguiente →
              </a>
            ) : <span class="text-[13px] text-[var(--color-ink-4)]">Siguiente →</span>}
          </nav>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  let compareIds: string[] = JSON.parse(localStorage.getItem('compareIds') || '[]');
  const MAX_COMPARE = 4;

  function showToast(message: string, kind: 'success' | 'error' | 'info' | 'warning' = 'info') {
    const fn = (window as any).showToast;
    if (typeof fn === 'function') fn(message, kind);
  }

  const urlParams = new URLSearchParams(window.location.search);
  const freeParam = urlParams.get('free');
  const freeCheckbox = document.getElementById('free-filter') as HTMLInputElement | null;
  if (freeCheckbox && freeParam === '1') {
    freeCheckbox.checked = true;
  }

  function updateCompareBar() {
    const bar = document.getElementById('compare-bar');
    const count = document.getElementById('compare-count');
    const link = document.getElementById('compare-link') as HTMLAnchorElement | null;

    if (compareIds.length > 0) {
      bar?.classList.remove('hidden');
      if (count) count.textContent = `${compareIds.length} ${compareIds.length === 1 ? 'modelo' : 'modelos'}`;
      if (link) link.href = `/compare?ids=${compareIds.join(',')}`;
    } else {
      bar?.classList.add('hidden');
    }

    document.querySelectorAll('.compare-btn').forEach(btn => {
      const id = (btn as HTMLButtonElement).dataset.modelId;
      if (compareIds.includes(id || '')) {
        btn.textContent = 'Añadido';
        btn.setAttribute('disabled', 'true');
      }
    });
  }

  function handleCompareClick(e: Event) {
    const target = e.target as HTMLElement;
    const btn = target.closest('.compare-btn') as HTMLButtonElement | null;
    if (!btn) return;

    const modelId = btn.dataset.modelId;
    if (!modelId || compareIds.includes(modelId)) return;

    if (compareIds.length >= MAX_COMPARE) {
      showToast(`Máximo ${MAX_COMPARE} modelos para comparar`, 'warning');
      return;
    }

    compareIds.push(modelId);
    localStorage.setItem('compareIds', JSON.stringify(compareIds));
    btn.textContent = 'Añadido';
    btn.setAttribute('disabled', 'true');
    showToast('Modelo añadido a comparación', 'success');
    updateCompareBar();
  }

  document.getElementById('clear-compare')?.addEventListener('click', () => {
    compareIds = [];
    localStorage.removeItem('compareIds');
    document.querySelectorAll('.compare-btn').forEach(btn => {
      btn.textContent = 'Comparar';
      btn.removeAttribute('disabled');
    });
    showToast('Comparación limpiada', 'info');
    updateCompareBar();
  });

  document.getElementById('results-list')?.addEventListener('click', handleCompareClick);

  updateCompareBar();
</script>
