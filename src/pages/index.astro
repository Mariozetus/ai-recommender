---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { detectLocale, setLocale, t } from '../i18n/index';

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = detectLocale(acceptLanguage || undefined);
setLocale(locale);

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const categoryCounts = models.reduce((acc: Record<string, number>, m: any) => {
  acc[m.category] = (acc[m.category] || 0) + 1;
  return acc;
}, {});

const categories = [
  { id: 'chat', name: t('home.categories.chat'), desc: t('home.categories.chat_desc') },
  { id: 'coding', name: t('home.categories.coding'), desc: t('home.categories.coding_desc') },
  { id: 'reasoning', name: t('home.categories.reasoning'), desc: t('home.categories.reasoning_desc') },
  { id: 'image', name: t('home.categories.image'), desc: t('home.categories.image_desc') },
  { id: 'embedding', name: t('home.categories.embedding'), desc: t('home.categories.embedding_desc') },
  { id: 'multimodal', name: t('home.categories.multimodal'), desc: t('home.categories.multimodal_desc') },
];
---

<Layout title={t('layout.title')}>
  <Hero locale={locale} />

  <section class="border-b rule">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="mb-12">
        <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-3">
          Categorías
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold tracking-[-0.02em] text-[var(--color-ink)] text-balance">
          Explorar por tipo
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-rule)]">
        {categories.map(cat => (
          <CategoryCard
            category={cat.id}
            name={cat.name}
            description={cat.desc}
            count={categoryCounts[cat.id] || 0}
            locale={locale}
          />
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="mb-12">
        <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-3">
          Reseñas curadas
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold tracking-[-0.02em] text-[var(--color-ink)] text-balance">
          Rankings por necesidad
        </h2>
        <p class="text-[var(--color-ink-2)] mt-3 max-w-xl">
          Listas curadas según el caso de uso, no solo por ranking genérico.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-rule)]">
        <a href="/best/free" class="group bg-[var(--color-paper)] p-6 hover:bg-[var(--color-paper-2)] transition-colors focus-ring">
          <p class="text-[13px] text-[var(--color-ink-3)] mb-1">Top</p>
          <h3 class="font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">Modelos gratuitos</h3>
          <p class="text-sm text-[var(--color-ink-2)] mt-2 text-pretty">Con tier gratuito o totalmente gratis</p>
        </a>
        <a href="/best/cheap" class="group bg-[var(--color-paper)] p-6 hover:bg-[var(--color-paper-2)] transition-colors focus-ring">
          <p class="text-[13px] text-[var(--color-ink-3)] mb-1">Top</p>
          <h3 class="font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">Más baratos</h3>
          <p class="text-sm text-[var(--color-ink-2)] mt-2 text-pretty">Bajo costo, buena calidad</p>
        </a>
        <a href="/best/long-context" class="group bg-[var(--color-paper)] p-6 hover:bg-[var(--color-paper-2)] transition-colors focus-ring">
          <p class="text-[13px] text-[var(--color-ink-3)] mb-1">Top</p>
          <h3 class="font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">Contexto largo</h3>
          <p class="text-sm text-[var(--color-ink-2)] mt-2 text-pretty">200K+ tokens para documentos</p>
        </a>
        <a href="/best/reasoning" class="group bg-[var(--color-paper)] p-6 hover:bg-[var(--color-paper-2)] transition-colors focus-ring">
          <p class="text-[13px] text-[var(--color-ink-3)] mb-1">Top</p>
          <h3 class="font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">Razonamiento</h3>
          <p class="text-sm text-[var(--color-ink-2)] mt-2 text-pretty">Lógica, matemáticas, código</p>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ models: models.slice(0, 50) }}>
  const history = JSON.parse(localStorage.getItem('viewHistory') || '[]');
  const section = document.getElementById('recently-viewed');
  const list = document.getElementById('recently-viewed-list');

  if (history.length > 0 && list && section) {
    const recentModels = history.slice(0, 6).map(id => models.find(m => m && m.id === id)).filter(Boolean);
    if (recentModels.length > 0) {
      section.classList.remove('hidden');
      list.innerHTML = recentModels.map(m => `
        <a href="/models/${m.provider}/${m.id.split("/")[1] || ""}" class="block p-4 hover:bg-[var(--color-paper-2)] transition-colors focus-ring">
          <h3 class="font-medium text-[var(--color-ink)] truncate">${m.name}</h3>
          <p class="text-[13px] text-[var(--color-ink-3)] mt-0.5">${m.provider}</p>
        </a>
      `).join('');
    }
  }
</script>
