---
import Layout from '../../layouts/Layout.astro';
import { t, pickLocale, path, type Locale } from '../../lib/i18n';
import { monthlyCostUsd, costLabel } from '../../lib/cost';
import { models as allModels, providers as allProviders, benchmarks as allBenchmarks } from '../../lib/data';

const locale: Locale = pickLocale(Astro.currentLocale as string | undefined);
const dict = (key: string) => t(locale, key);

interface ModelRow {
  id: string; name: string; family: string | null; license: string | null;
  context_window: number | null; max_output: number | null;
  flags: Record<string, number>;
  benchmark_scores: Record<string, number>;
  offerings: Array<{ provider_id: string; provider_name: string; provider_type: string; region: string; input_cost: number | null; output_cost: number | null; cache_read: number | null; context_window: number | null }>;
}
interface Provider { id: string; name: string; type: string }
interface LicenseCount { license: string; count: number }

const u = Astro.url;
const sp = u.searchParams;
const q = sp.get('q')?.toLowerCase() ?? '';
const providerId = sp.get('provider') ?? '';
const license = sp.get('license') ?? '';
const capFc = sp.get('cap_fc') === '1';
const capReasoning = sp.get('cap_reasoning') === '1';
const capVision = sp.get('cap_vision') === '1';
const capLongCtx = sp.get('cap_longctx') === '1';
const capOpen = sp.get('cap_open') === '1';
const minCtx = sp.get('min_ctx') ? Number(sp.get('min_ctx')) : 0;
const maxIn = sp.get('max_in') ? Number(sp.get('max_in')) : Infinity;
const page = sp.get('page') ? Number(sp.get('page')) : 1;
const pageSize = 50;

function matchesFilters(m: ModelRow, offering: ModelRow['offerings'][number]): boolean {
  if (providerId && offering.provider_id !== providerId) return false;
  if (license && m.license !== license) return false;
  if (capFc && !m.flags.cap_function_calling) return false;
  if (capReasoning && !m.flags.cap_reasoning) return false;
  if (capVision && !m.flags.mod_image_in) return false;
  if (capLongCtx && (m.context_window ?? 0) < 100000) return false;
  if (minCtx && (m.context_window ?? 0) < minCtx) return false;
  if (maxIn !== Infinity && offering.input_cost != null && offering.input_cost > maxIn) return false;
  if (capOpen && !/apache|mit|open|community|llama|mrl|deepseek/i.test(m.license ?? '')) return false;
  if (q && !(`${m.name} ${m.id} ${m.family ?? ''}`.toLowerCase().includes(q))) return false;
  return true;
}

interface FlatRow {
  model_id: string; model_name: string; model_family: string | null; model_license: string | null;
  flags: Record<string, number>;
  context_window: number | null;
  provider_id: string; provider_name: string; provider_type: string; region: string;
  input_cost: number | null; output_cost: number | null; cache_read: number | null;
  benchmark_scores: Record<string, number>;
}

const flatRows: FlatRow[] = [];
for (const m of allModels as unknown as ModelRow[]) {
  for (const o of m.offerings ?? []) {
    if (!matchesFilters(m, o)) continue;
    flatRows.push({
      model_id: m.id, model_name: m.name, model_family: m.family, model_license: m.license,
      flags: m.flags, context_window: m.context_window ?? o.context_window,
      provider_id: o.provider_id, provider_name: o.provider_name, provider_type: o.provider_type, region: o.region,
      input_cost: o.input_cost, output_cost: o.output_cost, cache_read: o.cache_read,
      benchmark_scores: m.benchmark_scores,
    });
  }
}
flatRows.sort((a, b) => a.model_name.localeCompare(b.model_name) || a.provider_name.localeCompare(b.provider_name));
const total = flatRows.length;
const pageCount = Math.ceil(total / pageSize);
const rows = flatRows.slice((page - 1) * pageSize, page * pageSize);

const topProviders = (allProviders as unknown as Provider[]).slice(0, 30);
const licenseCounts = new Map<string, number>();
for (const m of allModels as unknown as ModelRow[]) {
  if (!m.license) continue;
  licenseCounts.set(m.license, (licenseCounts.get(m.license) ?? 0) + 1);
}
const topLicenses: LicenseCount[] = Array.from(licenseCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12)
  .map(([license, count]) => ({ license, count }));

function isChecked(key: string): boolean { return sp.get(key) === '1'; }
---
<Layout title={dict('catalog.title')}>
  <section class="max-w-7xl mx-auto px-6 py-10">
    <h1 class="text-3xl font-bold">{dict('catalog.title')}</h1>
    <p class="mt-2 text-sm text-[color:var(--color-muted)]">{dict('catalog.lede')}</p>
    <p class="mt-1 text-xs text-[color:var(--color-muted)]">
      {total} {dict('catalog.results')} · {dict('catalog.budget_assumption')}
    </p>

    <div class="mt-8 grid gap-6 lg:grid-cols-[240px_1fr]">
      <aside>
        <form method="get" class="rounded-lg border border-[color:var(--color-border)] p-4 space-y-4 sticky top-4">
          <label class="block">
            <span class="text-xs font-medium">{dict('catalog.filter.search')}</span>
            <input name="q" value={q} class="mt-1 w-full px-2 py-1.5 rounded border border-[color:var(--color-border)] bg-transparent text-sm" />
          </label>

          <label class="block">
            <span class="text-xs font-medium">{dict('catalog.filter.provider')}</span>
            <select name="provider" class="mt-1 w-full px-2 py-1.5 rounded border border-[color:var(--color-border)] bg-transparent text-sm">
              <option value="">{dict('catalog.filter.any')}</option>
              {topProviders.map((p) => (
                <option value={p.id} selected={providerId === p.id}>{p.name}</option>
              ))}
            </select>
          </label>

          <label class="block">
            <span class="text-xs font-medium">{dict('catalog.filter.license')}</span>
            <select name="license" class="mt-1 w-full px-2 py-1.5 rounded border border-[color:var(--color-border)] bg-transparent text-sm">
              <option value="">{dict('catalog.filter.any')}</option>
              {topLicenses.map((l) => (
                <option value={l.license} selected={license === l.license}>{l.license} ({l.count})</option>
              ))}
            </select>
          </label>

          <fieldset class="block">
            <legend class="text-xs font-medium">{dict('catalog.filter.caps')}</legend>
            <div class="mt-1 space-y-1 text-sm">
              <label class="flex items-center gap-2">
                <input type="checkbox" name="cap_fc" value="1" checked={isChecked('cap_fc')} />
                <span>{dict('catalog.filter.caps.function_calling')}</span>
              </label>
              <label class="flex items-center gap-2">
                <input type="checkbox" name="cap_reasoning" value="1" checked={isChecked('cap_reasoning')} />
                <span>{dict('catalog.filter.caps.reasoning')}</span>
              </label>
              <label class="flex items-center gap-2">
                <input type="checkbox" name="cap_vision" value="1" checked={isChecked('cap_vision')} />
                <span>{dict('catalog.filter.caps.vision')}</span>
              </label>
              <label class="flex items-center gap-2">
                <input type="checkbox" name="cap_longctx" value="1" checked={isChecked('cap_longctx')} />
                <span>{dict('catalog.filter.caps.long_context')}</span>
              </label>
              <label class="flex items-center gap-2">
                <input type="checkbox" name="cap_open" value="1" checked={isChecked('cap_open')} />
                <span>{dict('catalog.filter.caps.open_source')}</span>
              </label>
            </div>
          </fieldset>

          <label class="block">
            <span class="text-xs font-medium">{dict('catalog.filter.caps.max_price')}</span>
            <input type="number" name="max_in" step="0.1" min="0" value={sp.get('max_in') ?? ''} class="mt-1 w-full px-2 py-1.5 rounded border border-[color:var(--color-border)] bg-transparent text-sm" />
          </label>

          <label class="block">
            <span class="text-xs font-medium">{dict('catalog.filter.caps.min_context')}</span>
            <input type="number" name="min_ctx" step="1000" min="0" value={sp.get('min_ctx') ?? ''} class="mt-1 w-full px-2 py-1.5 rounded border border-[color:var(--color-border)] bg-transparent text-sm" />
          </label>

          <div class="flex gap-2">
            <button type="submit" class="flex-1 px-3 py-1.5 rounded text-sm font-medium" style="background: var(--color-accent); color: var(--color-surface);">
              {dict('catalog.filter.apply')}
            </button>
            <a href={path(locale, '/catalog')} class="px-3 py-1.5 rounded text-sm border border-[color:var(--color-border)]">
              {dict('catalog.filter.reset')}
            </a>
          </div>
        </form>
      </aside>

      <div>
        <div class="rounded-lg border border-[color:var(--color-border)] overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-left bg-[color:var(--color-surface)]">
              <tr>
                <th class="px-3 py-2 font-medium">{dict('catalog.col.model')}</th>
                <th class="px-3 py-2 font-medium">{dict('catalog.col.provider')}</th>
                <th class="px-3 py-2 font-medium text-right">{dict('catalog.col.cost_in')}</th>
                <th class="px-3 py-2 font-medium text-right">{dict('catalog.col.cost_out')}</th>
                <th class="px-3 py-2 font-medium text-right">{dict('catalog.col.monthly')}</th>
                <th class="px-3 py-2 font-medium text-right">{dict('catalog.col.context')}</th>
                <th class="px-3 py-2 font-medium">{dict('catalog.col.license')}</th>
                <th class="px-3 py-2 font-medium">{dict('catalog.col.caps')}</th>
              </tr>
            </thead>
            <tbody>
              {rows.length === 0 && (
                <tr><td colspan="8" class="px-3 py-6 text-center text-[color:var(--color-muted)]">{dict('catalog.empty')}</td></tr>
              )}
              {rows.map((r) => {
                const monthly = monthlyCostUsd(r.input_cost, r.output_cost, 'middle');
                return (
                  <tr class="border-t border-[color:var(--color-border)]">
                    <td class="px-3 py-2">
                      <div class="font-medium">{r.model_name}</div>
                      <div class="text-xs text-[color:var(--color-muted)] font-mono">{r.model_id}</div>
                    </td>
                    <td class="px-3 py-2">
                      <div>{r.provider_name}</div>
                      <div class="text-xs text-[color:var(--color-muted)]">{r.provider_type} · {r.region}</div>
                    </td>
                    <td class="px-3 py-2 text-right font-mono text-xs">{r.input_cost != null ? `$${r.input_cost.toFixed(2)}` : '—'}</td>
                    <td class="px-3 py-2 text-right font-mono text-xs">{r.output_cost != null ? `$${r.output_cost.toFixed(2)}` : '—'}</td>
                    <td class="px-3 py-2 text-right font-mono text-xs">{costLabel(monthly)}</td>
                    <td class="px-3 py-2 text-right font-mono text-xs">{r.context_window ? `${(r.context_window / 1000).toFixed(0)}k` : '—'}</td>
                    <td class="px-3 py-2 text-xs">{r.model_license ?? '—'}</td>
                    <td class="px-3 py-2 text-xs">
                      {r.flags.cap_function_calling ? '🔧 ' : ''}
                      {r.flags.cap_reasoning ? '🧠 ' : ''}
                      {r.flags.mod_image_in ? '👁 ' : ''}
                      {r.flags.cap_long_horizon ? '📏 ' : ''}
                      {r.flags.mod_embedding ? '🔢' : ''}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        {pageCount > 1 && (
          <div class="mt-4 flex items-center justify-between text-sm">
            <span class="text-[color:var(--color-muted)]">{dict('catalog.pagination.page')} {page} {dict('catalog.pagination.of')} {pageCount}</span>
            <div class="flex gap-2">
              {page > 1 && <a href={path(locale, `/catalog?${(() => { const np = new URLSearchParams(u.searchParams); np.set('page', String(page - 1)); return np.toString(); })()}`)} class="px-3 py-1.5 rounded border border-[color:var(--color-border)]">{dict('catalog.pagination.prev')}</a>}
              {page < pageCount && <a href={path(locale, `/catalog?${(() => { const np = new URLSearchParams(u.searchParams); np.set('page', String(page + 1)); return np.toString(); })()}`)} class="px-3 py-1.5 rounded border border-[color:var(--color-border)]">{dict('catalog.pagination.next')}</a>}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
