---
import Layout from '../../layouts/Layout.astro';
import { t, pickLocale, type Locale } from '../../lib/i18n';
import healthData from '../../../public/api/health.json';
import snapshotsData from '../../../public/data/snapshots.json';

const locale: Locale = pickLocale(Astro.currentLocale as string | undefined);
const dict = (key: string) => t(locale, key);

const health = healthData as {
  status: string;
  db: boolean;
  totals: { models: number; benchmarks: number; active_offerings: number };
  sources: Record<string, { last_success: string | null; last_status: string | null; lag_hours: number | null }>;
};
const snapshots = snapshotsData as Array<{ id: string; taken_at: string; source: string; status: string }>;
---
<Layout title={dict('status.title')}>
  <section class="max-w-5xl mx-auto px-6 py-10">
    <h1 class="text-3xl font-bold">{dict('status.title')}</h1>
    <p class="mt-2 text-sm text-[color:var(--color-muted)]">{dict('status.lede')}</p>
    <p class="mt-1 text-xs text-[color:var(--color-muted)]">
      {health.sources.modelsdev?.last_status === 'succeeded' ? `${health.sources.modelsdev.last_success} · ${health.totals.models} modelos` : 'Sin snapshot aplicada aún'}
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-4">
      <div class="rounded-lg border border-[color:var(--color-border)] p-4">
        <div class="text-sm text-[color:var(--color-muted)]">{dict('status.model_count')}</div>
        <div class="mt-1 text-2xl font-semibold">{health.totals.models}</div>
      </div>
      <div class="rounded-lg border border-[color:var(--color-border)] p-4">
        <div class="text-sm text-[color:var(--color-muted)]">{dict('status.benchmark_count')}</div>
        <div class="mt-1 text-2xl font-semibold">{health.totals.benchmarks}</div>
      </div>
      <div class="rounded-lg border border-[color:var(--color-border)] p-4">
        <div class="text-sm text-[color:var(--color-muted)]">Providers</div>
        <div class="mt-1 text-2xl font-semibold">{Object.keys(health.sources).length}</div>
      </div>
      <div class="rounded-lg border border-[color:var(--color-border)] p-4">
        <div class="text-sm text-[color:var(--color-muted)]">Offerings</div>
        <div class="mt-1 text-2xl font-semibold">{health.totals.active_offerings}</div>
      </div>
    </div>

    <h2 class="mt-12 text-xl font-semibold">Recent sync runs</h2>
    <div class="mt-4 rounded-lg border border-[color:var(--color-border)] overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-[color:var(--color-surface)] text-left">
          <tr>
            <th class="px-4 py-2 font-medium">{dict('status.source.label')}</th>
            <th class="px-4 py-2 font-medium">{dict('status.source.status')}</th>
            <th class="px-4 py-2 font-medium">Started</th>
            <th class="px-4 py-2 font-medium">Snapshot</th>
          </tr>
        </thead>
        <tbody>
          {snapshots.length === 0 && (
            <tr><td class="px-4 py-3 text-[color:var(--color-muted)]" colspan="4">No sync runs yet.</td></tr>
          )}
          {snapshots.map((s) => (
            <tr class="border-t border-[color:var(--color-border)]">
              <td class="px-4 py-2 font-mono text-xs">{s.source}</td>
              <td class="px-4 py-2">{s.status}</td>
              <td class="px-4 py-2 font-mono text-xs">{s.taken_at}</td>
              <td class="px-4 py-2 font-mono text-xs">{s.id}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>
