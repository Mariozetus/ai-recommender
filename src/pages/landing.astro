---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { detectLocale, setLocale, t } from '../i18n/index';

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = detectLocale(acceptLanguage || undefined);
setLocale(locale);

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const categoryCounts = models.reduce((acc: Record<string, number>, m: any) => {
  acc[m.category] = (acc[m.category] || 0) + 1;
  return acc;
}, {});

const categories = [
  { id: 'chat', name: t('home.categories.chat'), desc: t('home.categories.chat_desc') },
  { id: 'coding', name: t('home.categories.coding'), desc: t('home.categories.coding_desc') },
  { id: 'reasoning', name: t('home.categories.reasoning'), desc: t('home.categories.reasoning_desc') },
  { id: 'image', name: t('home.categories.image'), desc: t('home.categories.image_desc') },
  { id: 'embedding', name: t('home.categories.embedding'), desc: t('home.categories.embedding_desc') },
  { id: 'multimodal', name: t('home.categories.multimodal'), desc: t('home.categories.multimodal_desc') },
];
---

<Layout title={t('layout.title')}>
  <Hero locale={locale} />

  <section id="recently-viewed" class="max-w-6xl mx-auto px-4 py-8 hidden">
    <h2 class="text-xl font-bold text-white mb-4">Recently Viewed</h2>
    <div id="recently-viewed-list" class="flex gap-4 overflow-x-auto pb-4">
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold text-white mb-8 text-center">
      {t('home.categories.title')}
    </h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {categories.map(cat => (
        <CategoryCard
          category={cat.id}
          name={cat.name}
          description={cat.desc}
          count={categoryCounts[cat.id] || 0}
          locale={locale}
        />
      ))}
    </div>
  </section>

  <section class="bg-gray-900/50 py-16">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">Ready to find your model?</h2>
      <p class="text-gray-400 mb-8">Answer a few questions and get personalized recommendations</p>
      <a
        href="/recommend"
        class="inline-flex items-center justify-center bg-teal-600 hover:bg-teal-500 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all hover:scale-105"
      >
        Get Personalized Recommendations
      </a>
    </div>
  </section>
</Layout>

<script define:vars={{ models: models.slice(0, 50) }}>
  const history = JSON.parse(localStorage.getItem('viewHistory') || '[]');
  const section = document.getElementById('recently-viewed');
  const list = document.getElementById('recently-viewed-list');

  if (history.length > 0 && list && section) {
    const recentModels = history.slice(0, 6).map(id => models.find(m => m && m.id === id)).filter(Boolean);

    if (recentModels.length > 0) {
      section.classList.remove('hidden');
      list.innerHTML = recentModels.map(m => `
        <a href="/models/${encodeURIComponent(m.id)}" class="flex-shrink-0 w-48 bg-gray-800 rounded-lg p-4 border border-gray-700 hover:border-gray-600 transition">
          <h3 class="font-semibold text-white truncate">${m.name}</h3>
          <p class="text-gray-500 text-sm">${m.provider}</p>
          <p class="text-gray-400 text-xs mt-2">$${m.input_price + m.output_price}/1M</p>
        </a>
      `).join('');
    }
  }
</script>
