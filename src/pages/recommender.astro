---
import Layout from '../layouts/Layout.astro';
import { t, pickLocale, path, type Locale } from '../lib/i18n';
import { parseQuizFromUrl, recommend, type UseCase, type QuizState, type Candidate, type Deployment, type LanguagePref } from '../lib/recommender';
import type { BudgetBin } from '../lib/cost';
import { models as allModels } from '../lib/data';

const locale: Locale = pickLocale(Astro.currentLocale as string | undefined);
const dict = (key: string) => t(locale, key);

const u = Astro.url;
const sp = u.searchParams;
const quiz: QuizState = {
  useCase: (sp.get('use') as UseCase) || 'chat-general',
  deployment: (sp.get('deploy') as Deployment) || 'any',
  budget: (sp.get('budget') as BudgetBin) || 'middle',
  language: (sp.get('lang') as LanguagePref) || 'multi',
  qualityWeight: Math.max(0, Math.min(1, Number(sp.get('qw') ?? '0.5'))),
  minContext: sp.get('min_ctx') ? Number(sp.get('min_ctx')) : undefined,
  requiresFunctionCalling: sp.get('req_fc') === '1',
  requiresReasoning: sp.get('req_reasoning') === '1',
  openSourceOnly: sp.get('open') === '1',
};
const hasQuiz = sp.toString().length > 0;

const candidates: Candidate[] = [];
for (const m of allModels as unknown as RawModel[]) {
  for (const o of m.offerings) {
    candidates.push({
      model_id: m.id,
      model_name: m.name,
      family: m.family,
      license: m.license,
      provider_id: o.provider_id,
      provider_name: o.provider_name,
      provider_type: o.provider_type,
      region: o.region,
      input_cost: o.input_cost,
      output_cost: o.output_cost,
      cache_read: o.cache_read,
      context_window: o.context_window ?? m.context_window,
      flags: m.flags as unknown as Candidate['flags'],
      benchmark_scores: m.benchmark_scores,
    });
  }
}

const recommendations = hasQuiz ? recommend(quiz, candidates) : [];

const useCases: UseCase[] = ['chat-general', 'coding', 'agent', 'vision', 'embedding', 'long-context-rag'];
const shareUrl = u.toString();
---
<Layout title={dict('rec.title')}>
  <section class="max-w-5xl mx-auto px-6 py-10">
    <h1 class="text-3xl font-bold">{dict('rec.title')}</h1>
    <p class="mt-2 text-sm text-[color:var(--color-muted)]">{dict('rec.lede')}</p>

    <form method="get" action={path(locale, '/recommender')} class="mt-8 space-y-8">
      <fieldset>
        <legend class="text-lg font-semibold">{dict('rec.step1.title')}</legend>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {useCases.map((uc) => (
            <label class={`flex items-start gap-3 p-3 rounded-lg border cursor-pointer ${quiz.useCase === uc ? 'border-[color:var(--color-accent)] bg-[color:var(--color-surface)]' : 'border-[color:var(--color-border)]'}`}>
              <input type="radio" name="use" value={uc} checked={quiz.useCase === uc} class="mt-1" />
              <span class="text-sm font-medium">{dict(`rec.step1.usecase.${uc}`)}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-lg font-semibold">{dict('rec.step2.title')}</legend>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
          {(['cloud-api','self-hosted-gpu','self-hosted-cpu','any'] as const).map((d) => (
            <label class={`flex items-center gap-2 p-3 rounded-lg border cursor-pointer text-sm ${quiz.deployment === d ? 'border-[color:var(--color-accent)]' : 'border-[color:var(--color-border)]'}`}>
              <input type="radio" name="deploy" value={d} checked={quiz.deployment === d} />
              <span>{dict(`rec.step2.deploy.${d}`)}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-lg font-semibold">{dict('rec.step3.title')}</legend>
        <div class="mt-3 grid gap-2 sm:grid-cols-3 lg:grid-cols-5">
          {(['free','low','middle','premium','no-limit'] as const).map((b) => (
            <label class={`flex items-center gap-2 p-3 rounded-lg border cursor-pointer text-sm ${quiz.budget === b ? 'border-[color:var(--color-accent)]' : 'border-[color:var(--color-border)]'}`}>
              <input type="radio" name="budget" value={b} checked={quiz.budget === b} />
              <span>{dict(`rec.step3.budget.${b}`)}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-lg font-semibold">{dict('rec.step4.title')}</legend>
        <p class="mt-1 text-xs text-[color:var(--color-muted)]">{dict('rec.step4.lede')}</p>
        <div class="mt-3 flex items-center gap-3">
          <span class="text-sm">💰</span>
          <input type="range" name="qw" min="0" max="1" step="0.05" value={quiz.qualityWeight} class="flex-1" />
          <span class="text-sm">⭐</span>
          <span class="font-mono text-xs w-12 text-right">{quiz.qualityWeight.toFixed(2)}</span>
        </div>
      </fieldset>

      <details class="rounded-lg border border-[color:var(--color-border)] p-4">
        <summary class="cursor-pointer text-sm font-medium">{dict('rec.advanced.title')}</summary>
        <div class="mt-3 space-y-3 text-sm">
          <label class="flex items-center gap-2">
            <input type="checkbox" name="open" value="1" checked={quiz.openSourceOnly} />
            <span>{dict('rec.advanced.open')}</span>
          </label>
          <label class="flex items-center gap-2">
            <input type="checkbox" name="req_fc" value="1" checked={quiz.requiresFunctionCalling} />
            <span>{dict('rec.advanced.req_fc')}</span>
          </label>
          <label class="flex items-center gap-2">
            <input type="checkbox" name="req_reasoning" value="1" checked={quiz.requiresReasoning} />
            <span>{dict('rec.advanced.req_reasoning')}</span>
          </label>
          <label class="block">
            <span class="text-xs">{dict('rec.advanced.min_ctx')}</span>
            <input type="number" name="min_ctx" min="0" step="1000" value={quiz.minContext ?? ''} class="mt-1 w-full px-2 py-1.5 rounded border border-[color:var(--color-border)] bg-transparent" />
          </label>
        </div>
      </details>

      <div class="flex items-center gap-3">
        <button type="submit" class="px-5 py-2.5 rounded-lg font-medium" style="background: var(--color-accent); color: var(--color-surface);">
          {dict('rec.submit')}
        </button>
        <a href={path(locale, '/recommender')} class="text-sm text-[color:var(--color-muted)]">Reset</a>
      </div>
    </form>

    {hasQuiz && (
      <section class="mt-12">
        <div class="flex items-center justify-between">
          <h2 class="text-2xl font-semibold">{dict('rec.results.title')}</h2>
          <button
            class="text-xs px-2 py-1 rounded border border-[color:var(--color-border)]"
            onclick={`navigator.clipboard.writeText('${shareUrl}')`}
            type="button">
            {dict('rec.share')}
          </button>
        </div>

        {recommendations.length === 0 && (
          <p class="mt-6 text-[color:var(--color-muted)]">{dict('rec.results.empty')}</p>
        )}

        <ol class="mt-6 space-y-4">
          {recommendations.map((r) => (
            <li class="rounded-lg border border-[color:var(--color-border)] p-4">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono text-[color:var(--color-muted)]">#{r.rank}</span>
                    <h3 class="text-lg font-semibold">{r.model_name}</h3>
                    <span class={`text-xs px-2 py-0.5 rounded ${
                      r.confidence === 'high' ? 'bg-[color:var(--color-success)]/20' :
                      r.confidence === 'medium' ? 'bg-[color:var(--color-warning)]/20' :
                      'bg-[color:var(--color-muted)]/20'
                    }`}>
                      {r.confidence}
                    </span>
                  </div>
                  <div class="mt-1 text-xs text-[color:var(--color-muted)] font-mono">
                    {r.model_id} · via {r.provider_name} ({r.region})
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-semibold tabular-nums">{(r.total * 100).toFixed(0)}<span class="text-xs">/100</span></div>
                  <div class="text-xs text-[color:var(--color-muted)]">
                    {r.offering.monthly_usd != null ? `≈ $${r.offering.monthly_usd.toFixed(2)}/mes` : '—'}
                  </div>
                </div>
              </div>

              <details class="mt-3">
                <summary class="text-xs text-[color:var(--color-muted)] cursor-pointer">{dict('rec.results.breakdown')}</summary>
                <div class="mt-2 grid grid-cols-5 gap-2 text-xs">
                  <div class="text-center">
                    <div class="font-mono">{r.breakdown.calidad.toFixed(2)}</div>
                    <div class="text-[color:var(--color-muted)]">{dict('rec.results.calidad')}</div>
                  </div>
                  <div class="text-center">
                    <div class="font-mono">{r.breakdown.costo.toFixed(2)}</div>
                    <div class="text-[color:var(--color-muted)]">{dict('rec.results.costo')}</div>
                  </div>
                  <div class="text-center">
                    <div class="font-mono">{r.breakdown.capabilities.toFixed(2)}</div>
                    <div class="text-[color:var(--color-muted)]">{dict('rec.results.capabilities')}</div>
                  </div>
                  <div class="text-center">
                    <div class="font-mono">{r.breakdown.despliegue.toFixed(2)}</div>
                    <div class="text-[color:var(--color-muted)]">{dict('rec.results.despliegue')}</div>
                  </div>
                  <div class="text-center">
                    <div class="font-mono">{r.breakdown.idioma.toFixed(2)}</div>
                    <div class="text-[color:var(--color-muted)]">{dict('rec.results.idioma')}</div>
                  </div>
                </div>
              </details>

              <ul class="mt-3 space-y-1 text-sm">
                {r.notes.map((n) => <li>{n}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </section>
    )}
  </section>
</Layout>
