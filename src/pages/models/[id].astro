---
import Layout from '../../layouts/Layout.astro';
import { t, pickLocale, path, type Locale } from '../../lib/i18n';

import { models as allModels } from '../../lib/data';

export function getStaticPaths() {
  const models = allModels as unknown as Array<{
    id: string; name: string; family: string | null; license: string | null;
    parameter_count: string | null; context_window: number | null; max_output: number | null;
    release_date: string | null; flags: Record<string, number>; benchmark_scores: Record<string, number>;
    offerings: Array<{
      provider_id: string; provider_name: string; provider_type: string; region: string;
      input_cost: number | null; output_cost: number | null;
      cache_read: number | null; context_window: number | null;
    }>;
  }>;
  return models.map((m) => ({ params: { id: encodeURIComponent(m.id) } }));
}

const locale: Locale = pickLocale(Astro.currentLocale as string | undefined);
const dict = (key: string) => t(locale, key);
const modelId = decodeURIComponent(Astro.params.id as string);

const raw = (allModels as unknown as Array<{
  id: string; name: string; family: string | null; license: string | null;
  parameter_count: string | null; context_window: number | null; max_output: number | null;
  release_date: string | null; flags: Record<string, number>; benchmark_scores: Record<string, number>;
  offerings: Array<{
    provider_id: string; provider_name: string; provider_type: string; region: string;
    input_cost: number | null; output_cost: number | null;
    cache_read: number | null; context_window: number | null;
  }>;
}>).find((m) => m.id === modelId);

const CAP_LABELS: Record<string, string> = {
  mod_text_in: 'Text input', mod_text_out: 'Text output',
  mod_image_in: 'Image input', mod_image_out: 'Image output',
  mod_audio_in: 'Audio input', mod_audio_out: 'Audio output',
  mod_embedding: 'Embeddings',
  cap_function_calling: 'Function calling', cap_json_mode: 'JSON mode',
  cap_system_messages: 'System messages', cap_prompt_caching: 'Prompt caching',
  cap_reasoning: 'Reasoning', cap_tool_browse: 'Web browsing',
  cap_tool_code_exec: 'Code execution', cap_tool_file_search: 'File search',
  cap_long_horizon: 'Long context',
};

const CAP_ICONS: Record<string, string> = {
  mod_text_in: '📝', mod_text_out: '📝', mod_audio_in: '🎙', mod_audio_out: '🔊',
  mod_image_in: '🖼', mod_image_out: '🖼', mod_embedding: '🔢',
  cap_function_calling: '🔧', cap_json_mode: '{ }', cap_system_messages: '💬',
  cap_prompt_caching: '⚡', cap_reasoning: '🧠', cap_tool_browse: '🌐',
  cap_tool_code_exec: '💻', cap_tool_file_search: '📁', cap_long_horizon: '📏',
};

function flagList(flags: Record<string, number>): Array<{ label: string; icon: string }> {
  return Object.entries(flags)
    .filter(([, v]) => v === 1)
    .map(([k]) => ({ label: CAP_LABELS[k] ?? k, icon: CAP_ICONS[k] ?? '•' }));
}

function paramLabel(pc: string | null): string {
  if (!pc) return '—';
  const n = Number(pc);
  if (isNaN(n)) return pc;
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}T`;
  if (n >= 1_000) return `${(n / 1000).toFixed(0)}B`;
  return pc;
}
---

<Layout title={raw?.name ?? modelId}>
  <main class="max-w-4xl mx-auto px-6 py-10">
    {!raw ? (
      <div>
        <h1 class="text-2xl font-bold">Model not found</h1>
        <p class="mt-2 text-sm text-[color:var(--color-muted)]">No model with ID <code class="font-mono bg-[color:var(--color-surface)] px-1 rounded">{modelId}</code></p>
        <a href={path(locale, '/catalog')} class="mt-4 inline-block text-sm underline">← {dict('catalog.title')}</a>
      </div>
    ) : (
      <div>
        <a href={path(locale, '/catalog')} class="text-xs text-[color:var(--color-muted)] hover:underline">← {dict('catalog.title')}</a>

        <div class="mt-4 flex items-start justify-between gap-4">
          <div>
            <h1 class="text-3xl font-bold">{raw.name}</h1>
            <div class="mt-1 flex flex-wrap gap-2 text-xs text-[color:var(--color-muted)] font-mono">
              {raw.family && raw.family !== raw.id ? <span>{raw.family}</span> : null}
              <span>{raw.id}</span>
              {raw.license ? <span class="px-1.5 py-0.5 rounded bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">{raw.license}</span> : null}
              {raw.release_date ? <span>Released {raw.release_date}</span> : null}
            </div>
          </div>
        </div>

        <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4">
          {[
            ['Context window', raw.context_window ? `${(raw.context_window / 1000).toFixed(0)}k` : '—'],
            ['Max output', raw.max_output ? `${(raw.max_output / 1000).toFixed(0)}k` : '—'],
            ['Parameters', paramLabel(raw.parameter_count)],
            ['Offerings', String(raw.offerings.length)],
          ].map(([label, value]) => (
            <div class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-3">
              <div class="text-xs text-[color:var(--color-muted)]">{label}</div>
              <div class="mt-1 text-lg font-semibold font-mono">{value}</div>
            </div>
          ))}
        </div>

        {flagList(raw.flags).length > 0 && (
          <div class="mt-8">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-muted)] mb-3">Capabilities</h2>
            <div class="flex flex-wrap gap-2">
              {flagList(raw.flags).map(({ label, icon }) => (
                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] text-xs">
                  <span>{icon}</span><span>{label}</span>
                </span>
              ))}
            </div>
          </div>
        )}

        {Object.keys(raw.benchmark_scores).length > 0 && (
          <div class="mt-8">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-muted)] mb-3">Benchmarks</h2>
            <div class="rounded-lg border border-[color:var(--color-border)] overflow-hidden">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
                    <th class="px-3 py-2 text-left font-medium">Benchmark</th>
                    <th class="px-3 py-2 text-right font-medium">Score</th>
                  </tr>
                </thead>
                <tbody>
                  {Object.entries(raw.benchmark_scores)
                    .sort((a, b) => b[1] - a[1])
                    .map(([name, score]) => (
                      <tr class="border-t border-[color:var(--color-border)]">
                        <td class="px-3 py-2 font-mono text-xs">{name}</td>
                        <td class="px-3 py-2 text-right font-mono font-medium">{typeof score === 'number' ? score.toFixed(1) : score}</td>
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        <div class="mt-8">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-muted)] mb-3">Providers &amp; Pricing</h2>
          <div class="rounded-lg border border-[color:var(--color-border)] overflow-hidden">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
                  <th class="px-3 py-2 text-left font-medium">Provider</th>
                  <th class="px-3 py-2 text-left font-medium">Type</th>
                  <th class="px-3 py-2 text-right font-medium">Context</th>
                  <th class="px-3 py-2 text-right font-medium">Input</th>
                  <th class="px-3 py-2 text-right font-medium">Output</th>
                  <th class="px-3 py-2 text-right font-medium">Cache read</th>
                </tr>
              </thead>
              <tbody>
                {raw.offerings.map((o) => (
                    <tr class="border-t border-[color:var(--color-border)]">
                      <td class="px-3 py-2">
                        <div class="font-medium">{o.provider_name}</div>
                        <div class="text-xs text-[color:var(--color-muted)] font-mono">{o.provider_id}{o.region ? ` · ${o.region}` : ''}</div>
                      </td>
                      <td class="px-3 py-2 text-xs text-[color:var(--color-muted)]">{o.provider_type}</td>
                      <td class="px-3 py-2 text-right font-mono text-xs">{o.context_window ? `${(o.context_window / 1000).toFixed(0)}k` : '—'}</td>
                      <td class="px-3 py-2 text-right font-mono text-xs">{o.input_cost != null ? `$${o.input_cost.toFixed(2)}` : '—'}</td>
                      <td class="px-3 py-2 text-right font-mono text-xs">{o.output_cost != null ? `$${o.output_cost.toFixed(2)}` : '—'}</td>
                      <td class="px-3 py-2 text-right font-mono text-xs">{o.cache_read != null ? `$${o.cache_read.toFixed(4)}` : '—'}</td>
                    </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}
  </main>
</Layout>
