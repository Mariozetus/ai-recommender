---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { detectLocale, setLocale, t } from '../../i18n/index';

const { id } = Astro.params;

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = detectLocale(acceptLanguage || undefined);
setLocale(locale);

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const model = models.find((m: any) => m.id === id);

if (!model) {
  return Astro.redirect('/404');
}

const categoryColors: Record<string, string> = {
  chat: '#1e3a5f',
  coding: '#1a3d1a',
  reasoning: '#3d1a5c',
  image: '#3d1a3d',
  embedding: '#5c3d1a',
  multimodal: '#1a3d3d',
};

const relatedModels = models
  .filter((m: any) => m.category === model.category && m.id !== model.id)
  .slice(0, 4);
---

<Layout title={`${model.name} - AI Model`} description={model.description}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <a href="/" class="text-teal-400 hover:text-teal-300 mb-6 inline-block">{t('model.back')}</a>

    <article class="bg-gray-800 rounded-lg border border-gray-700 overflow-hidden">
      <div class="p-8">
        <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
          <div>
            <h1 class="text-3xl font-bold text-white mb-2">{model.name}</h1>
            <p class="text-gray-400">
              <a href={`/provider/${model.provider}`} class="hover:text-teal-400">{model.provider}</a>
            </p>
          </div>
          <span
            class="px-3 py-1 rounded text-sm font-medium text-white"
            style={`background-color: ${categoryColors[model.category] || '#374151'}`}
          >
            {model.category}
          </span>
        </div>

        <p class="text-gray-300 text-lg mb-8">{model.description}</p>

        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <div class="bg-gray-700/50 rounded-lg p-6">
            <h2 class="text-lg font-semibold mb-4 text-white">{t('model.pricing')}</h2>
            <div class="space-y-3">
              <div class="flex justify-between">
                <span class="text-gray-400">Input</span>
                <span class="text-white font-mono">${model.input_price}{t('common.per_1m')}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Output</span>
                <span class="text-white font-mono">${model.output_price}{t('common.per_1m')}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">{t('model.pricing').split(' ')[0]} Window</span>
                <span class="text-white font-mono">{model.context_window.toLocaleString()} {t('common.tokens')}</span>
              </div>
              {model.pricing?.free && (
                <div class="flex justify-between">
                  <span class="text-gray-400">Free Tier</span>
                  <span class="text-green-400 font-mono">{t('compare.yes')}</span>
                </div>
              )}
            </div>
          </div>

          <PricingCalculator
            modelId={model.id}
            modelName={model.name}
            inputPrice={model.input_price}
            outputPrice={model.output_price}
          />
        </div>

        {model.benchmark && (
          <div class="bg-gray-700/50 rounded-lg p-6 mb-8">
            <h2 class="text-lg font-semibold mb-4 text-white">{t('model.benchmarks')}</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              {model.benchmark.mmlu && (
                <div class="text-center">
                  <div class="text-2xl font-bold text-white mb-1">{model.benchmark.mmlu}%</div>
                  <div class="text-xs text-gray-400">MMLU</div>
                </div>
              )}
              {model.benchmark.mmlu_pro && (
                <div class="text-center">
                  <div class="text-2xl font-bold text-white mb-1">{model.benchmark.mmlu_pro}%</div>
                  <div class="text-xs text-gray-400">MMLU Pro</div>
                </div>
              )}
              {model.benchmark.humaneval && (
                <div class="text-center">
                  <div class="text-2xl font-bold text-white mb-1">{model.benchmark.humaneval}%</div>
                  <div class="text-xs text-gray-400">HumanEval</div>
                </div>
              )}
              {model.benchmark.math && (
                <div class="text-center">
                  <div class="text-2xl font-bold text-white mb-1">{model.benchmark.math}%</div>
                  <div class="text-xs text-gray-400">MATH</div>
                </div>
              )}
              {model.benchmark.arena_elo && (
                <div class="text-center">
                  <div class="text-2xl font-bold text-white mb-1">{model.benchmark.arena_elo}</div>
                  <div class="text-xs text-gray-400">Arena ELO</div>
                </div>
              )}
            </div>
          </div>
        )}

        {model.modalities && (
          <div class="mb-8">
            <h2 class="text-lg font-semibold mb-4 text-white">{t('model.modalities')}</h2>
            <div class="flex flex-wrap gap-2">
              {model.modalities.text && (
                <span class="bg-blue-900 text-blue-300 px-3 py-1 rounded text-sm">Text Input</span>
              )}
              {model.modalities.image_input && (
                <span class="bg-pink-900 text-pink-300 px-3 py-1 rounded text-sm">Image Input</span>
              )}
              {model.modalities.image_output && (
                <span class="bg-purple-900 text-purple-300 px-3 py-1 rounded text-sm">Image Output</span>
              )}
              {model.modalities.audio_input && (
                <span class="bg-green-900 text-green-300 px-3 py-1 rounded text-sm">Audio Input</span>
              )}
              {model.modalities.audio_output && (
                <span class="bg-orange-900 text-orange-300 px-3 py-1 rounded text-sm">Audio Output</span>
              )}
            </div>
          </div>
        )}

        {model.tags && model.tags.length > 0 && (
          <div class="mb-8">
            <h2 class="text-lg font-semibold mb-4 text-white">{t('model.tags')}</h2>
            <div class="flex flex-wrap gap-2">
              {model.tags.map((tag: string) => (
                <span class="bg-gray-700 text-gray-300 px-3 py-1 rounded text-sm">{tag}</span>
              ))}
            </div>
          </div>
        )}

        <div class="flex flex-wrap gap-4">
          <a
            href={model.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-teal-600 hover:bg-teal-500 text-white px-6 py-3 rounded font-medium transition"
          >
            {t('model.view_on', { provider: model.provider })}
          </a>
          <button
            id="compare-btn"
            data-model-id={model.id}
            class="bg-gray-700 hover:bg-gray-600 text-white px-6 py-3 rounded font-medium transition"
          >
            {t('model.add_compare')}
          </button>
        </div>
      </div>

      <div class="bg-gray-900/50 px-8 py-4 border-t border-gray-700">
        <p class="text-gray-500 text-sm">
          {t('model.source')}: {model.source} · {t('model.last_updated')}: {new Date(model.fetched_at).toLocaleDateString()}
        </p>
      </div>
    </article>

    {relatedModels.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xl font-bold text-white mb-6">Related Models</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          {relatedModels.map((m: any) => (
            <a href={`/models/${encodeURIComponent(m.id)}`} class="bg-gray-800 rounded-lg p-4 border border-gray-700 hover:border-gray-600 transition">
              <h3 class="font-semibold text-white mb-1 truncate">{m.name}</h3>
              <p class="text-gray-500 text-sm mb-2">{m.provider}</p>
              <p class="text-gray-400 text-xs">${m.input_price + m.output_price}/1M</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  const compareBtn = document.getElementById('compare-btn');
  const modelId = compareBtn?.dataset.modelId;

  compareBtn?.addEventListener('click', () => {
    const compareIds = JSON.parse(localStorage.getItem('compareIds') || '[]');
    if (!compareIds.includes(modelId)) {
      compareIds.push(modelId);
      localStorage.setItem('compareIds', JSON.stringify(compareIds));
      compareBtn.textContent = 'Added!';
      compareBtn.disabled = true;
    }
  });
</script>
