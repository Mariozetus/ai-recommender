---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import PricingCalculator from '../../../components/PricingCalculator.astro';
import BenchmarkBar from '../../../components/BenchmarkBar.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { detectLocale, setLocale, t } from '../../../i18n/index';
import { sanitizeModel } from '../../../lib/sanitize';

const { provider, name } = Astro.params;

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = detectLocale(acceptLanguage || undefined);
setLocale(locale);

const numberFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US');
const currencyFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US', { style: 'currency', currency: 'USD' });
const dateFmt = new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });

if (!provider || !name) {
  return new Response('Not Found', { status: 404 });
}

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const modelId = `${provider}/${name}`;
const rawModel = models.find((m: any) => m.id === modelId);

if (!rawModel) {
  return new Response('Not Found', { status: 404 });
}

const model = sanitizeModel(rawModel);

const relatedModels = models
  .filter((m: any) => m.category === model.category && m.id !== model.id)
  .slice(0, 4);

const sameProvider = models
  .filter((m: any) => m.provider === model.provider && m.id !== model.id)
  .slice(0, 4);

const useCaseMap: Record<string, { slug: string; title: string }[]> = {
  chat: [
    { slug: 'customer-support', title: 'Atención al cliente' },
    { slug: 'content-generation', title: 'Generación de contenido' },
    { slug: 'translation', title: 'Traducción' },
  ],
  coding: [
    { slug: 'code-review', title: 'Revisión de código' },
    { slug: 'data-analysis', title: 'Análisis de datos' },
  ],
  reasoning: [
    { slug: 'data-analysis', title: 'Análisis de datos' },
    { slug: 'code-review', title: 'Revisión de código' },
  ],
  multimodal: [
    { slug: 'vision-analysis', title: 'Análisis de imagen' },
  ],
  image: [
    { slug: 'image-generation', title: 'Generación de imágenes' },
  ],
  embedding: [
    { slug: 'embeddings', title: 'Embeddings y búsqueda' },
  ],
};

const useCases = useCaseMap[model.category] || [];

const formattedDate = dateFmt.format(new Date(model.fetched_at));
---

<Layout title={`${model.name} · AI Model`} description={model.description}>
  <article class="max-w-5xl mx-auto px-6 py-12 md:py-16">

    <nav class="text-[13px] text-[var(--color-ink-3)] mb-10 flex flex-wrap items-center gap-x-2" aria-label="Ruta">
      <a href="/" class="hover:text-[var(--color-ink)] focus-ring">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/catalog" class="hover:text-[var(--color-ink)] focus-ring">Catálogo</a>
      <span aria-hidden="true">/</span>
      <a href={`/provider/${model.provider}`} class="hover:text-[var(--color-ink)] focus-ring">{model.provider}</a>
      <span aria-hidden="true">/</span>
      <span class="text-[var(--color-ink-2)]" aria-current="page">{model.name}</span>
    </nav>

    <header class="mb-12 pb-12 border-b rule">
      <div class="flex flex-wrap items-baseline gap-3 mb-4 text-[13px]">
        <span class="uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium">
          {model.category}
        </span>
        {model.pricing?.free && (
          <>
            <span class="text-[var(--color-ink-4)]" aria-hidden="true">·</span>
            <span class="text-[var(--color-accent)] font-medium">Capa gratuita</span>
          </>
        )}
        {model.pricing?.batch && (
          <>
            <span class="text-[var(--color-ink-4)]" aria-hidden="true">·</span>
            <span class="text-[var(--color-ink-2)]">Batch disponible</span>
          </>
        )}
      </div>

      <h1 class="text-4xl md:text-5xl font-semibold tracking-[-0.02em] text-[var(--color-ink)] mb-4 text-balance">
        {model.name}
      </h1>

      <p class="text-[var(--color-ink-2)] text-lg leading-relaxed text-pretty max-w-3xl">
        {model.description}
      </p>
    </header>

    <section class="mb-16">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
        Cifras clave
      </p>

      <dl class="grid grid-cols-2 md:grid-cols-4 gap-px bg-[var(--color-rule)]">
        <div class="bg-[var(--color-paper)] p-5">
          <dt class="text-[12px] text-[var(--color-ink-3)] uppercase tracking-wider mb-2">Input</dt>
          <dd class="text-2xl font-semibold text-[var(--color-ink)] tnum">{currencyFmt.format(model.input_price)}</dd>
          <p class="text-[12px] text-[var(--color-ink-3)] mt-1">por millón de tokens</p>
        </div>
        <div class="bg-[var(--color-paper)] p-5">
          <dt class="text-[12px] text-[var(--color-ink-3)] uppercase tracking-wider mb-2">Output</dt>
          <dd class="text-2xl font-semibold text-[var(--color-ink)] tnum">{currencyFmt.format(model.output_price)}</dd>
          <p class="text-[12px] text-[var(--color-ink-3)] mt-1">por millón de tokens</p>
        </div>
        <div class="bg-[var(--color-paper)] p-5">
          <dt class="text-[12px] text-[var(--color-ink-3)] uppercase tracking-wider mb-2">Contexto</dt>
          <dd class="text-2xl font-semibold text-[var(--color-ink)] tnum">
            {model.context_window >= 1_000_000
              ? `${(model.context_window / 1_000_000).toFixed(1)}M`
              : model.context_window >= 1000
                ? `${Math.round(model.context_window / 1000)}K`
                : model.context_window}
          </dd>
          <p class="text-[12px] text-[var(--color-ink-3)] mt-1">tokens de entrada</p>
        </div>
        <div class="bg-[var(--color-paper)] p-5">
          <dt class="text-[12px] text-[var(--color-ink-3)] uppercase tracking-wider mb-2">Idiomas</dt>
          <dd class="text-2xl font-semibold text-[var(--color-ink)] tnum">{model.supported_languages?.length || 1}</dd>
          <p class="text-[12px] text-[var(--color-ink-3)] mt-1">soportados</p>
        </div>
      </dl>
    </section>

    {model.benchmark && (
      <section class="mb-16">
        <div class="flex items-baseline justify-between mb-6">
          <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium">
            Benchmarks
          </p>
          <p class="text-[12px] text-[var(--color-ink-3)]">
            Cuanto más alta la barra, mejor
          </p>
        </div>
        <BenchmarkBar benchmarks={model.benchmark} />
      </section>
    )}

    <section class="mb-16">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
        Calculadora de costo
      </p>
      <PricingCalculator
        modelId={model.id}
        modelName={model.name}
        inputPrice={model.input_price}
        outputPrice={model.output_price}
      />
    </section>

    {useCases.length > 0 && (
      <section class="mb-16">
        <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
          Casos de uso
        </p>
        <div class="grid sm:grid-cols-2 gap-px bg-[var(--color-rule)]">
          {useCases.map(uc => (
            <a
              href={`/use-cases/${uc.slug}`}
              class="group bg-[var(--color-paper)] p-5 hover:bg-[var(--color-paper-2)] transition-colors focus-ring"
            >
              <h3 class="font-medium text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors mb-1">
                {uc.title}
              </h3>
              <p class="text-[13px] text-[var(--color-ink-3)]">Ver ranking y guía</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {model.supported_parameters && model.supported_parameters.length > 0 && (
      <section class="mb-16">
        <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
          Capacidades técnicas
        </p>
        <ul class="flex flex-wrap gap-1.5">
          {model.supported_parameters.map((param: string) => (
            <li class="bg-[var(--color-paper-2)] border rule text-[var(--color-ink-2)] px-2.5 py-1 rounded-sm text-[12px] tnum">
              {param.replace(/_/g, ' ')}
            </li>
          ))}
        </ul>
      </section>
    )}

    {model.supported_languages && model.supported_languages.length > 0 && (
      <section class="mb-16">
        <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
          Idiomas
        </p>
        <ul class="flex flex-wrap gap-1.5">
          {model.supported_languages.map(lang => (
            <li class="bg-[var(--color-paper-2)] border rule text-[var(--color-ink-2)] px-2.5 py-1 rounded-sm text-[12px]">
              {lang.flag} {lang.name}
            </li>
          ))}
        </ul>
      </section>
    )}

    {(model.hf_likes || model.hf_downloads || model.hf_id) && (
      <section class="mb-16">
        <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
          HuggingFace
        </p>
        <dl class="grid grid-cols-3 gap-px bg-[var(--color-rule)]">
          {model.hf_likes !== undefined && (
            <div class="bg-[var(--color-paper)] p-5">
              <dt class="text-[12px] text-[var(--color-ink-3)] uppercase tracking-wider mb-2">Likes</dt>
              <dd class="text-xl font-semibold tnum text-[var(--color-ink)]">{numberFmt.format(model.hf_likes)}</dd>
            </div>
          )}
          {model.hf_downloads !== undefined && (
            <div class="bg-[var(--color-paper)] p-5">
              <dt class="text-[12px] text-[var(--color-ink-3)] uppercase tracking-wider mb-2">Descargas</dt>
              <dd class="text-xl font-semibold tnum text-[var(--color-ink)]">{numberFmt.format(model.hf_downloads)}</dd>
            </div>
          )}
          {model.hf_id && (
            <div class="bg-[var(--color-paper)] p-5 min-w-0">
              <dt class="text-[12px] text-[var(--color-ink-3)] uppercase tracking-wider mb-2">HF ID</dt>
              <dd class="min-w-0">
                <a
                  href={`https://huggingface.co/${model.hf_id}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ver ${model.hf_id} en HuggingFace`}
                  class="text-sm text-[var(--color-ink-2)] hover:text-[var(--color-ink)] truncate inline-block max-w-full focus-ring"
                >
                  {model.hf_id}
                </a>
              </dd>
            </div>
          )}
        </dl>
      </section>
    )}

    <section class="mb-16 pt-8 border-t rule">
      <div class="flex flex-wrap gap-3">
        <a
          href={model.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[var(--color-ink)] text-[var(--color-paper)] hover:bg-[var(--color-ink-2)] px-5 py-2.5 rounded-sm text-[15px] font-medium transition-colors focus-ring"
          aria-label={`Ver ${model.name} en ${model.provider} (enlace externo)`}
        >
          Ver en {model.provider}
        </a>
        <button
          id="compare-btn"
          data-model-id={model.id}
          type="button"
          class="inline-flex items-center gap-2 border rule text-[var(--color-ink)] hover:bg-[var(--color-paper-2)] px-5 py-2.5 rounded-sm text-[15px] font-medium transition-colors focus-ring"
        >
          Añadir a comparación
        </button>
      </div>
    </section>

    {relatedModels.length > 0 && (
      <section class="mb-12">
        <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
          Modelos similares
        </p>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-rule)]">
          {relatedModels.map((m: any) => (
            <li class="bg-[var(--color-paper)]">
              <a href={`/models/${m.provider}/${m.id.split("/")[1] || ""}`} class="block p-4 hover:bg-[var(--color-paper-2)] transition-colors focus-ring min-w-0">
                <p class="text-[12px] text-[var(--color-ink-3)] mb-1 truncate">{m.provider}</p>
                <h3 class="font-medium text-[var(--color-ink)] truncate mb-2">{m.name}</h3>
                <p class="text-[13px] tnum text-[var(--color-ink-2)]">
                  {currencyFmt.format(m.input_price + m.output_price)}<span class="text-[var(--color-ink-3)] text-[11px]"> /1M</span>
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="text-[12px] text-[var(--color-ink-3)] pt-8 border-t rule">
      Fuente: {model.source} · Actualizado {formattedDate}
    </p>
  </article>
</Layout>

<script>
  const compareBtn = document.getElementById('compare-btn');
  const modelId = compareBtn?.dataset.modelId;

  function showToast(message: string, kind: string = 'info') {
    const fn = (window as any).showToast;
    if (typeof fn === 'function') fn(message, kind);
  }

  if (modelId) {
    const history = JSON.parse(localStorage.getItem('viewHistory') || '[]');
    const filtered = history.filter((h: string) => h !== modelId);
    filtered.unshift(modelId);
    localStorage.setItem('viewHistory', JSON.stringify(filtered.slice(0, 10)));
  }

  compareBtn?.addEventListener('click', () => {
    if (!modelId) return;
    const compareIds = JSON.parse(localStorage.getItem('compareIds') || '[]');
    if (!compareIds.includes(modelId)) {
      if (compareIds.length >= 4) {
        showToast('Máximo 4 modelos para comparar', 'warning');
        return;
      }
      compareIds.push(modelId);
      localStorage.setItem('compareIds', JSON.stringify(compareIds));
      if (compareBtn) {
        compareBtn.textContent = 'Añadido';
        compareBtn.setAttribute('disabled', 'true');
      }
      showToast('Modelo añadido a comparación', 'success');
    }
  });
</script>
