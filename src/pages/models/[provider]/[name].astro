---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import PricingCalculator from '../../../components/PricingCalculator.astro';
import BenchmarkRadar from '../../../components/BenchmarkRadar.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { detectLocale, setLocale, t } from '../../../i18n/index';
import { sanitizeModel } from '../../../lib/sanitize';

const { provider, name } = Astro.params;

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = detectLocale(acceptLanguage || undefined);
setLocale(locale);

if (!provider || !name) {
  return new Response('Not Found', { status: 404 });
}

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const modelId = `${provider}/${name}`;
const rawModel = models.find((m: any) => m.id === modelId);

if (!rawModel) {
  return new Response('Not Found', { status: 404 });
}

const model = sanitizeModel(rawModel);

const categoryColors: Record<string, string> = {
  chat: '#1e3a5f',
  coding: '#1a3d1a',
  reasoning: '#3d1a5c',
  image: '#3d1a3d',
  embedding: '#5c3d1a',
  multimodal: '#1a3d3d',
};

const relatedModels = models
  .filter((m: any) => m.category === model.category && m.id !== model.id)
  .slice(0, 4);

const sameProvider = models
  .filter((m: any) => m.provider === model.provider && m.id !== model.id)
  .slice(0, 4);

const useCaseMap: Record<string, { slug: string; title: string }[]> = {
  chat: [
    { slug: 'customer-support', title: 'AI for Customer Support' },
    { slug: 'content-generation', title: 'AI for Content Generation' },
    { slug: 'translation', title: 'AI for Translation' },
  ],
  coding: [
    { slug: 'code-review', title: 'AI for Code Review' },
    { slug: 'data-analysis', title: 'AI for Data Analysis' },
  ],
  reasoning: [
    { slug: 'data-analysis', title: 'AI for Data Analysis' },
    { slug: 'code-review', title: 'AI for Code Review' },
  ],
  multimodal: [
    { slug: 'vision-analysis', title: 'AI for Vision & Image Analysis' },
  ],
  image: [
    { slug: 'image-generation', title: 'AI for Image Generation' },
  ],
  embedding: [
    { slug: 'embeddings', title: 'AI for Embeddings & Search' },
  ],
};

const useCases = useCaseMap[model.category] || [];

const formattedDate = new Date(model.fetched_at).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${model.name} - AI Model`} description={model.description}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-teal-400">Inicio</a>
      <span class="mx-2">/</span>
      <a href="/catalog" class="hover:text-teal-400">Catálogo</a>
      <span class="mx-2">/</span>
      <a href={`/provider/${model.provider}`} class="hover:text-teal-400">{model.provider}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-400">{model.name}</span>
    </nav>

    <article class="bg-gray-800 rounded-lg border border-gray-700 overflow-hidden">
      <div class="p-8">
        <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
          <div>
            <h1 class="text-3xl font-bold text-white mb-2">{model.name}</h1>
            <p class="text-gray-400">
              <a href={`/provider/${model.provider}`} class="hover:text-teal-400">{model.provider}</a>
            </p>
          </div>
          <div class="flex gap-2">
            {model.pricing?.free && (
              <span class="px-3 py-1 rounded text-sm font-medium bg-green-900/50 border border-green-700 text-green-300">
                FREE
              </span>
            )}
            <span
              class="px-3 py-1 rounded text-sm font-medium text-white"
              style={`background-color: ${categoryColors[model.category] || '#374151'}`}
            >
              {model.category}
            </span>
          </div>
        </div>

        <p class="text-gray-300 text-lg mb-8">{model.description}</p>

        {model.strengths && model.strengths.length > 0 && (
          <div class="mb-8 bg-gray-900/30 border border-gray-700 rounded-lg p-5">
            <h3 class="text-sm font-semibold text-gray-300 mb-3">Puntos fuertes</h3>
            <div class="flex flex-wrap gap-2">
              {model.strengths.map((s: string) => (
                <span class="inline-flex items-center gap-1.5 bg-teal-900/30 border border-teal-700 text-teal-300 px-3 py-1.5 rounded-full text-sm">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  {s}
                </span>
              ))}
            </div>
          </div>
        )}

        {useCases.length > 0 && (
          <div class="mb-8 bg-gradient-to-r from-teal-900/20 to-purple-900/20 border border-teal-800/50 rounded-lg p-5">
            <h3 class="text-sm font-semibold text-teal-300 mb-3">Casos de uso ideales para este modelo</h3>
            <div class="flex flex-wrap gap-2">
              {useCases.map(uc => (
                <a
                  href={`/use-cases/${uc.slug}`}
                  class="inline-flex items-center gap-2 bg-gray-800/70 hover:bg-gray-700 border border-gray-700 hover:border-teal-600 px-4 py-2 rounded-lg text-sm text-white transition"
                >
                  <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  {uc.title}
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <div class="bg-gray-700/50 rounded-lg p-6">
            <h2 class="text-lg font-semibold mb-4 text-white">Precios</h2>
            <div class="space-y-3">
              <div class="flex justify-between">
                <span class="text-gray-400">Input</span>
                <span class="text-white font-mono">${model.input_price.toFixed(2)}/1M tokens</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Output</span>
                <span class="text-white font-mono">${model.output_price.toFixed(2)}/1M tokens</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Context Window</span>
                <span class="text-white font-mono">{model.context_window.toLocaleString()} tokens</span>
              </div>
              {model.max_completion_tokens && (
                <div class="flex justify-between">
                  <span class="text-gray-400">Max output</span>
                  <span class="text-white font-mono">{model.max_completion_tokens.toLocaleString()} tokens</span>
                </div>
              )}
              {model.pricing?.free && (
                <div class="flex justify-between">
                  <span class="text-gray-400">Free Tier</span>
                  <span class="text-green-400 font-mono">Sí</span>
                </div>
              )}
              {model.pricing?.batch && (
                <div class="flex justify-between">
                  <span class="text-gray-400">Batch API</span>
                  <span class="text-teal-400 font-mono">Sí (50% descuento)</span>
                </div>
              )}
              {model.tokenizer && (
                <div class="flex justify-between">
                  <span class="text-gray-400">Tokenizer</span>
                  <span class="text-white font-mono">{model.tokenizer}</span>
                </div>
              )}
            </div>
          </div>

          <PricingCalculator
            modelId={model.id}
            modelName={model.name}
            inputPrice={model.input_price}
            outputPrice={model.output_price}
          />
        </div>

        {model.benchmark && (
          <div class="grid md:grid-cols-2 gap-6 mb-8">
            <BenchmarkRadar benchmarks={model.benchmark} size={280} />
            <div class="bg-gray-700/50 rounded-lg p-6">
              <h2 class="text-lg font-semibold mb-4 text-white">Benchmarks</h2>
              <div class="space-y-3">
                {model.benchmark.mmlu && (
                  <div class="flex justify-between">
                    <span class="text-gray-400">MMLU</span>
                    <span class="text-white font-mono">{model.benchmark.mmlu}%</span>
                  </div>
                )}
                {model.benchmark.mmlu_pro && (
                  <div class="flex justify-between">
                    <span class="text-gray-400">MMLU Pro</span>
                    <span class="text-white font-mono">{model.benchmark.mmlu_pro}%</span>
                  </div>
                )}
                {model.benchmark.humaneval && (
                  <div class="flex justify-between">
                    <span class="text-gray-400">HumanEval</span>
                    <span class="text-white font-mono">{model.benchmark.humaneval}%</span>
                  </div>
                )}
                {model.benchmark.math && (
                  <div class="flex justify-between">
                    <span class="text-gray-400">MATH</span>
                    <span class="text-white font-mono">{model.benchmark.math}%</span>
                  </div>
                )}
                {model.benchmark.arena_elo && (
                  <div class="flex justify-between">
                    <span class="text-gray-400">Arena ELO</span>
                    <span class="text-white font-mono">{model.benchmark.arena_elo}</span>
                  </div>
                )}
                {model.benchmark.intelligence_index && (
                  <div class="flex justify-between">
                    <span class="text-gray-400">Intelligence Index</span>
                    <span class="text-teal-400 font-mono">{model.benchmark.intelligence_index}</span>
                  </div>
                )}
                {model.benchmark.coding_index && (
                  <div class="flex justify-between">
                    <span class="text-gray-400">Coding Index</span>
                    <span class="text-teal-400 font-mono">{model.benchmark.coding_index}</span>
                  </div>
                )}
                {model.benchmark.agentic_index && (
                  <div class="flex justify-between">
                    <span class="text-gray-400">Agentic Index</span>
                    <span class="text-teal-400 font-mono">{model.benchmark.agentic_index}</span>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {model.modalities && (
          <div class="mb-8">
            <h2 class="text-lg font-semibold mb-4 text-white">Modalidades</h2>
            <div class="flex flex-wrap gap-2">
              {model.modalities.text && (
                <span class="bg-blue-900 text-blue-300 px-3 py-1 rounded text-sm">Text Input/Output</span>
              )}
              {model.modalities.image_input && (
                <span class="bg-pink-900 text-pink-300 px-3 py-1 rounded text-sm">Image Input</span>
              )}
              {model.modalities.image_output && (
                <span class="bg-purple-900 text-purple-300 px-3 py-1 rounded text-sm">Image Output</span>
              )}
              {model.modalities.audio_input && (
                <span class="bg-green-900 text-green-300 px-3 py-1 rounded text-sm">Audio Input</span>
              )}
              {model.modalities.audio_output && (
                <span class="bg-orange-900 text-orange-300 px-3 py-1 rounded text-sm">Audio Output</span>
              )}
              {model.modalities.file_input && (
                <span class="bg-yellow-900 text-yellow-300 px-3 py-1 rounded text-sm">File (PDF) Input</span>
              )}
            </div>
          </div>
        )}

        {model.supported_parameters && model.supported_parameters.length > 0 && (
          <div class="mb-8">
            <h2 class="text-lg font-semibold mb-4 text-white">Capacidades técnicas</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
              {model.supported_parameters.map((param: string) => (
                <span class="bg-gray-900/50 border border-gray-700 text-gray-300 px-3 py-2 rounded text-sm flex items-center gap-2">
                  <svg class="w-4 h-4 text-teal-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {param.replace(/_/g, ' ')}
                </span>
              ))}
            </div>
          </div>
        )}

        {model.supported_languages && model.supported_languages.length > 0 && (
          <div class="mb-8">
            <h2 class="text-lg font-semibold mb-4 text-white">Idiomas soportados</h2>
            <div class="flex flex-wrap gap-2">
              {model.supported_languages.map(lang => (
                <span class="bg-gray-700 text-gray-300 px-3 py-1 rounded text-sm">
                  {lang.flag} {lang.name}
                </span>
              ))}
            </div>
          </div>
        )}

        {model.tags && model.tags.length > 0 && (
          <div class="mb-8">
            <h2 class="text-lg font-semibold mb-4 text-white">Tags</h2>
            <div class="flex flex-wrap gap-2">
              {model.tags.map((tag: string) => (
                <span class="bg-gray-700 text-gray-300 px-3 py-1 rounded text-sm">{tag}</span>
              ))}
            </div>
          </div>
        )}

        <div class="flex flex-wrap gap-4">
          <a
            href={model.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-teal-600 hover:bg-teal-500 text-white px-6 py-3 rounded font-medium transition"
          >
            Ver en {model.provider} →
          </a>
          <button
            id="compare-btn"
            data-model-id={model.id}
            class="bg-gray-700 hover:bg-gray-600 text-white px-6 py-3 rounded font-medium transition"
          >
            Añadir a comparación
          </button>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-8 pt-8 border-t border-gray-700">
          <div class="text-center">
            <div class="text-2xl font-bold text-white">{model.context_window >= 1000000 ? `${(model.context_window / 1000000).toFixed(1)}M` : `${(model.context_window / 1000).toFixed(0)}K`}</div>
            <div class="text-xs text-gray-500 mt-1">Tokens contexto</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-white">${model.input_price.toFixed(2)}</div>
            <div class="text-xs text-gray-500 mt-1">Input / 1M</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-white">${model.output_price.toFixed(2)}</div>
            <div class="text-xs text-gray-500 mt-1">Output / 1M</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-teal-400">{model.supported_languages?.length || 1}</div>
            <div class="text-xs text-gray-500 mt-1">Idiomas</div>
          </div>
        </div>
      </div>

      <div class="bg-gray-900/50 px-8 py-4 border-t border-gray-700">
        <p class="text-gray-500 text-sm">
          Fuente: {model.source} · Actualizado: {formattedDate}
        </p>
      </div>
    </article>

    {relatedModels.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xl font-bold text-white mb-6">Modelos similares</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          {relatedModels.map((m: any) => (
            <a href={`/models/${m.provider}/${m.id.split("/")[1] || ""}`} class="bg-gray-800 rounded-lg p-4 border border-gray-700 hover:border-gray-600 transition">
              <h3 class="font-semibold text-white mb-1 truncate">{m.name}</h3>
              <p class="text-gray-500 text-sm mb-2">{m.provider}</p>
              <p class="text-gray-400 text-xs">${(m.input_price + m.output_price).toFixed(2)}/1M</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {sameProvider.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xl font-bold text-white mb-6">Otros modelos de {model.provider}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          {sameProvider.map((m: any) => (
            <a href={`/models/${m.provider}/${m.id.split("/")[1] || ""}`} class="bg-gray-800 rounded-lg p-4 border border-gray-700 hover:border-gray-600 transition">
              <h3 class="font-semibold text-white mb-1 truncate">{m.name}</h3>
              <p class="text-gray-500 text-sm mb-2 capitalize">{m.category}</p>
              <p class="text-gray-400 text-xs">${(m.input_price + m.output_price).toFixed(2)}/1M</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  const compareBtn = document.getElementById('compare-btn');
  const modelId = compareBtn?.dataset.modelId;

  function showToast(message: string, kind: string = 'info') {
    const fn = (window as any).showToast;
    if (typeof fn === 'function') fn(message, kind);
  }

  if (modelId) {
    const history = JSON.parse(localStorage.getItem('viewHistory') || '[]');
    const filtered = history.filter((h: string) => h !== modelId);
    filtered.unshift(modelId);
    localStorage.setItem('viewHistory', JSON.stringify(filtered.slice(0, 10)));
  }

  compareBtn?.addEventListener('click', () => {
    if (!modelId) return;
    const compareIds = JSON.parse(localStorage.getItem('compareIds') || '[]');
    if (!compareIds.includes(modelId)) {
      if (compareIds.length >= 4) {
        showToast('Máximo 4 modelos para comparar', 'warning');
        return;
      }
      compareIds.push(modelId);
      localStorage.setItem('compareIds', JSON.stringify(compareIds));
      if (compareBtn) {
        compareBtn.textContent = 'Añadido ✓';
        compareBtn.disabled = true;
      }
      showToast('Modelo añadido a comparación', 'success');
    }
  });
</script>
