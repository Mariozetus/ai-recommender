---
import Layout from '../../layouts/Layout.astro';
import { BEST_PICKS } from '../../data/content';
---

<Layout title="Rankings">
  <div class="border-b rule">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-3">
        Rankings
      </p>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-[-0.02em] text-[var(--color-ink)] mb-3 text-balance">
        Listas curadas
      </h1>
      <p class="text-[var(--color-ink-2)] max-w-2xl text-pretty">
        Rankings según prioridad, no por ranking genérico. Elige lo que necesitas.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-12">
    <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-rule)]">
      {BEST_PICKS.map(pick => (
        <li class="bg-[var(--color-paper)]">
          <a
            href={`/best/${pick.slug}`}
            class="group block p-6 hover:bg-[var(--color-paper-2)] transition-colors focus-ring h-full"
          >
            <h2 class="font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors mb-2">{pick.title}</h2>
            <p class="text-[13px] text-[var(--color-ink-2)] text-pretty leading-relaxed">{pick.tagline}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
