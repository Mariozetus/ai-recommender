---
import Layout from '../../layouts/Layout.astro';
import { BEST_PICKS } from '../../data/content';

const pickColors: Record<string, string> = {
  free: 'from-green-900/30 to-green-900/5 border-green-700 hover:border-green-500',
  cheap: 'from-yellow-900/30 to-yellow-900/5 border-yellow-700 hover:border-yellow-500',
  'long-context': 'from-indigo-900/30 to-indigo-900/5 border-indigo-700 hover:border-indigo-500',
  reasoning: 'from-purple-900/30 to-purple-900/5 border-purple-700 hover:border-purple-500',
  'open-source': 'from-blue-900/30 to-blue-900/5 border-blue-700 hover:border-blue-500',
  vision: 'from-pink-900/30 to-pink-900/5 border-pink-700 hover:border-pink-500',
};
---

<Layout title="Best AI Models - Top Picks" description="Las mejores listas curadas de modelos de IA">
  <div class="bg-gradient-to-b from-gray-900 to-gray-800 py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Best Picks</h1>
      <p class="text-xl text-gray-300 mb-3">Listas curadas con los mejores modelos según tus prioridades</p>
      <p class="text-gray-400 max-w-2xl mx-auto">¿Buscas gratis, baratos, de razonamiento o con visión? Aquí encontrarás el ranking que necesitas.</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {BEST_PICKS.map(pick => (
        <a
          href={`/best/${pick.slug}`}
          class:list={[
            'block p-6 rounded-xl border bg-gradient-to-br transition-all hover:scale-105 hover:shadow-2xl',
            pickColors[pick.slug] || 'from-gray-700/30 to-gray-700/5 border-gray-700 hover:border-gray-500'
          ]}
        >
          <h3 class="text-lg font-semibold text-white mb-2">{pick.title}</h3>
          <p class="text-sm text-gray-300 mb-4">{pick.tagline}</p>
          <div class="flex items-center text-xs text-teal-400">
            <span>Ver ranking</span>
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
