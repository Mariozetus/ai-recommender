---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { BEST_PICKS, getBestPick } from '../../data/content';
import { calculateScore } from '../../lib/scorer';
import type { AIModel } from '../../lib/types';

const { slug } = Astro.params;
const pick = slug ? getBestPick(slug) : undefined;

if (!pick) {
  return Astro.redirect('/best');
}

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = acceptLanguage?.includes('es') ? 'es' : 'en';
const numberFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US');
const currencyFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US', { style: 'currency', currency: 'USD' });

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const matched = models.filter(pick.filter);

const ranked = matched
  .map((m: AIModel) => ({
    model: m,
    score: calculateScore(m, {
      use_case: m.category as any,
      max_context: Math.max(...matched.map((x: AIModel) => x.context_window)),
      max_budget: 100,
      preferred_features: [],
    }),
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 15);
---

<Layout title={pick.title} description={pick.description}>
  <article class="max-w-5xl mx-auto px-6 py-12 md:py-16">
    <nav class="text-[13px] text-[var(--color-ink-3)] mb-10 flex flex-wrap items-center gap-x-2" aria-label="Ruta">
      <a href="/best" class="hover:text-[var(--color-ink)] focus-ring">Rankings</a>
      <span aria-hidden="true">/</span>
      <span class="text-[var(--color-ink-2)]" aria-current="page">{pick.title}</span>
    </nav>

    <header class="mb-12 pb-12 border-b rule">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-4">
        Ranking
      </p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-[-0.02em] text-[var(--color-ink)] mb-4 text-balance">
        {pick.title}
      </h1>
      <p class="text-xl text-[var(--color-ink-2)] mb-4 text-pretty">{pick.tagline}</p>
      <p class="text-[var(--color-ink-2)] leading-relaxed max-w-3xl text-pretty">{pick.description}</p>
      <p class="text-[13px] text-[var(--color-ink-3)] mt-6 tnum">
        {numberFmt.format(matched.length)} modelos coinciden con el filtro
      </p>
    </header>

    <section class="mb-16">
      <ol class="divide-y divide-[var(--color-rule)]">
        {ranked.map(({ model, score }, i) => (
          <li>
            <article class="grid md:grid-cols-[40px_1fr_180px] gap-4 py-5 hover:bg-[var(--color-paper-2)] transition-colors -mx-3 px-3 rounded-sm">
              <div class="text-[13px] tnum text-[var(--color-ink-3)] pt-1">{i + 1}</div>

              <div class="min-w-0">
                <div class="flex items-baseline gap-2 mb-1 text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">
                  <span>{model.category}</span>
                  <span class="text-[var(--color-ink-4)]">·</span>
                  <span>{model.provider}</span>
                </div>
                <h2 class="text-[16px] font-semibold text-[var(--color-ink)] mb-1">
                  <a href={`/models/${model.provider}/${model.id.split("/")[1] || ""}`} class="hover:text-[var(--color-accent)] focus-ring">{model.name}</a>
                </h2>
                <p class="text-[13px] text-[var(--color-ink-2)] line-clamp-2 text-pretty leading-relaxed">{model.description}</p>
              </div>

              <div class="md:text-right space-y-2 text-[12px]">
                <div>
                  <div class="text-[var(--color-ink-3)] uppercase tracking-wider text-[10px]">Contexto</div>
                  <div class="text-[var(--color-ink)] tnum">
                    {model.context_window >= 1_000_000 ? `${(model.context_window / 1_000_000).toFixed(1)}M` : `${Math.round(model.context_window / 1000)}K`}
                  </div>
                </div>
                <div>
                  <div class="text-[var(--color-ink-3)] uppercase tracking-wider text-[10px]">In + Out</div>
                  <div class="text-[var(--color-ink)] tnum">{currencyFmt.format(model.input_price + model.output_price)} / 1M</div>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section class="pt-10 border-t rule">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
        Otros rankings
      </p>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-rule)]">
        {BEST_PICKS.filter(b => b.slug !== pick.slug).map(b => (
          <li class="bg-[var(--color-paper)]">
            <a href={`/best/${b.slug}`} class="block p-4 hover:bg-[var(--color-paper-2)] transition-colors focus-ring min-w-0">
              <h3 class="font-medium text-[var(--color-ink)] truncate mb-1">{b.title}</h3>
              <p class="text-[12px] text-[var(--color-ink-3)] line-clamp-2 text-pretty">{b.tagline}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</Layout>
