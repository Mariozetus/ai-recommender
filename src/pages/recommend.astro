---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Recommender from '../components/Recommender.astro';
import ResultsList from '../components/ResultsList.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import type { UserPreferences, ScoreWeights } from '../lib/types';
import {
  topRecommendations,
  DEFAULT_WEIGHTS,
  QUALITY_FIRST_WEIGHTS,
  BUDGET_FIRST_WEIGHTS,
  BALANCED_WEIGHTS,
} from '../lib/scorer';

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = acceptLanguage?.includes('es') ? 'es' : 'en';
const numberFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US');
const currencyFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US', { style: 'currency', currency: 'USD' });

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const url = new URL(Astro.request.url);
const useCase = url.searchParams.get('use_case') || 'chat';
const maxContext = parseInt(url.searchParams.get('max_context') || '131072');
const maxBudget = parseFloat(url.searchParams.get('max_budget') || '50');
const strategy = url.searchParams.get('strategy') || 'balanced';
const featuresParam = url.searchParams.get('features') || '';
const preferredFeatures = featuresParam.split(',').map(f => f.trim()).filter(Boolean);

const prefs: UserPreferences = {
  use_case: useCase as UserPreferences['use_case'],
  max_context: maxContext,
  max_budget: maxBudget,
  preferred_features: preferredFeatures,
};

const weightsMap: Record<string, ScoreWeights> = {
  balanced: BALANCED_WEIGHTS,
  quality: QUALITY_FIRST_WEIGHTS,
  budget: BUDGET_FIRST_WEIGHTS,
};

const weights = weightsMap[strategy] || DEFAULT_WEIGHTS;
const hasQuery = url.searchParams.has('use_case');

const recommended = hasQuery ? topRecommendations(models, prefs, 12, weights) : [];
---

<Layout title="AI Recommendations">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4 text-balance">Recomendador de Modelos IA</h1>
      <p class="text-gray-400 text-lg text-pretty">Recomendaciones personalizadas según tus necesidades</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="md:col-span-1">
        <Recommender categories={[...new Set(models.map((m: any) => m.category))]} />
      </div>

      <div class="md:col-span-2">
        {hasQuery ? (
          <ResultsList
            models={recommended.map(r => r.model)}
            scores={recommended.map(r => ({ id: r.model.id, score: r.score, breakdown: r.breakdown }))}
            title={`Top ${recommended.length} para ${useCase}`}
            strategy={strategy}
          />
        ) : (
          <div class="bg-gray-800 rounded-lg p-8 text-center border border-gray-700">
            <p class="text-gray-400 text-pretty">Completa el formulario para obtener recomendaciones personalizadas.</p>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
