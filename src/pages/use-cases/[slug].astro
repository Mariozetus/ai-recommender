---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';
import { USE_CASES, getUseCase } from '../../data/content';
import { calculateScore } from '../../lib/scorer';
import type { AIModel } from '../../lib/types';

const { slug } = Astro.params;
const useCase = slug ? getUseCase(slug) : undefined;

if (!useCase) {
  return Astro.redirect('/');
}

const acceptLanguage = Astro.request.headers.get('accept-language');
const locale = acceptLanguage?.includes('es') ? 'es' : 'en';
const numberFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US');
const currencyFmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US', { style: 'currency', currency: 'USD' });

const rawData = await readFile(join(process.cwd(), 'data', 'ais.json'), 'utf-8');
const { models } = JSON.parse(rawData);

const matched = models.filter(useCase.filter);

const ranked = matched
  .map((m: AIModel) => ({
    model: m,
    score: calculateScore(m, {
      use_case: m.category as any,
      max_context: Math.max(...matched.map((x: AIModel) => x.context_window)),
      max_budget: 100,
      preferred_features: [],
    }),
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 8);
---

<Layout title={`${useCase.title}`} description={useCase.description}>
  <article class="max-w-5xl mx-auto px-6 py-12 md:py-16">
    <nav class="text-[13px] text-[var(--color-ink-3)] mb-10 flex flex-wrap items-center gap-x-2" aria-label="Ruta">
      <a href="/use-cases" class="hover:text-[var(--color-ink)] focus-ring">Casos de uso</a>
      <span aria-hidden="true">/</span>
      <span class="text-[var(--color-ink-2)]" aria-current="page">{useCase.title}</span>
    </nav>

    <header class="mb-12 pb-12 border-b rule">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-4">
        Caso de uso
      </p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-[-0.02em] text-[var(--color-ink)] mb-4 text-balance">
        {useCase.title}
      </h1>
      <p class="text-xl text-[var(--color-ink-2)] mb-6 text-pretty">{useCase.tagline}</p>
      <p class="text-[var(--color-ink-2)] leading-relaxed max-w-3xl text-pretty">{useCase.description}</p>
    </header>

    <div class="grid lg:grid-cols-[1fr_280px] gap-12 mb-16">
      <section>
        <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
          {ranked.length} modelos recomendados
        </p>
        <ol class="divide-y divide-[var(--color-rule)]">
          {ranked.map(({ model, score }, i) => (
            <li>
              <article class="py-5 grid md:grid-cols-[40px_1fr] gap-4 hover:bg-[var(--color-paper-2)] transition-colors -mx-3 px-3 rounded-sm">
                <div class="text-[13px] tnum text-[var(--color-ink-3)] pt-1">#{i + 1}</div>
                <div class="min-w-0">
                  <div class="flex items-baseline gap-2 mb-1.5 text-[12px] uppercase tracking-wider text-[var(--color-ink-3)]">
                    <span>{model.category}</span>
                    <span class="text-[var(--color-ink-4)]">·</span>
                    <span>{model.provider}</span>
                  </div>
                  <h3 class="text-[16px] font-semibold text-[var(--color-ink)] mb-1">
                    <a href={`/models/${model.provider}/${model.id.split("/")[1] || ""}`} class="hover:text-[var(--color-accent)] focus-ring">{model.name}</a>
                  </h3>
                  <p class="text-[13px] text-[var(--color-ink-2)] line-clamp-2 text-pretty leading-relaxed mb-3">{model.description}</p>

                  <dl class="grid grid-cols-4 gap-4 text-[12px]">
                    <div>
                      <dt class="text-[var(--color-ink-3)] uppercase tracking-wider text-[10px] mb-0.5">Contexto</dt>
                      <dd class="text-[var(--color-ink)] tnum">
                        {model.context_window >= 1_000_000 ? `${(model.context_window / 1_000_000).toFixed(1)}M` : `${Math.round(model.context_window / 1000)}K`}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-[var(--color-ink-3)] uppercase tracking-wider text-[10px] mb-0.5">Input</dt>
                      <dd class="text-[var(--color-ink)] tnum">{currencyFmt.format(model.input_price)}</dd>
                    </div>
                    <div>
                      <dt class="text-[var(--color-ink-3)] uppercase tracking-wider text-[10px] mb-0.5">Output</dt>
                      <dd class="text-[var(--color-ink)] tnum">{currencyFmt.format(model.output_price)}</dd>
                    </div>
                    <div>
                      <dt class="text-[var(--color-ink-3)] uppercase tracking-wider text-[10px] mb-0.5">Score</dt>
                      <dd class="text-[var(--color-accent)] tnum font-medium">{Math.round(score)}/100</dd>
                    </div>
                  </dl>

                  <div class="flex gap-2 mt-3">
                    <button
                      type="button"
                      class="compare-btn border rule text-[var(--color-ink)] hover:bg-[var(--color-paper)] px-3 py-1.5 rounded-sm text-[12px] font-medium transition-colors focus-ring"
                      data-model-id={model.id}
                      aria-label={`Añadir ${model.name} a comparación`}
                    >
                      Comparar
                    </button>
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ol>
      </section>

      <aside class="space-y-10">
        <section>
          <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] font-medium mb-3">
            Requisitos
          </p>
          <ul class="space-y-2 text-[14px] text-[var(--color-ink-2)]">
            {useCase.requirements.map(req => (
              <li class="pl-3 border-l rule">{req}</li>
            ))}
          </ul>
        </section>

        <section>
          <p class="text-[12px] uppercase tracking-wider text-[var(--color-ink-3)] font-medium mb-3">
            Tips prácticos
          </p>
          <ol class="space-y-3 text-[13px] text-[var(--color-ink-2)] tnum">
            {useCase.tips.map((tip, i) => (
              <li class="flex gap-3">
                <span class="text-[var(--color-ink-4)]">{i + 1}.</span>
                <span class="text-pretty">{tip}</span>
              </li>
            ))}
          </ol>
        </section>
      </aside>
    </div>

    <section class="pt-10 border-t rule">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-6">
        Otros casos
      </p>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-rule)]">
        {USE_CASES.filter(u => u.slug !== useCase.slug).slice(0, 4).map(u => (
          <li class="bg-[var(--color-paper)]">
            <a href={`/use-cases/${u.slug}`} class="block p-4 hover:bg-[var(--color-paper-2)] transition-colors focus-ring min-w-0">
              <h3 class="font-medium text-[var(--color-ink)] truncate mb-1">{u.title}</h3>
              <p class="text-[12px] text-[var(--color-ink-3)] line-clamp-2 text-pretty">{u.tagline}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-12 text-[12px] text-[var(--color-ink-3)]">
      {numberFmt.format(matched.length)} modelos disponibles en el catálogo que coinciden con este caso de uso.
      <a href="/catalog" class="text-[var(--color-ink-2)] underline underline-offset-4 hover:text-[var(--color-ink)] focus-ring ml-1">Ver todos</a>
    </p>
  </article>
</Layout>

<script>
  let compareIds: string[] = JSON.parse(localStorage.getItem('compareIds') || '[]');
  const MAX_COMPARE = 4;

  function showToast(message: string, kind: string = 'info') {
    const fn = (window as any).showToast;
    if (typeof fn === 'function') fn(message, kind);
  }

  document.querySelectorAll('.compare-btn').forEach(btn => {
    const id = (btn as HTMLButtonElement).dataset.modelId;
    if (compareIds.includes(id || '')) {
      btn.textContent = 'Añadido';
      btn.setAttribute('disabled', 'true');
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.compare-btn') as HTMLButtonElement | null;
    if (!btn) return;

    const modelId = btn.dataset.modelId;
    if (!modelId || compareIds.includes(modelId)) return;

    if (compareIds.length >= MAX_COMPARE) {
      showToast(`Máximo ${MAX_COMPARE} modelos para comparar`, 'warning');
      return;
    }

    compareIds.push(modelId);
    localStorage.setItem('compareIds', JSON.stringify(compareIds));
    btn.textContent = 'Añadido';
    btn.setAttribute('disabled', 'true');
    showToast('Modelo añadido a comparación', 'success');
  });
</script>
