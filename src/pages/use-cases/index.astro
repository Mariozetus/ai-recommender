---
import Layout from '../layouts/Layout.astro';
import { USE_CASES } from '../data/content';

const icons: Record<string, string> = {
  'code-review': '⌘',
  'customer-support': '◐',
  'content-generation': '◇',
  'data-analysis': '◢',
  'translation': '◯',
  'image-generation': '◈',
  'vision-analysis': '◉',
  'embeddings': '⌖',
};
---

<Layout title="Casos de uso">
  <div class="border-b rule">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <p class="text-[13px] uppercase tracking-[0.12em] text-[var(--color-ink-3)] font-medium mb-3">
        Casos de uso
      </p>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-[-0.02em] text-[var(--color-ink)] mb-3 text-balance">
        Modelos curados por tarea
      </h1>
      <p class="text-[var(--color-ink-2)] max-w-2xl text-pretty">
        Cada tarea tiene requisitos únicos. Estas páginas comparan los mejores modelos según el contexto y ofrecen guía práctica.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-12">
    <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-rule)]">
      {USE_CASES.map(useCase => (
        <li class="bg-[var(--color-paper)]">
          <a
            href={`/use-cases/${useCase.slug}`}
            class="group block p-6 hover:bg-[var(--color-paper-2)] transition-colors focus-ring h-full"
          >
            <div class="flex items-center gap-3 mb-3">
              <span class="text-[var(--color-accent)] text-xl font-light">{icons[useCase.slug] || '·'}</span>
              <h2 class="font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">{useCase.title}</h2>
            </div>
            <p class="text-[13px] text-[var(--color-ink-2)] text-pretty leading-relaxed">{useCase.tagline}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
